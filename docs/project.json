{
  "name": "docs",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "./docs/src",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals",
      "{workspaceRoot}/e2e/src/files/dungeon-adventure/dice/**/*"
    ]
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "options": {
        "command": "astro build",
        "cwd": "docs"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "astro dev",
        "cwd": "docs"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "astro preview",
        "cwd": "docs"
      },
      "dependsOn": ["build"]
    }
  },
  "tags": []
}
