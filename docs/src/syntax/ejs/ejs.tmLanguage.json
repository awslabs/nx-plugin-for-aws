{
  "name": "EJS",
  "fileTypes": ["ejs", "template"],
  "scopeName": "text.ejs",
  "comment": "Highlights the template tags and the expressions inside them, leaving the literal output around them unstyled — in a generator template, what matters is telling the two apart. The tag bodies are matched with flat patterns rather than by embedding a full JavaScript grammar, which would open blocks a tag leaves unclosed and swallow the rest of the file.",
  "patterns": [
    { "include": "#literal-tag" },
    { "include": "#comment-tag" },
    { "include": "#output-tag" },
    { "include": "#scriptlet-tag" }
  ],
  "repository": {
    "literal-tag": {
      "comment": "`<%%` and `%%>` escape a tag delimiter into the output.",
      "match": "<%%|%%>",
      "name": "constant.character.escape.ejs"
    },
    "comment-tag": {
      "name": "comment.block.ejs",
      "begin": "<%#",
      "end": "[-_]?%>",
      "captures": { "0": { "name": "punctuation.definition.comment.ejs" } }
    },
    "output-tag": {
      "comment": "`<%=` escapes its value on the way out, `<%-` does not.",
      "name": "meta.embedded.expression.ejs",
      "begin": "<%[=-]",
      "end": "[-_]?%>",
      "beginCaptures": {
        "0": { "name": "punctuation.section.embedded.begin.ejs" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.embedded.end.ejs" }
      },
      "patterns": [{ "include": "#expression" }]
    },
    "scriptlet-tag": {
      "name": "meta.embedded.block.ejs",
      "begin": "<%_?",
      "end": "[-_]?%>",
      "beginCaptures": {
        "0": { "name": "punctuation.section.embedded.begin.ejs" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.embedded.end.ejs" }
      },
      "patterns": [{ "include": "#expression" }]
    },
    "expression": {
      "patterns": [
        { "include": "#string" },
        {
          "match": "\\b(if|else|for|of|in|while|do|return|switch|case|break|continue|typeof|new|await|async|delete|throw|try|catch|finally)\\b",
          "name": "keyword.control.ejs"
        },
        {
          "match": "\\b(const|let|var|function)\\b",
          "name": "storage.type.ejs"
        },
        {
          "match": "\\b(true|false|null|undefined)\\b",
          "name": "constant.language.ejs"
        },
        { "match": "\\b\\d+(?:\\.\\d+)?\\b", "name": "constant.numeric.ejs" },
        {
          "match": "(\\.)([A-Za-z_$][A-Za-z0-9_$]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.ejs" },
            "2": { "name": "entity.name.function.ejs" }
          }
        },
        {
          "match": "([A-Za-z_$][A-Za-z0-9_$]*)(?=\\s*\\()",
          "name": "entity.name.function.ejs"
        },
        {
          "match": "(\\.)([A-Za-z_$][A-Za-z0-9_$]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.ejs" },
            "2": { "name": "variable.other.property.ejs" }
          }
        },
        {
          "match": "\\b[A-Za-z_$][A-Za-z0-9_$]*\\b",
          "name": "variable.other.readwrite.ejs"
        },
        {
          "match": "(=>|===|!==|==|!=|<=|>=|&&|\\|\\||[+\\-*/%!<>=?:])",
          "name": "keyword.operator.ejs"
        },
        { "match": "[(){}\\[\\],;]", "name": "punctuation.separator.ejs" }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.single.ejs",
          "begin": "'",
          "end": "'|(?=[-_]?%>)",
          "patterns": [{ "include": "#escape" }]
        },
        {
          "name": "string.quoted.double.ejs",
          "begin": "\"",
          "end": "\"|(?=[-_]?%>)",
          "patterns": [{ "include": "#escape" }]
        },
        {
          "name": "string.template.ejs",
          "begin": "`",
          "end": "`|(?=[-_]?%>)",
          "patterns": [
            {
              "name": "meta.template.expression.ejs",
              "begin": "\\$\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.ejs"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.ejs"
                }
              },
              "patterns": [{ "include": "#expression" }]
            },
            { "include": "#escape" }
          ]
        }
      ]
    },
    "escape": {
      "match": "\\\\.",
      "name": "constant.character.escape.ejs"
    }
  }
}
