{
  "name": "Cedar",
  "fileTypes": ["cedar"],
  "scopeName": "source.cedar",
  "patterns": [
    { "include": "#comment" },
    { "include": "#ejs" },
    { "include": "#annotation" },
    { "include": "#effect" },
    { "include": "#condition" },
    { "include": "#scope-variable" },
    { "include": "#operator-word" },
    { "include": "#entity" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#constant" },
    { "include": "#operator" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.cedar",
      "begin": "//",
      "end": "$",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.comment.cedar" }
      }
    },
    "ejs": {
      "comment": "Policies are vended as templates, so the placeholders left for the generator are highlighted too.",
      "name": "meta.embedded.expression.ejs.cedar",
      "begin": "<%[-=_]?",
      "end": "[-_]?%>",
      "beginCaptures": {
        "0": { "name": "punctuation.section.embedded.begin.cedar" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.embedded.end.cedar" }
      },
      "patterns": [
        { "include": "#string" },
        {
          "match": "\\b[A-Za-z_$][A-Za-z0-9_$]*\\b",
          "name": "variable.other.readwrite.cedar"
        }
      ]
    },
    "annotation": {
      "match": "(@)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "punctuation.definition.annotation.cedar" },
        "2": { "name": "entity.name.function.decorator.cedar" }
      }
    },
    "effect": {
      "match": "\\b(permit|forbid)\\b",
      "name": "keyword.control.effect.cedar"
    },
    "condition": {
      "match": "\\b(when|unless|if|then|else)\\b",
      "name": "keyword.control.condition.cedar"
    },
    "scope-variable": {
      "comment": "The slots a policy is written against, held apart from the words that decide the outcome.",
      "match": "\\b(principal|action|resource|context)\\b",
      "name": "support.variable.scope.cedar"
    },
    "operator-word": {
      "match": "\\b(in|is|has|like)\\b",
      "name": "keyword.operator.word.cedar"
    },
    "entity": {
      "comment": "A namespaced type path, optionally followed by the entity's id.",
      "match": "\\b([A-Z][A-Za-z0-9_]*)((?:\\s*::\\s*[A-Za-z_][A-Za-z0-9_]*)*)",
      "captures": {
        "1": { "name": "entity.name.type.cedar" },
        "2": { "name": "entity.name.type.cedar" }
      }
    },
    "string": {
      "name": "string.quoted.double.cedar",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.cedar" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.cedar" }
      },
      "patterns": [
        { "include": "#ejs" },
        {
          "match": "\\\\(?:[nrt\"'\\\\0]|u\\{[0-9A-Fa-f]{1,6}\\})",
          "name": "constant.character.escape.cedar"
        }
      ]
    },
    "number": {
      "match": "\\b-?[0-9]+\\b",
      "name": "constant.numeric.cedar"
    },
    "constant": {
      "match": "\\b(true|false)\\b",
      "name": "constant.language.cedar"
    },
    "operator": {
      "match": "(&&|\\|\\||==|!=|<=|>=|[<>!+\\-*]|\\?)",
      "name": "keyword.operator.cedar"
    },
    "punctuation": {
      "patterns": [
        { "match": "::", "name": "punctuation.accessor.cedar" },
        { "match": "\\.", "name": "punctuation.accessor.cedar" },
        { "match": ",", "name": "punctuation.separator.cedar" },
        { "match": ";", "name": "punctuation.terminator.cedar" },
        { "match": "[{}]", "name": "punctuation.section.block.cedar" },
        { "match": "[()]", "name": "punctuation.section.parens.cedar" },
        { "match": "[\\[\\]]", "name": "punctuation.section.brackets.cedar" }
      ]
    }
  }
}
