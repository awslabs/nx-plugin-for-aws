/**
 * A reason to use the plugin, for the landing page's band of them.
 *
 * The icons are drawn here rather than taken from Starlight's set, so each one
 * pictures what its card says.
 */
interface Props {
  title: string;
  icon: 'layers' | 'sparkle' | 'shield' | 'terminal' | 'pencil';
}

const { title, icon } = Astro.props as Props;

const ICONS: Record<Props['icon'], string[]> = {
  // Stacked layers: a full stack, scaffolded together.
  layers: [
    'M12 3.5 20.5 8 12 12.5 3.5 8 12 3.5Z',
    'M3.5 12.5 12 17l8.5-4.5',
    'M3.5 16.5 12 21l8.5-4.5',
  ],
  // A spark, for what an assistant adds.
  sparkle: [
    'M11 3.5 12.8 8.7 18 10.5l-5.2 1.8L11 17.5l-1.8-5.2L4 10.5l5.2-1.8L11 3.5Z',
    'M18 15.5l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8.8-2Z',
  ],
  // A shield with a check: guarantees that hold across the stack.
  shield: [
    'M12 3.5 19 6v5.5c0 4.4-2.8 7.8-7 9.5-4.2-1.7-7-5.1-7-9.5V6l7-2.5Z',
    'M8.8 11.9 11.2 14.3 15.4 10',
  ],
  // A prompt in a window: it runs on your machine.
  terminal: [
    'M3.5 5.5h17a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1h-17a1 1 0 0 1-1-1v-11a1 1 0 0 1 1-1Z',
    'M7 10.5 9.3 12.8 7 15',
    'M12 15h5',
  ],
  // A pencil: the code is yours to change.
  pencil: [
    'M4 20.5l1.2-4.2L15 6.6a2.1 2.1 0 0 1 3 3L8.2 19.3 4 20.5Z',
    'M13.4 8.2l2.9 2.9',
  ],
};
---

<article class="why-card">
  <p class="why-card-title">
    <span class="why-card-icon" aria-hidden="true">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        {ICONS[icon].map((d) => <path d={d} />)}
      </svg>
    </span>
    {title}
  </p>
  <div class="why-card-body"><slot /></div>
</article>
