import { findGeneratorsJsonEntry } from '../../../packages/nx-plugin/src/utils/generators';
import Snippet from './snippet.astro';

/**
 * Renders a banner at the top of a generator guide when the generator is
 * marked `experimental` in `generators.json`.
 *
 * Driven by the page's `generator:` frontmatter, so marking a generator
 * experimental is enough to surface it here — no change to the guide itself.
 * The wording lives in the `experimental-generator` snippet, so it is
 * translated by the usual docs translation workflow.
 */
interface Props {
  generatorId: string;
}

const { generatorId } = Astro.props;

const experimental = findGeneratorsJsonEntry(generatorId)?.experimental === true;
---

{experimental && <Snippet name="experimental-generator" />}
