import { Aside } from '@astrojs/starlight/components';
import GeneratorsJson from '../../../packages/nx-plugin/generators.json';

/**
 * Renders a banner at the top of a generator guide when the generator is
 * marked `experimental` in `generators.json`.
 *
 * Driven by the page's `generator:` frontmatter, so marking a generator
 * experimental is enough to surface it here — no change to the guide itself.
 */
interface Props {
  generatorId: string;
}

const { generatorId } = Astro.props;

const experimental =
  GeneratorsJson.generators[generatorId]?.experimental === true;

const locale = Astro.currentLocale || 'en';

const titles = {
  en: 'Experimental',
  jp: '実験的機能',
  ko: '실험적 기능',
  fr: 'Expérimental',
  it: 'Sperimentale',
  es: 'Experimental',
  pt: 'Experimental',
  zh: '实验性功能',
  vi: 'Thử nghiệm',
};

const bodies = {
  en: `The \`${generatorId}\` generator is experimental. Its behaviour and generated output may change in a future release without a migration being published to apply the change to an existing workspace, so you may need to reconcile those changes yourself when you upgrade.`,
  jp: `\`${generatorId}\` ジェネレーターは実験的機能です。動作と生成される出力は、既存のワークスペースに変更を適用するマイグレーションが公開されることなく、将来のリリースで変更される可能性があります。そのため、アップグレード時に自分で変更を反映させる必要がある場合があります。`,
  ko: `\`${generatorId}\` 제너레이터는 실험적 기능입니다. 동작과 생성되는 출력은 기존 워크스페이스에 변경 사항을 적용하는 마이그레이션 없이 향후 릴리스에서 변경될 수 있으므로, 업그레이드 시 직접 변경 사항을 조정해야 할 수 있습니다.`,
  fr: `Le générateur \`${generatorId}\` est expérimental. Son comportement et sa sortie générée peuvent changer dans une version future sans qu'une migration soit publiée pour appliquer le changement à un espace de travail existant ; vous devrez donc peut-être répercuter ces changements vous-même lors de la mise à niveau.`,
  it: `Il generatore \`${generatorId}\` è sperimentale. Il suo comportamento e l'output generato potrebbero cambiare in una release futura senza che venga pubblicata una migrazione per applicare la modifica a un workspace esistente, quindi potresti dover riconciliare tali modifiche manualmente durante l'aggiornamento.`,
  es: `El generador \`${generatorId}\` es experimental. Su comportamiento y la salida generada pueden cambiar en una versión futura sin que se publique una migración para aplicar el cambio a un espacio de trabajo existente, por lo que puede que tengas que aplicar esos cambios tú mismo al actualizar.`,
  pt: `O gerador \`${generatorId}\` é experimental. Seu comportamento e a saída gerada podem mudar em uma versão futura sem que uma migração seja publicada para aplicar a mudança a um espaço de trabalho existente, portanto você pode precisar reconciliar essas mudanças manualmente ao atualizar.`,
  zh: `\`${generatorId}\` 生成器为实验性功能。其行为和生成的输出可能在未来版本中发生变化，且不会发布迁移来将变更应用到现有工作区，因此升级时您可能需要自行处理这些变更。`,
  vi: `Trình tạo \`${generatorId}\` đang ở giai đoạn thử nghiệm. Hành vi và đầu ra được tạo có thể thay đổi trong một bản phát hành tương lai mà không có migration nào được công bố để áp dụng thay đổi vào không gian làm việc hiện có, vì vậy bạn có thể cần tự điều chỉnh những thay đổi đó khi nâng cấp.`,
};

const localeString = (strings) => strings[locale] || strings['en'];
---

{
  experimental && (
    <Aside type="caution" title={localeString(titles)}>
      <p set:html={localeString(bodies).replace(/`([^`]+)`/g, '<code>$1</code>')} />
    </Aside>
  )
}
