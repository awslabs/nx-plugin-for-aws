/**
 * A prompt to paste into an AI assistant, framed like the code blocks around it
 * so it reads as something to copy rather than prose.
 */
interface Props {
  title?: string;
}

const { title = 'Prompt' } = Astro.props as Props;
---

<figure class="prompt not-content">
  <figcaption class="prompt-header">
    <span class="prompt-mark" aria-hidden="true"></span>
    <span class="prompt-title">{title}</span>
    <button
      type="button"
      class="prompt-copy"
      data-prompt-copy
      aria-label={`Copy the ${title.toLowerCase()}`}
    >
      <svg
        class="prompt-copy-icon prompt-copy-icon--copy"
        viewBox="0 0 24 24"
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
      <svg
        class="prompt-copy-icon prompt-copy-icon--check"
        viewBox="0 0 24 24"
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
    </button>
  </figcaption>
  <div class="prompt-body"><slot /></div>
</figure>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>(
    '[data-prompt-copy]',
  )) {
    button.addEventListener('click', async () => {
      const text = button
        .closest('.prompt')
        ?.querySelector('.prompt-body')?.textContent;
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text.trim());
        button.classList.add('is-copied');
        setTimeout(() => button.classList.remove('is-copied'), 1600);
      } catch {
        // Clipboard access can be denied; the prompt stays selectable.
      }
    });
  }
</script>
