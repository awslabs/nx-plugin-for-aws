import { getRelativeLocaleUrl } from 'astro:i18n';
import { PresetShowcase } from './graph-builder/preset-showcase';
import '../styles/graph-builder.css';

const builderHref = getRelativeLocaleUrl(
  Astro.currentLocale || 'en',
  'get_started/graph-builder',
).replace(/\/$/, '');
---

<div class="ps-shell not-content">
  <PresetShowcase client:only="react" builderHref={builderHref}>
    <div class="gb-loading gb-loading--showcase" slot="fallback">
      <span class="gb-spinner" aria-hidden="true"></span>
      <p>Loading the examples…</p>
    </div>
  </PresetShowcase>
</div>
