import { GraphBuilder } from './graph-builder/graph-builder';
import '../styles/graph-builder.css';
---

<!-- `not-content` opts out of Starlight's prose styles, whose adjacent-sibling
     margin rule would otherwise offset absolutely-positioned nodes from the
     coordinates the SVG edge layer computes. -->
<div class="gb-full-bleed not-content">
  <!-- The builder is a client-only island, so this fallback stands in until it
       hydrates rather than leaving an empty gap on the page. -->
  <GraphBuilder client:only="react">
    <div class="gb-loading" slot="fallback">
      <span class="gb-spinner" aria-hidden="true"></span>
      <p>Loading the graph builder…</p>
    </div>
  </GraphBuilder>
</div>
