/**
 * Lists every migration the plugin ships, grouped by release and in the order
 * `nx migrate` runs them. Derived from the migration folders at build time, so a
 * new migration appears here without anyone editing this page.
 */
import { readMigrationReleases } from '../lib/migrations';
import MigrationNotes from './migration-notes.astro';

const releases = readMigrationReleases();

const KIND_LABELS: Record<string, string> = {
  deterministic: 'Codemod',
  agentic: 'AI prompt',
  hybrid: 'Codemod + AI prompt',
};
---

{
  releases.map((release) => (
    <section class="migration-release">
      <h3 id={release.version ? `v${release.version}` : 'unreleased'}>
        {release.version ? release.version : 'Unreleased'}
      </h3>
      <ol class="migration-list">
        {release.migrations.map((migration) => (
          <li>
            <p>
              <code>{migration.name}</code>
              <span class="migration-kind">{KIND_LABELS[migration.kind]}</span>
            </p>
            <p>{migration.description}</p>
            <MigrationNotes name={migration.name} />
          </li>
        ))}
      </ol>
    </section>
  ))
}

<style>
  .migration-release h3 {
    margin-top: 2rem;
  }
  .migration-list {
    margin-top: 0.5rem;
  }
  .migration-list li + li {
    margin-top: 1rem;
  }
  .migration-list p {
    margin: 0.25rem 0;
  }
  .migration-kind {
    margin-left: 0.5rem;
    padding: 0.1rem 0.4rem;
    border-radius: 0.25rem;
    font-size: var(--sl-text-xs);
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
    white-space: nowrap;
  }
</style>
