import type { NodeOverride } from '../lib/graph-builder/commands';
import { EmbeddedGraph } from './graph-builder/embedded-graph';
import '../styles/graph-builder.css';

interface Props {
  preset?: string;
  /** A single node type, for a guide covering one generator. */
  type?: string;
  name?: string;
  /** A diagram declared outright, by name, for a page describing a mechanism. */
  diagram?: string;
  /** Option values in effect, deciding what the infrastructure view shows. */
  options?: Readonly<Record<string, string | boolean>>;
  /** Follow the option values the page's filter bar has selected. */
  followPageOptions?: boolean;
  /** Which diagram to open on. Defaults to the projects view. */
  view?: 'projects' | 'infrastructure';
  /** Whether to offer the commands that scaffold the graph. Defaults to true. */
  copyable?: boolean;
  workspace?: string;
  packageManager?: string;
  iac?: 'cdk' | 'terraform';
  orientation?: 'horizontal' | 'vertical';
  skipWorkspace?: boolean;
  overrides?: Readonly<Record<string, NodeOverride>>;
}

const {
  preset,
  type,
  name,
  diagram,
  options,
  followPageOptions,
  view,
  copyable,
  workspace,
  packageManager,
  iac,
  orientation,
  skipWorkspace,
  overrides,
} = Astro.props;
---

<div class="gb-embed-shell not-content">
  <EmbeddedGraph
    client:only="react"
    preset={preset}
    type={type}
    name={name}
    diagram={diagram}
    options={options}
    followPageOptions={followPageOptions}
    view={view}
    copyable={copyable}
    workspace={workspace}
    packageManager={packageManager}
    iac={iac}
    orientation={orientation}
    skipWorkspace={skipWorkspace}
    overrides={overrides}
  >
    <div class="gb-loading gb-loading--embed" slot="fallback">
      <span class="gb-spinner" aria-hidden="true"></span>
      <p>Loading the diagram…</p>
    </div>
  </EmbeddedGraph>
</div>
