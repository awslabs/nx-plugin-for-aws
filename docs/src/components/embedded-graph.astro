import { EmbeddedGraph } from './graph-builder/embedded-graph';
import '../styles/graph-builder.css';

interface Props {
  preset: string;
  workspace?: string;
  packageManager?: string;
  iac?: 'cdk' | 'terraform';
  orientation?: 'horizontal' | 'vertical';
  skipWorkspace?: boolean;
}

const { preset, workspace, packageManager, iac, orientation, skipWorkspace } =
  Astro.props;
---

<div class="gb-embed-shell not-content">
  <EmbeddedGraph
    client:only="react"
    preset={preset}
    workspace={workspace}
    packageManager={packageManager}
    iac={iac}
    orientation={orientation}
    skipWorkspace={skipWorkspace}
  >
    <div class="gb-loading gb-loading--embed" slot="fallback">
      <span class="gb-spinner" aria-hidden="true"></span>
      <p>Loading the diagram…</p>
    </div>
  </EmbeddedGraph>
</div>
