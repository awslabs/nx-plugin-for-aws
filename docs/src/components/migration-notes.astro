/**
 * Renders a migration's maintainer notes, if it has any. Notes live as snippets
 * under `snippets/migrations/<name>.mdx` so they are translated alongside the
 * rest of the docs, and most migrations have none — a migration without a notes
 * snippet renders nothing rather than a missing-snippet warning.
 */
const locale = Astro.currentLocale || 'en';
const notes = Object.values(
  import.meta.glob('../content/docs/*/snippets/migrations/**/*.mdx', {
    eager: true,
  }),
);
const { name } = Astro.props;
const note = notes.find((n) =>
  n.file.endsWith(`content/docs/${locale}/snippets/migrations/${name}.mdx`),
);
---

{note && <note.Content />}
