import {
  GreengrassArtifactBucket,
  GreengrassDeployment,
  Pulse,
} from '@greengrass-tutorial/common-constructs';
import { CfnParameter, Stack, type StackProps } from 'aws-cdk-lib';
import { Role } from 'aws-cdk-lib/aws-iam';
import type { Construct } from 'constructs';

export class ApplicationStack extends Stack {
  constructor(scope: Construct, id: string, props?: StackProps) {
    super(scope, id, props);

    // Both values are written to .greengrass-tutorial.env by the setup script
    // and passed with --parameters on every deploy.
    const tokenExchangeRoleArn = new CfnParameter(
      this,
      'TokenExchangeRoleArn',
      {
        type: 'String',
        description: 'ARN of the core device token exchange role',
      },
    );
    const thingGroupArn = new CfnParameter(this, 'ThingGroupArn', {
      type: 'String',
      description: 'ARN of the thing group that holds the core device',
    });

    // The retained artifact repository, and the read grant the core device
    // needs to fetch this component's artifacts from it.
    const artifacts = new GreengrassArtifactBucket(this, 'Artifacts');
    const tokenExchangeRole = Role.fromRoleArn(
      this,
      'TokenExchangeRole',
      tokenExchangeRoleArn.valueAsString,
    );
    artifacts.grantReadTo(tokenExchangeRole, 'com.example.Pulse/*');

    // The published version stays managed. This deployment revision lists no
    // components, so the core device uninstalls com.example.Pulse.
    new Pulse(this, 'Pulse', { bucket: artifacts });
    new GreengrassDeployment(this, 'Fleet', {
      targetArn: thingGroupArn.valueAsString,
    });
  }
}
