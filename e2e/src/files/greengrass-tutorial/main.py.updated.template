import json
import logging
import time

from awsiot.greengrasscoreipc.clientv2 import GreengrassCoreIPCClientV2

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger("com.example.Pulse")

TOPIC = "tutorial/greengrass/heartbeat"
PUBLISH_INTERVAL_SECONDS = 30
GREETING = "hello from the updated pulse"


def publish_heartbeat(client: GreengrassCoreIPCClientV2, sequence: int) -> None:
    payload = json.dumps({"sequence": sequence, "greeting": GREETING}).encode("utf-8")
    client.publish_to_iot_core(topic_name=TOPIC, qos="1", payload=payload)
    logger.info("Published heartbeat %s to %s", sequence, TOPIC)


def main() -> None:
    client = GreengrassCoreIPCClientV2()
    sequence = 0
    while True:
        publish_heartbeat(client, sequence)
        sequence += 1
        time.sleep(PUBLISH_INTERVAL_SECONDS)


if __name__ == "__main__":
    main()
