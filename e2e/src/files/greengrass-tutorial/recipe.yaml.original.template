RecipeFormatVersion: '2020-01-25'
ComponentName: com.example.Pulse
ComponentVersion: NEXT_PATCH
ComponentDescription: com.example.Pulse Greengrass component using Python 3.14, generated by greengrass#component.
ComponentPublisher: greengrass-tutorial
ComponentConfiguration:
  DefaultConfiguration:
    accessControl:
      aws.greengrass.ipc.pubsub:
        com.example.Pulse:pubsub:1:
          policyDescription: Allow publishing heartbeat messages to this component's own topic.
          operations:
            - aws.greengrass#PublishToTopic
          resources:
            - com.example.Pulse/heartbeat
Manifests:
  - Platform:
      os: linux
      architecture: amd64
    Artifacts:
      # Placeholders are substituted at publish time. The basename must stay
      # pulse.zip, which is what the Run script below unarchives to.
      - Uri: s3://BUCKET_NAME/COMPONENT_NAME/COMPONENT_VERSION/pulse.zip
        Unarchive: ZIP
    Lifecycle:
      Run: python3.14 {artifacts:decompressedPath}/pulse/main.py
