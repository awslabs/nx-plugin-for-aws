# Exercises the vended core/greengrass modules directly (via `module {
# source = ... }` in each run block), with every provider mocked - so no AWS
# credentials, and not one AWS API call. The preceding `terraform init` still
# fetches the aws, awscc and random providers, from the shared plugin cache
# when it already holds them and from the registry otherwise. Run with
# `terraform test` from `packages/common/terraform/src` (the `test` target
# does this). These fixtures are copied only by the e2e plan test.
#
# `command = plan` wherever the asserted attribute is computed from local
# variables and file reads, so it is already fully known at plan time. The
# created bucket's own name is the exception: it carries `random_string`'s
# result, which no plan knows, so those runs use `command = apply` against the
# mocks - still not one AWS call.
mock_provider "aws" {}
mock_provider "awscc" {}
mock_provider "random" {}

# --- core/greengrass/component-version ------------------------------------
# Fixture recipe/artifact under tests/fixtures/component-version/ - a real
# component's recipe.yaml and built artifact are not available here, so this
# is the smallest pair that exercises the same substitution and hashing code.

run "component_version_publishes_json_recipe" {
  command = plan

  module {
    source = "./core/greengrass/component-version"
  }

  variables {
    recipes_dir   = "tests/fixtures/component-version/recipes"
    artifacts_dir = "tests/fixtures/component-version/artifacts"
    bucket_name   = "test-bucket"
  }

  assert {
    condition     = substr(awscc_greengrassv2_component_version.this.inline_recipe, 0, 1) == "{"
    error_message = "inline_recipe must be JSON (start with '{') - yamlencode's leading quote fails CreateComponentVersion"
  }
}

run "artifact_key_carries_sha256" {
  command = plan

  module {
    source = "./core/greengrass/component-version"
  }

  variables {
    recipes_dir   = "tests/fixtures/component-version/recipes"
    artifacts_dir = "tests/fixtures/component-version/artifacts"
    bucket_name   = "test-bucket"
  }

  assert {
    condition     = aws_s3_object.artifact["fixture-artifact.txt"].key == "com.test.FixtureComponent/${substr(sha256("fixture-artifact.txt:${filesha256("tests/fixtures/component-version/artifacts/com.test.FixtureComponent/1.0.0/fixture-artifact.txt")}"), 0, 32)}/fixture-artifact.txt"
    error_message = "the artifact's S3 key must carry the first 32 hex characters of the artifact-set digest"
  }

  assert {
    condition     = aws_s3_object.artifact["fixture-artifact.txt"].key == trimspace(file("tests/fixtures/component-version/expected-key.txt"))
    error_message = "CDK and Terraform must publish the fixture at the same S3 key"
  }

  assert {
    condition     = jsondecode(awscc_greengrassv2_component_version.this.inline_recipe).Manifests[0].Artifacts[0].Uri == "s3://test-bucket/${aws_s3_object.artifact["fixture-artifact.txt"].key}"
    error_message = "the recipe must reference the uploaded artifact key"
  }

  assert {
    condition     = jsondecode(awscc_greengrassv2_component_version.this.inline_recipe).Manifests[0].Artifacts[0].Digest == filebase64sha256("tests/fixtures/component-version/artifacts/com.test.FixtureComponent/1.0.0/fixture-artifact.txt")
    error_message = "the recipe must retain the full artifact digest"
  }
}

run "component_version_rejects_next_version" {
  command = plan

