# --- core/greengrass/artifact-bucket ---------------------------------------
# existing_bucket_name (a data source), not bucket_name (a created resource):
# a data source's attributes are fully known at plan time even when mocked,
# where a newly created resource's computed attributes (e.g. an S3 bucket's
# own arn) are not known until apply.

run "grant_defaults_to_workspace_namespace" {
  command = plan

  module {
    source = "./core/greengrass/artifact-bucket"
  }

  variables {
    existing_bucket_name = "test-bucket"
    # checkov flags any assignment whose name contains "token" as a possible
    # secret - this is a fixture ARN, not a credential.
    #checkov:skip=CKV_SECRET_6:An IAM role ARN is not a secret
    token_exchange_role_arn = "arn:aws:iam::123456789012:role/TestRole"
  }

  override_data {
    target = data.aws_s3_bucket.existing[0]
    values = {
      arn = "arn:aws:s3:::test-bucket"
    }
  }

  assert {
    condition     = jsondecode(aws_iam_role_policy.token_exchange_read[0].policy).Statement[0].Resource == "arn:aws:s3:::test-bucket/<%- componentKeyPrefix %>"
    error_message = "the default grant must be scoped to the workspace component namespace"
  }
}

run "grant_narrows_to_key_prefix" {
  command = plan

  module {
    source = "./core/greengrass/artifact-bucket"
  }

  variables {
    existing_bucket_name = "test-bucket"
    #checkov:skip=CKV_SECRET_6:An IAM role ARN is not a secret
    token_exchange_role_arn   = "arn:aws:iam::123456789012:role/TestRole"
    token_exchange_key_prefix = "com.example.MyComponent/*"
  }

  override_data {
    target = data.aws_s3_bucket.existing[0]
    values = {
      arn = "arn:aws:s3:::test-bucket"
    }
  }

  assert {
    condition     = jsondecode(aws_iam_role_policy.token_exchange_read[0].policy).Statement[0].Resource == "arn:aws:s3:::test-bucket/com.example.MyComponent/*"
    error_message = "token_exchange_key_prefix must narrow the grant's resource scope"
  }
}

# The created-bucket arm. A bucket's name cannot change in place, and
# `prevent_destroy` refuses the replacement a changed name plans - so the name
# this module derives has to be right the first time, and stable afterwards.
# The prefix here is longer than the 20 characters the name keeps, so the same
# run covers the truncation.
run "created_bucket_name_carries_prefix_account_and_region" {
  command = apply

  module {
    source = "./core/greengrass/artifact-bucket"
  }

  variables {
    bucket_name_prefix = "abcdefghij-klmnopqr-artifacts"
  }

  override_data {
    target = data.aws_caller_identity.current[0]
    values = {
      account_id = "123456789012"
    }
  }

  override_data {
    target = data.aws_region.current[0]
    values = {
      region = "us-east-1"
    }
  }

  # Truncated to 20 characters, with the hyphen that truncation landed on
  # trimmed rather than doubling the separator.
  assert {
    condition     = startswith(aws_s3_bucket.bucket[0].bucket, "abcdefghij-klmnopqr-123456789012-us-east-1-")
    error_message = "the created bucket's name must carry its prefix, account and region: got ${aws_s3_bucket.bucket[0].bucket}"
  }

  assert {
    condition     = length(aws_s3_bucket.bucket[0].bucket) <= 63
    error_message = "an S3 bucket name is capped at 63 characters: got ${aws_s3_bucket.bucket[0].bucket}"
  }
}

run "explicit_bucket_name_wins_over_the_derived_one" {
  command = apply

  module {
    source = "./core/greengrass/artifact-bucket"
  }

  variables {
    bucket_name        = "my-fixed-bucket"
    bucket_name_prefix = "ignored"
  }

  # Naming the existing bucket explicitly is the documented way out of the
  # replacement a changed derived name would plan, so it must take precedence.
  assert {
    condition     = aws_s3_bucket.bucket[0].bucket == "my-fixed-bucket"
    error_message = "an explicit bucket_name must win over bucket_name_prefix"
  }
}

# `plan`, not `apply`: a variable validation fails during planning, which a
# failed `apply` run reports as a test failure even when expected.
run "rejects_a_bucket_name_prefix_no_bucket_could_carry" {
  command = plan

  module {
    source = "./core/greengrass/artifact-bucket"
  }

  variables {
    bucket_name_prefix = "Bad_Prefix"
  }

  expect_failures = [var.bucket_name_prefix]
}
