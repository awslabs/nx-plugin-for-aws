import { McpServer } from '@modelcontextprotocol/sdk/server/mcp.js';
import { registerDivideTool } from './tools/divide.js';
import { registerSampleGuidanceResource } from './resources/sample-guidance.js';
import type { McpRequestContext } from './request-context.js';

/**
 * Create the MCP Server.
 *
 * The context carries per-request details for tools that scope data per caller.
 * Rename it to `context` and pass it to a registration when needed; it is
 * absent over STDIO.
 */
export const createServer = async (_context: McpRequestContext = {}) => {
  const server = new McpServer({
    name: 'inventory-mcp-server',
    version: '1.0.0',
  });

  registerDivideTool(server);
  registerSampleGuidanceResource(server);

  return server;
};
