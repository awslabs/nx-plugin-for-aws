from contextlib import contextmanager
from datetime import UTC, datetime

from dungeon_adventure_agent_connection import InventoryMcpServerClientStrands, log_model_errors, log_tool_errors
from strands import Agent, tool
from strands.hooks import HookCallback, HookProvider
from strands.plugins import Plugin
from strands.vended_plugins.context_injector import ContextInjector


@tool
def subtract(a: int, b: int) -> int:
    return a - b


AGENT_HOOKS: list[HookProvider | HookCallback] = [log_model_errors, log_tool_errors]

# Gives the model the current time with each user message
AGENT_PLUGINS: list[Plugin] = [
    ContextInjector(lambda _: f"<current_time>{datetime.now(UTC).isoformat()}</current_time>"),
]


@contextmanager
def get_agent():
    inventory_mcp_server = InventoryMcpServerClientStrands.create()
    with (
        inventory_mcp_server,
    ):
        yield Agent(
            name="StoryAgent",
            description="StoryAgent Strands Agent",
            system_prompt="""
You are a mathematical wizard.
Use your tools for mathematical tasks.
Refer to tools as your 'spellbook'.
""",
            tools=[subtract, *inventory_mcp_server.list_tools_sync()],
            hooks=AGENT_HOOKS,
            plugins=AGENT_PLUGINS,
        )
