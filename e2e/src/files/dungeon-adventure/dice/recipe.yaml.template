RecipeFormatVersion: '2020-01-25'
ComponentName: com.example.DungeonDice
ComponentVersion: NEXT_PATCH
ComponentDescription: Dice rolls requested by the Dungeon Adventure Story Agent.
ComponentPublisher: dungeon-adventure
ComponentConfiguration:
  DefaultConfiguration:
    thingName: REPLACE_WITH_CORE_THING_NAME
    accessControl:
      aws.greengrass.ipc.mqttproxy:
        com.example.DungeonDice:mqttproxy:1:
          policyDescription: Exchange dice requests and results through the named cloud shadow.
          operations:
            - aws.greengrass#PublishToIoTCore
            - aws.greengrass#SubscribeToIoTCore
          resources:
            - $aws/things/REPLACE_WITH_CORE_THING_NAME/shadow/name/dungeon-dice/get
            - $aws/things/REPLACE_WITH_CORE_THING_NAME/shadow/name/dungeon-dice/get/accepted
            - $aws/things/REPLACE_WITH_CORE_THING_NAME/shadow/name/dungeon-dice/update
            - $aws/things/REPLACE_WITH_CORE_THING_NAME/shadow/name/dungeon-dice/update/delta
            - $aws/things/REPLACE_WITH_CORE_THING_NAME/shadow/name/dungeon-dice/update/rejected
Manifests:
  - Platform:
      os: linux
      architecture: amd64
    Artifacts:
      - Uri: s3://BUCKET_NAME/COMPONENT_NAME/COMPONENT_VERSION/dice.zip
        Unarchive: ZIP
    Lifecycle:
      Run: python3.14 {artifacts:decompressedPath}/dice/main.py --thing-name "{configuration:/thingName}"
