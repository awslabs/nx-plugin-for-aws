import * as cdk from 'aws-cdk-lib';
import { Vpc } from 'aws-cdk-lib/aws-ec2';
import { Construct } from 'constructs';
import {
  MyPyTable,
  MyTable,
  PostgresDb,
  PyAgent,
  PyService,
  RuntimeConfig,
  TsProjectAgent,
  TsService,
  UserIdentity,
} from '@e2e-test/common-constructs';

export class ApplicationStack extends cdk.Stack {
  constructor(scope: Construct, id: string, props?: cdk.StackProps) {
    super(scope, id, props);

    // One NAT gateway keeps the run under the default per-region EIP quota
    // while the rdb deploy jobs run in parallel.
    const vpc = new Vpc(this, 'Vpc', { natGateways: 1 });

    // Per-service constructs vended by ts#container and py#container; props
    // other than vpc keep their defaults (http-api ingress, iam auth). Each
    // service is the target of the website and agent connections and the
    // source of its language's data connections.
    const tsService = new TsService(this, 'TsService', { vpc });
    const pyService = new PyService(this, 'PyService', { vpc });

    // The grants the connection generators print, for all ten connections.
    // The website itself is not deployed; the test signs in as a website
    // user from Node.
    const identity = new UserIdentity(this, 'UserIdentity');
    tsService.grantInvoke(identity.identityPool.authenticatedRole);
    pyService.grantInvoke(identity.identityPool.authenticatedRole);

    const tsProjectAgent = new TsProjectAgent(this, 'TsProjectAgent');
    const pyAgent = new PyAgent(this, 'PyAgent');
    for (const agent of [tsProjectAgent, pyAgent]) {
      tsService.grantInvoke(agent);
      pyService.grantInvoke(agent);
    }

    const myTable = new MyTable(this, 'MyTable');
    myTable.grantReadWriteData(tsService.taskRole);
    const myPyTable = new MyPyTable(this, 'MyPyTable');
    myPyTable.grantReadWriteData(pyService.taskRole);

    // One Aurora cluster serves both rdb connections, to keep the run's
    // create and delete time to one cluster. The ts#rdb construct deploys it
    // (its migration creates the tables both services use); the py#rdb
    // construct is not deployed here, and the Python client reads the same
    // cluster's settings under its own runtime-config key. The rdb deploy
    // tests deploy both constructs. No RDS Proxy, as in terraform-deploy-rdb,
    // to save its cost and create time.
    const postgresDb = new PostgresDb(this, 'PostgresDb', {
      vpc,
      enableRdsProxy: false,
    });
    for (const service of [tsService, pyService]) {
      postgresDb.allowDefaultPortFrom(service);
      postgresDb.grantConnect(service.taskRole);
    }
    const rc = RuntimeConfig.ensure(this);
    rc.set('database', 'PyPostgresDb', rc.get('database').PostgresDb);

    new cdk.CfnOutput(this, 'TsServiceUrl', { value: tsService.url ?? '' });
    new cdk.CfnOutput(this, 'PyServiceUrl', { value: pyService.url ?? '' });
    new cdk.CfnOutput(this, 'TsAgentArn', {
      value: tsProjectAgent.agentCoreRuntime.agentRuntimeArn,
    });
    new cdk.CfnOutput(this, 'PyAgentArn', {
      value: pyAgent.agentCoreRuntime.agentRuntimeArn,
    });
  }
}
