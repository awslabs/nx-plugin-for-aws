import { getAppConfig } from '@aws-lambda-powertools/parameters/appconfig';
import { createExampleEntity } from '@e2e-test/my-table';
import { getPostgresDb } from './postgres-db<% JS %>';

// Startup checks for the container-deploy smoke test, which reads the
// E2E_CHECK lines from the service's log group.

const seconds = (name: string, fallback: number) =>
  Number(process.env[name] ?? fallback) * 1000;

const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

// The error message without its stack or secrets (AWS signing params, which
// also cover RDS IAM auth tokens, and passwords), cut to one short log line.
const redact = (error: unknown) =>
  (error instanceof Error ? error.message || error.name : String(error))
    .replace(
      /(X-Amz-(?:Security-Token|Signature|Credential|Date|SignedHeaders)=)[^&\s"']*/gi,
      '$1***',
    )
    .replace(/(:\/\/[^:/@\s]+:)[^@\s]*@/g, '$1***@')
    .replace(/(password=)[^&\s;"']*/gi, '$1***')
    .slice(0, 300);

const log = (line: Record<string, unknown>) =>
  console.log(`E2E_CHECK ${JSON.stringify(line)}`);

const putAndGetItem = async (token: string) => {
  const entity = await createExampleEntity();
  await entity.put({ id: token }).go();
  const { data } = await entity.get({ id: token }).go();
  if (data?.id !== token) {
    throw new Error(`read back ${JSON.stringify(data)}`);
  }
};

// getPostgresDb() keeps a failed runtime-config read for the life of the
// process, so wait until the configuration is deployed before the first call.
const waitForDatabaseConfig = async () => {
  const config = await getAppConfig<Record<string, unknown>>('database', {
    application: process.env.RUNTIME_CONFIG_APP_ID ?? '',
    environment: 'default',
    transform: 'json',
    forceFetch: true,
  });
  if (!config?.PostgresDb) {
    throw new Error('runtime config has no database.PostgresDb yet');
  }
};

let databaseConfigFound = false;

const insertAndSelectRow = async (token: string) => {
  if (!databaseConfigFound) {
    await waitForDatabaseConfig();
    databaseConfigFound = true;
  }
  const prisma = await getPostgresDb();
  const { id } = await prisma.exampleTable.create({
    data: { column1: token, column2: 'container-deploy' },
  });
  const row = await prisma.exampleTable.findUniqueOrThrow({ where: { id } });
  if (row.column1 !== token) {
    throw new Error(`read back ${JSON.stringify(row)}`);
  }
};

const runCheck = async (
  check: string,
  token: string,
  run: (token: string) => Promise<void>,
) => {
  // The default stays below the test's 10 minute wait for the final line.
  const deadline = Date.now() + seconds('E2E_CHECK_TIMEOUT_SECONDS', 480);
  const interval = seconds('E2E_CHECK_INTERVAL_SECONDS', 15);
  for (let attempt = 1; ; attempt++) {
    try {
      await run(token);
      log({ check, token, ok: true, final: true });
      return;
    } catch (error) {
      const message = redact(error);
      if (Date.now() + interval > deadline) {
        log({
          check,
          token,
          ok: false,
          final: true,
          attempt,
          detail: message,
          error: message,
        });
        return;
      }
      // A non-final line, so the test can show the latest error if it times out.
      log({ check, token, ok: false, final: false, attempt, error: message });
      await sleep(interval);
    }
  }
};

export const runE2eChecks = async (): Promise<void> => {
  const token = process.env.E2E_CHECK_TOKEN;
  if (!token) {
    return;
  }
  await Promise.all([
    runCheck('ts-service-my-table', token, putAndGetItem),
    runCheck('ts-service-postgres-db', token, insertAndSelectRow),
  ]);
};
