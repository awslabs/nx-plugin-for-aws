import fs from 'node:fs';
import { createRequire } from 'node:module';
import path from 'node:path';
import esmShim from '@rollup/plugin-esm-shim';
import { dts } from 'rolldown-plugin-dts';

/**
 * Every path handed to rolldown is relative to the workspace root, with forward
 * slashes, on every platform.
 *
 * A module's identity is its resolved path. rolldown reaches this project's files
 * two ways — the entry it is given, and the relative imports it follows from there
 * — and it spells the second form relative to its working directory. Handing it an
 * absolute entry (which on Windows also carries a drive letter) makes those two
 * spellings differ, so the same file is loaded twice and the second copy reads the
 * first's declarations as imports. The generated Server SDK merges an `interface`
 * with a `namespace`, whose emitted assignment then looks like a write to an
 * import, failing the build with ASSIGN_TO_IMPORT.
 *
 * The compile target runs from the workspace root, so these resolve there.
 */
const posix = (...segments) => path.join(...segments).split(path.sep).join('/');

// The Smithy CLI generates the Server SDK under dist, along with its own
// dependencies, so paths are resolved from there rather than this project.
const ssdkDir = posix(
  'dist',
  '<%- projectRoot %>',
  'smithy/source/typescript-ssdk-codegen',
);
const require = createRequire(
  path.resolve(process.cwd(), ssdkDir, 'package.json'),
);

// Bundle the re2-wasm wasm file as part of the module
const re2WasmPlugin = () => ({
  name: 're2-wasm-plugin',
  resolveId: (id) => {
    if (!(id === 're2-wasm' || id.endsWith('/re2-wasm'))) return null;
    try {
      const dir = posix(
        path.dirname(require.resolve('re2-wasm/package.json')),
        'build/wasm',
      );
      return fs.existsSync(path.join(dir, 're2.wasm')) &&
        fs.existsSync(path.join(dir, 're2.js'))
        ? posix(dir, 're2.js')
        : null;
    } catch {
      return null;
    }
  },
  load: (id) => {
    if (!(id.endsWith('re2.js') && id.includes('re2-wasm'))) return null;
    try {
      const wasmPath = path.join(path.dirname(id), 're2.wasm');
      return fs.existsSync(wasmPath) && fs.existsSync(id)
        ? `var Module = { wasmBinary: Buffer.from("${fs.readFileSync(wasmPath).toString('base64')}", "base64") }\n${fs.readFileSync(id, 'utf8')}`
        : null;
    } catch {
      return null;
    }
  },
});

const input = posix(ssdkDir, 'src/index.ts');
const tsconfigFilename = posix(ssdkDir, 'tsconfig.es.json');
const outDir = posix('dist', '<%- projectRoot %>', 'build/ssdk');

/**
 * The module and its type declaration are built in separate passes, so each sees
 * every file once — `rolldown-plugin-dts` loads the same sources a second time to
 * build the declaration.
 */
export default [
  {
    input,
    plugins: [re2WasmPlugin(), esmShim()],
    output: [{ dir: outDir, format: 'es' }],
    resolve: { tsconfigFilename },
    platform: 'node',
  },
  {
    input,
    plugins: [dts({ resolve: true, emitDtsOnly: true })],
    output: [{ dir: outDir, format: 'es' }],
    resolve: { tsconfigFilename },
    platform: 'node',
  },
];
