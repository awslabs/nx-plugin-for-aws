import fs from 'node:fs';
import { createRequire } from 'node:module';
import path from 'node:path';
import esmShim from '@rollup/plugin-esm-shim';
import { dts } from 'rolldown-plugin-dts';

// The Smithy CLI generates the Server SDK under dist, along with its own
// dependencies, so paths are resolved from there rather than this project. The
// compile target runs from the workspace root, so these resolve there.
const ssdkDir = path.resolve(
  'dist',
  '<%- projectRoot %>',
  'smithy/source/typescript-ssdk-codegen',
);
const require = createRequire(path.join(ssdkDir, 'package.json'));

// Bundle the re2-wasm wasm file as part of the module
const re2WasmPlugin = () => ({
  name: 're2-wasm-plugin',
  resolveId: (id) => {
    if (!(id === 're2-wasm' || id.endsWith('/re2-wasm'))) return null;
    try {
      const dir = path.join(
        path.dirname(require.resolve('re2-wasm/package.json')),
        'build/wasm',
      );
      const entry = path.join(dir, 're2.js');
      return fs.existsSync(path.join(dir, 're2.wasm')) && fs.existsSync(entry)
        ? entry
        : null;
    } catch {
      return null;
    }
  },
  load: (id) => {
    if (!(id.endsWith('re2.js') && id.includes('re2-wasm'))) return null;
    try {
      const wasmPath = path.join(path.dirname(id), 're2.wasm');
      return fs.existsSync(wasmPath) && fs.existsSync(id)
        ? `var Module = { wasmBinary: Buffer.from("${fs.readFileSync(wasmPath).toString('base64')}", "base64") }\n${fs.readFileSync(id, 'utf8')}`
        : null;
    } catch {
      return null;
    }
  },
});

// On Windows the Smithy code generator writes a module that imports its own
// exports from itself — `Echo.ts` opens with `import { Echo, ... } from "./Echo"`
// for names the same file also declares. tsc tolerated it by merging the two, but
// its emit was then wrong; bundling the sources directly, the redundant import
// collides with the local declarations (a namespace assigned to an import). The
// names are all declared locally, so the self-import is dropped before bundling,
// which matches what the generator emits on other platforms.
const stripSelfImports = () => ({
  name: 'strip-self-imports',
  transform: (code, id) => {
    if (!id.endsWith('.ts')) return null;
    const self = path.basename(id).replace(/\.[cm]?ts$/, '');
    const withoutSelfImport = code.replace(
      new RegExp(`^\\s*import\\s+[^;]*?from\\s+["']\\./${self}["'];?\\s*$`, 'gm'),
      '',
    );
    return withoutSelfImport === code
      ? null
      : { code: withoutSelfImport, map: null };
  },
});

const outDir = path.resolve('dist', '<%- projectRoot %>', 'build/ssdk');

/**
 * Bundle the Server SDK straight from the generated TypeScript sources, emitting
 * the module and its declarations in one pass. The sources rather than a `tsc`
 * pre-pass: the SDK merges an `interface` with a `namespace` and a `class` across
 * an operation↔service import cycle, which tsc mis-resolved on a case-insensitive
 * filesystem, emitting a module that imported a name from itself.
 */
export default {
  input: path.join(ssdkDir, 'src/index.ts'),
  plugins: [stripSelfImports(), re2WasmPlugin(), esmShim(), dts({ resolve: true })],
  output: [{ dir: outDir, format: 'es' }],
  platform: 'node',
};
