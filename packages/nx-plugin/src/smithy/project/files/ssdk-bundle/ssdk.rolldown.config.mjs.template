import fs from 'node:fs';
import { createRequire } from 'node:module';
import path from 'node:path';
import esmShim from '@rollup/plugin-esm-shim';
import { dts } from 'rolldown-plugin-dts';

/**
 * Paths are handed to rolldown with forward slashes on every platform.
 *
 * A module's identity is its resolved path, and rolldown reaches this project's
 * files two ways: the entry it is given, and the relative imports it follows from
 * there. On Windows `path.join` produces backslashes, so an entry spelled that way
 * and an import resolved the other spell the same file differently — it is then
 * loaded twice, and the second copy sees the first's declarations as imports. The
 * generated Server SDK merges an `interface` with a `namespace`, whose emitted
 * assignment then looks like a write to an import and fails the build with
 * ASSIGN_TO_IMPORT.
 */
const posix = (...segments) => path.join(...segments).split(path.sep).join('/');

// The Smithy CLI generates the Server SDK under dist, along with its own
// dependencies, so paths are resolved from there rather than this project.
const ssdkDir = posix(
  import.meta.dirname,
  '<%- relativePathToWorkspaceRoot %>',
  'dist',
  '<%- projectRoot %>',
  'smithy/source/typescript-ssdk-codegen',
);
const require = createRequire(path.join(ssdkDir, 'package.json'));

// Bundle the re2-wasm wasm file as part of the module
const re2WasmPlugin = () => ({
  name: 're2-wasm-plugin',
  resolveId: (id) => {
    if (!(id === 're2-wasm' || id.endsWith('/re2-wasm'))) return null;
    try {
      const dir = posix(
        path.dirname(require.resolve('re2-wasm/package.json')),
        'build/wasm',
      );
      return fs.existsSync(path.join(dir, 're2.wasm')) &&
        fs.existsSync(path.join(dir, 're2.js'))
        ? posix(dir, 're2.js')
        : null;
    } catch {
      return null;
    }
  },
  load: (id) => {
    if (!(id.endsWith('re2.js') && id.includes('re2-wasm'))) return null;
    try {
      const wasmPath = path.join(path.dirname(id), 're2.wasm');
      return fs.existsSync(wasmPath) && fs.existsSync(id)
        ? `var Module = { wasmBinary: Buffer.from("${fs.readFileSync(wasmPath).toString('base64')}", "base64") }\n${fs.readFileSync(id, 'utf8')}`
        : null;
    } catch {
      return null;
    }
  },
});

export default {
  input: posix(ssdkDir, 'src/index.ts'),
  plugins: [re2WasmPlugin(), dts({ resolve: true }), esmShim()],
  output: [
    {
      dir: posix(
        import.meta.dirname,
        '<%- relativePathToWorkspaceRoot %>',
        'dist',
        '<%- projectRoot %>',
        'build/ssdk',
      ),
      format: 'es',
    },
  ],
  resolve: { tsconfigFilename: posix(ssdkDir, 'tsconfig.es.json') },
  platform: 'node',
};
