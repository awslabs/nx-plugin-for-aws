{
  "version": "1.0",
  "sources": ["src/"],
  "plugins": {
    "openapi": {
      "service": "<%- namespace %>#<%- serviceNameClassName %>",
      "version": "3.1.0",
      "tags": true,
      "useIntegerType": true
    },
    "typescript-ssdk-codegen": {
      "package" : "@<%- scope %>/<%- serviceNameKebabCase %>-ssdk",
      "packageVersion": "0.0.1"
    }
  },
  "maven": {
    "dependencies": [
      "<%- smithyModelDependency %>",
      "<%- smithyAwsTraitsDependency %>",
      "<%- smithyValidationModelDependency %>",
      "<%- smithyOpenApiDependency %>",
      "<%- smithyTypeScriptCodegenDependency %>"
    ]
  }
}
