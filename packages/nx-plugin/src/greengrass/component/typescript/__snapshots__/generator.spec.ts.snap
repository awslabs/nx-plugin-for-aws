// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`greengrass#component generator (typescript) > multi-architecture (platform: linux-amd64-arm64) > should match snapshot for a multi-architecture component > multi-arch-snapshot 1`] = `
{
  "packages/test-project/greengrass/my-component/recipe.yaml": "RecipeFormatVersion: '2020-01-25'
ComponentName: com.proj.MyComponent
ComponentVersion: 1.0.0
ComponentDescription: com.proj.MyComponent Greengrass component, generated by greengrass#component.
ComponentPublisher: proj
Manifests:
  - Platform:
      os: linux
      architecture: amd64
    Artifacts:
      # Placeholders are substituted at publish time. The basename must stay
      # my-component.zip, which is what the Run script below unarchives to.
      - Uri: s3://BUCKET_NAME/COMPONENT_NAME/COMPONENT_VERSION/my-component.zip
        Unarchive: ZIP
    Lifecycle:
      # Requires a node binary on the device's PATH. The generated bundle was
      # tested with Node.js 22; Greengrass uses the installed runtime.
      Run: node {artifacts:decompressedPath}/my-component/index.js
  - Platform:
      os: linux
      architecture: aarch64
    Artifacts:
      # Placeholders are substituted at publish time. The basename must stay
      # my-component.zip, which is what the Run script below unarchives to.
      - Uri: s3://BUCKET_NAME/COMPONENT_NAME/COMPONENT_VERSION/my-component.zip
        Unarchive: ZIP
    Lifecycle:
      # Requires a node binary on the device's PATH. The generated bundle was
      # tested with Node.js 22; Greengrass uses the installed runtime.
      Run: node {artifacts:decompressedPath}/my-component/index.js
",
  "packages/test-project/project.json": "{
  "name": "test-project",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/test-project/src",
  "metadata": {
    "components": [
      {
        "generator": "greengrass#component",
        "path": "src/greengrass/my-component/main.ts",
        "name": "my-component",
        "language": "typescript",
        "componentName": "com.proj.MyComponent",
        "componentVersion": "1.0.0",
        "platform": "linux-amd64-arm64",
        "ipc": false,
        "gdkConfig": false
      }
    ]
  },
  "targets": {
    "assemble": {
      "dependsOn": ["bundle", "my-component-artifact"]
    },
    "build": {
      "dependsOn": ["bundle", "my-component-artifact"]
    },
    "bundle": {
      "executor": "nx:run-commands",
      "dependsOn": ["compile"],
      "cache": true,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/{projectRoot}/bundle"],
      "options": {
        "command": "rolldown -c rolldown.config.ts",
        "cwd": "{projectRoot}"
      }
    },
    "compile": {
      "executor": "@nx/js:tsc"
    },
    "my-component-artifact": {
      "executor": "nx:run-commands",
      "dependsOn": ["bundle"],
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/packages/common/scripts/src/greengrass/**/*"
      ],
      "outputs": [
        "{workspaceRoot}/dist/{projectRoot}/greengrass/my-component/greengrass-build"
      ],
      "options": {
        "command": "tsx packages/common/scripts/src/greengrass/build-artifact.ts {projectRoot} my-component dist/{projectRoot}/greengrass/my-component dist/{projectRoot}/bundle/greengrass/my-component"
      }
    },
    "my-component-deploy-local": {
      "executor": "nx:run-commands",
      "dependsOn": ["my-component-artifact"],
      "options": {
        "command": "tsx packages/common/scripts/src/greengrass/deploy-local.ts dist/{projectRoot}/greengrass/my-component"
      }
    },
    "my-component-logs": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "tsx packages/common/scripts/src/greengrass/component-logs.ts com.proj.MyComponent"
      }
    }
  }
}
",
  "packages/test-project/rolldown.config.ts": "import { defineConfig } from 'rolldown';

export default defineConfig([
  {
    tsconfig: 'tsconfig.lib.json',
    input: 'src/greengrass/my-component/main.ts',
    output: {
      file: '../../dist/packages/test-project/bundle/greengrass/my-component/index.js',
      format: 'cjs',
      codeSplitting: false,
    },
    platform: 'node',
  },
]);
",
  "packages/test-project/src/greengrass/my-component/main.ts": "const RUN_INTERVAL_MS = 30_000;

export function runOnce(sequence: number): void {
  console.log(
    \`[com.proj.MyComponent] heartbeat \${sequence} at \${new Date().toISOString()}\`,
  );
}

async function main(): Promise<void> {
  let sequence = 0;
  for (;;) {
    runOnce(sequence);
    sequence += 1;
    await new Promise((resolve) => setTimeout(resolve, RUN_INTERVAL_MS));
  }
}

main();
",
}
`;

