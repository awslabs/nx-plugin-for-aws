import importlib.util
from pathlib import Path

# main.py lives beside recipe.yaml under greengrass/<component>/, outside this
# project's importable package, so it is loaded directly by file path.
PROJECT_ROOT = Path(__file__).resolve().parents[2]
MAIN_PATH = PROJECT_ROOT / "greengrass" / "<%- componentDirName %>" / "main.py"


def _load_main():
    spec = importlib.util.spec_from_file_location("<%- componentSnakeCase %>_main", MAIN_PATH)
    assert spec is not None and spec.loader is not None
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module

<%_ if (ipc) { _%>

def test_publish_heartbeat_publishes_to_own_topic():
    module = _load_main()
    calls = []

    class FakeClient:
        def publish_to_topic(self, **kwargs):
            calls.append(kwargs)

    module.publish_heartbeat(FakeClient(), 1)

    assert len(calls) == 1
    assert calls[0]["topic"] == module.TOPIC
    assert module.TOPIC == "<%- componentName %>/heartbeat"
<%_ } else { _%>

def test_run_once_does_not_raise():
    module = _load_main()
    module.run_once(1)
