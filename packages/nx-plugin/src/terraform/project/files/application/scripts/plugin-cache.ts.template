/**
 * Shared provider cache for the `terraform init` calls these scripts make, so a
 * fresh checkout or a cleaned `.terraform` links the providers already on disk
 * rather than downloading them again.
 */
import { mkdirSync } from 'node:fs';
import { join } from 'node:path';

/**
 * The environment to pass to terraform, having created the cache directory —
 * terraform reports an error and falls back to downloading when it is missing.
 *
 * These scripts are invoked from the workspace root by their nx targets, which
 * is where the gitignored `.terraform` sits.
 */
export const pluginCacheEnv = (): NodeJS.ProcessEnv => {
  const dir = join(process.cwd(), '.terraform', 'plugin-cache');
  mkdirSync(dir, { recursive: true });
  return { ...process.env, TF_PLUGIN_CACHE_DIR: dir };
};
