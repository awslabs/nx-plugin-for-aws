import {
  BedrockAgentCoreClient,
  ListEventsCommand,
} from '@aws-sdk/client-bedrock-agentcore';
import { z } from 'zod';
import { actorIdFromEvent, runtimeSessionIdFor } from '../agui/session<% if (esm) { %>.js<% } %>';
import { publicProcedure } from '../init<% if (esm) { %>.js<% } %>';

const client = new BedrockAgentCoreClient({});

interface ParsedToolCall {
  id: string;
  type: 'function';
  function: { name: string; arguments: string };
}

interface ParsedToolResult {
  toolCallId: string;
  content: string;
}

interface ParsedTurnContent {
  text: string;
  toolCalls: ParsedToolCall[];
  toolResults: ParsedToolResult[];
}

const EMPTY_TURN_CONTENT: ParsedTurnContent = {
  text: '',
  toolCalls: [],
  toolResults: [],
};

function textFromToolResultContent(content: unknown): string {
  if (!Array.isArray(content)) return '';
  return content
    .filter(
      (part): part is { text: string } => typeof part?.text === 'string',
    )
    .map((part) => part.text)
    .join('');
}

// A Strands-backed Harness's Memory events store each turn as a
// JSON-stringified turn record — `conversational.content.text` is that
// string, not the message text itself. Unwrap `message.content[]` into text,
// toolUse and toolResult blocks; fall back to the raw string as plain text
// for a payload shape that turns out not to be this record (e.g. a future
// Harness runtime with a simpler content shape).
function parseTurnContent(content: unknown): ParsedTurnContent {
  const raw =
    content &&
    typeof content === 'object' &&
    'text' in content &&
    typeof content.text === 'string'
      ? content.text
      : '';
  if (!raw) return EMPTY_TURN_CONTENT;

  let parts: unknown;
  try {
    parts = JSON.parse(raw)?.message?.content;
  } catch {
    // Not the JSON turn-record shape — use the raw string as-is.
    return { ...EMPTY_TURN_CONTENT, text: raw };
  }
  if (!Array.isArray(parts)) return { ...EMPTY_TURN_CONTENT, text: raw };

  const textParts: string[] = [];
  const toolCalls: ParsedToolCall[] = [];
  const toolResults: ParsedToolResult[] = [];
  for (const part of parts) {
    if (typeof part?.text === 'string') {
      textParts.push(part.text);
    } else if (typeof part?.toolUse?.toolUseId === 'string') {
      toolCalls.push({
        id: part.toolUse.toolUseId,
        type: 'function',
        function: {
          name:
            typeof part.toolUse.name === 'string'
              ? part.toolUse.name
              : 'unknown',
          arguments: JSON.stringify(part.toolUse.input ?? {}),
        },
      });
    } else if (typeof part?.toolResult?.toolUseId === 'string') {
      toolResults.push({
        toolCallId: part.toolResult.toolUseId,
        content: textFromToolResultContent(part.toolResult.content),
      });
    }
  }
  return { text: textParts.join(''), toolCalls, toolResults };
}

const HistoryInputSchema = z.object({ threadId: z.string() });

const HistoryMessageSchema = z.object({
  role: z.enum(['user', 'assistant', 'tool']),
  content: z.string(),
  toolCalls: z
    .array(
      z.object({
        id: z.string(),
        type: z.literal('function'),
        function: z.object({ name: z.string(), arguments: z.string() }),
      }),
    )
    .optional(),
  toolCallId: z.string().optional(),
});

const HistoryOutputSchema = z.object({
  messages: z.array(HistoryMessageSchema),
});

/**
 * Reconstructs a conversation from AgentCore Memory. The Harness commits each
 * exchange to Memory as soon as it completes — independently of whether a
 * client is still connected to `/agui` — so this survives a dropped
 * connection, a page reload, or a check-in from another device. Scoped to the
 * caller's own actor id (server-derived, same as `/agui`), never a
 * client-supplied one.
 *
 * Reconstructs the full transcript, not just text: tool calls made by the
 * assistant become `toolCalls` on an assistant message, and their results
 * (stored under role USER in Memory) become separate `tool` messages keyed
 * by `toolCallId`, so a reloaded thread renders identically to the live
 * stream, tool-call chips included.
 */
export const history = publicProcedure
  .input(HistoryInputSchema)
  .output(HistoryOutputSchema)
  .query(async ({ input, ctx }) => {
    const actorId = actorIdFromEvent(ctx.event);
    const sessionId = runtimeSessionIdFor(actorId, input.threadId);

    const { events } = await client.send(
      new ListEventsCommand({
        memoryId: process.env.MEMORY_ARN!,
        actorId,
        sessionId,
        includePayloads: true,
        maxResults: 100,
      }),
    );

    // ListEvents returns events most-recent-first; the transcript needs the
    // opposite order to render oldest-to-newest.
    const messages = (events ?? [])
      .slice()
      .sort(
        (a, b) =>
          (a.eventTimestamp?.getTime() ?? 0) -
          (b.eventTimestamp?.getTime() ?? 0),
      )
      .flatMap((event) => event.payload ?? [])
      .flatMap((payload) =>
        payload.conversational ? [payload.conversational] : [],
      )
      .flatMap(
        (
          turn,
        ): Array<
          | { role: 'assistant'; content: string; toolCalls?: ParsedToolCall[] }
          | { role: 'user'; content: string }
          | { role: 'tool'; content: string; toolCallId: string }
        > => {
          const { text, toolCalls, toolResults } = parseTurnContent(
            turn.content,
          );

          if (turn.role === 'ASSISTANT') {
            return text || toolCalls.length
              ? [
                  {
                    role: 'assistant' as const,
                    content: text,
                    ...(toolCalls.length ? { toolCalls } : {}),
                  },
                ]
              : [];
          }

          return [
            ...(text ? [{ role: 'user' as const, content: text }] : []),
            ...toolResults.map((result) => ({
              role: 'tool' as const,
              content: result.content,
              toolCallId: result.toolCallId,
            })),
          ];
        },
      );

    return { messages };
  });
