import { randomUUID } from 'node:crypto';
import { getAppConfig } from '@aws-lambda-powertools/parameters/appconfig';
import {
  BedrockAgentCoreClient,
  InvokeHarnessCommand,
  type InvokeHarnessResponse,
  type InvokeHarnessStreamOutput,
} from '@aws-sdk/client-bedrock-agentcore';

/**
 * Runtime Configuration key segment registered for this Harness. The
 * deployed infrastructure publishes the Harness ARN at
 * `agentcore.harnesses.<%- nameClassName %>`.
 */
const HARNESS_RUNTIME_CONFIG_KEY = '<%- nameClassName %>';

/** Example command used by usage diagnostics. */
const INVOKE_EXAMPLE = 'nx run <%- fullyQualifiedName %>:invoke -- "Hello"';

/** Runtime Session IDs supplied via HARNESS_SESSION_ID must be 33-100 characters. */
const MIN_SESSION_ID_LENGTH = 33;
const MAX_SESSION_ID_LENGTH = 100;

/**
 * Environment surface read by the Invocation Client. Empty strings are
 * treated as absent, so `HARNESS_ARN= nx run ...` falls back to Runtime
 * Configuration discovery instead of sending an empty ARN.
 */
export interface HarnessInvocationEnvironment {
  HARNESS_ARN?: string;
  HARNESS_SESSION_ID?: string;
  RUNTIME_CONFIG_APP_ID?: string;
}

/**
 * Reads the `agentcore` Runtime Configuration namespace for an AppConfig
 * application and returns the parsed JSON document.
 */
export type ReadRuntimeConfig = (application: string) => Promise<unknown>;

/**
 * Output channels: streamed response text goes to `writeStdout`, every
 * diagnostic (session ID, metadata, errors) goes to `writeStderr`.
 */
export interface HarnessStreamIo {
  writeStdout(text: string): void;
  writeStderr(text: string): void;
}

/**
 * Protocol summary produced by consuming the event stream. Used for
 * completeness validation and tests; never serialized to stdout.
 */
export interface StreamSummary {
  sawMessageStart: boolean;
  sawMessageStop: boolean;
  contentBlockCount: number;
  textDeltaCount: number;
  metadataEventCount: number;
}

/** Minimal Data Plane client surface used by {@link runHarnessCli}. */
export interface HarnessInvocationClient {
  send(command: InvokeHarnessCommand): Promise<InvokeHarnessResponse>;
}

/**
 * Injectable collaborators for {@link runHarnessCli}. Production defaults
 * (process environment, process streams, `randomUUID`, the Powertools
 * AppConfig reader, and the real SDK client) apply when omitted.
 */
export interface RunHarnessCliDeps {
  env?: HarnessInvocationEnvironment;
  io?: HarnessStreamIo;
  randomUuid?: () => string;
  readRuntimeConfig?: ReadRuntimeConfig;
  createClient?: (region: string) => HarnessInvocationClient;
}

/** Environment values are optional and empty strings count as absent. */
const isPresent = (value: string | undefined): value is string =>
  value !== undefined && value !== '';

/**
 * Resolve the Harness ARN. A non-empty `HARNESS_ARN` wins without any
 * Runtime Configuration lookup; otherwise `RUNTIME_CONFIG_APP_ID` selects
 * the AppConfig application whose `agentcore` document is read through
 * `readRuntimeConfig`. When neither source can produce an ARN the error
 * names both options.
 */
export const resolveHarnessArn = async (
  env: HarnessInvocationEnvironment,
  readRuntimeConfig: ReadRuntimeConfig,
): Promise<string> => {
  if (isPresent(env.HARNESS_ARN)) {
    return env.HARNESS_ARN;
  }

  if (!isPresent(env.RUNTIME_CONFIG_APP_ID)) {
    throw new Error(
      'No Harness ARN source is configured. Set HARNESS_ARN to the deployed ' +
        'Harness ARN directly, or set RUNTIME_CONFIG_APP_ID to the AppConfig ' +
        'application ID emitted by your infrastructure stack.',
    );
  }

  const application = env.RUNTIME_CONFIG_APP_ID;
  const config = (await readRuntimeConfig(application)) as
    | { harnesses?: Record<string, string | undefined> }
    | null
    | undefined;
  const harnessArn = config?.harnesses?.[HARNESS_RUNTIME_CONFIG_KEY];
  if (!harnessArn) {
    throw new Error(
      `Runtime configuration for application '${application}' has no value ` +
        `at 'agentcore.harnesses.${HARNESS_RUNTIME_CONFIG_KEY}'. Deploy the ` +
        'Harness infrastructure first, or set HARNESS_ARN directly.',
    );
  }
  return harnessArn;
};

/**
 * Select the Runtime Session ID. A supplied `HARNESS_SESSION_ID` of 33-100
 * characters (inclusive) is reused verbatim for Session Continuity, an
 * out-of-range value is rejected before any AWS access, and an absent value
 * produces one freshly generated UUID.
 */
export const resolveSessionId = (
  env: HarnessInvocationEnvironment,
  randomUuid: () => string,
): string => {
  const supplied = env.HARNESS_SESSION_ID;
  if (!isPresent(supplied)) {
    return randomUuid();
  }
  if (
    supplied.length < MIN_SESSION_ID_LENGTH ||
    supplied.length > MAX_SESSION_ID_LENGTH
  ) {
    throw new Error(
      `HARNESS_SESSION_ID must contain between ${MIN_SESSION_ID_LENGTH} and ` +
        `${MAX_SESSION_ID_LENGTH} characters inclusive; received ` +
        `${supplied.length} characters.`,
    );
  }
  return supplied;
};

/**
 * Extract the AWS Region from a Harness ARN
 * (`arn:<partition>:bedrock-agentcore:<region>:<account>:harness/<id>`).
 * Partition-independent; a malformed or regionless ARN fails before any
 * SDK client is constructed.
 */
export const parseHarnessRegion = (harnessArn: string): string => {
  const segments = harnessArn.split(':');
  const region = segments.length > 3 ? segments[3] : '';
  if (
    segments[0] !== 'arn' ||
    segments.length < 6 ||
    !region ||
    !/^[A-Za-z0-9-]+$/.test(region)
  ) {
    throw new Error(
      `Could not determine an AWS Region from Harness ARN '${harnessArn}'. ` +
        'Expected the form ' +
        "'arn:<partition>:bedrock-agentcore:<region>:<account>:harness/<id>'.",
    );
  }
  return region;
};

/**
 * Consume the `InvokeHarness` event stream:
 *
 * - `contentBlockDelta` text is written to stdout in arrival order.
 * - `messageStart`, `contentBlockStart`, and `contentBlockStop` are
 *   recognized lifecycle events and never serialized into response text.
 * - `messageStop` marks successful protocol completion; consumption
 *   continues so trailing `metadata` events are still processed.
 * - `metadata` events are summarized on stderr, never stdout.
 * - `internalServerException`, `validationException`, and
 *   `runtimeClientError` events fail the invocation with service details.
 * - Event kinds not modeled by the pinned SDK are ignored silently.
 *
 * A stream that ends without `messageStop` is incomplete and fails; text
 * already written to stdout is preserved either way.
 */
export const consumeHarnessStream = async (
  stream: AsyncIterable<InvokeHarnessStreamOutput>,
  io: HarnessStreamIo,
): Promise<StreamSummary> => {
  const summary: StreamSummary = {
    sawMessageStart: false,
    sawMessageStop: false,
    contentBlockCount: 0,
    textDeltaCount: 0,
    metadataEventCount: 0,
  };

  for await (const event of stream) {
    if (event.messageStart) {
      summary.sawMessageStart = true;
    } else if (event.contentBlockStart) {
      summary.contentBlockCount += 1;
    } else if (event.contentBlockDelta) {
      const text = event.contentBlockDelta.delta?.text;
      if (text) {
        summary.textDeltaCount += 1;
        io.writeStdout(text);
      }
    } else if (event.contentBlockStop) {
      // Lifecycle-only event: recognized without serialized output.
    } else if (event.messageStop) {
      summary.sawMessageStop = true;
      // Keep consuming: metadata events can trail messageStop.
    } else if (event.metadata) {
      summary.metadataEventCount += 1;
      io.writeStderr(`Harness metadata: ${JSON.stringify(event.metadata)}\n`);
    } else {
      const serviceError =
        event.internalServerException ??
        event.validationException ??
        event.runtimeClientError;
      if (serviceError) {
        const detail = [serviceError.name, serviceError.message]
          .filter(Boolean)
          .join(': ');
        throw new Error(
          `Harness invocation failed: ${detail || JSON.stringify(serviceError)}`,
        );
      }
      // Unknown event kinds are ignored without writing to stdout or stderr.
    }
  }

  if (!summary.sawMessageStop) {
    throw new Error(
      'The Harness event stream ended without a messageStop event, so the ' +
        'response is incomplete.',
    );
  }

  return summary;
};

/** Default Runtime Configuration reader: the repository AppConfig convention. */
const readAgentCoreRuntimeConfig: ReadRuntimeConfig = async (application) =>
  await getAppConfig('agentcore', {
    application,
    environment: 'default',
    transform: 'json',
  });

/**
 * Invoke the Harness once with the supplied prompt and stream the response.
 * Returns the process exit code (0) on success; every failure throws so the
 * thin CLI wrapper in `invoke.ts` can report it and exit non-zero.
 */
export const runHarnessCli = async (
  prompt: string,
  deps: RunHarnessCliDeps = {},
): Promise<number> => {
  const env = deps.env ?? {
    HARNESS_ARN: process.env.HARNESS_ARN,
    HARNESS_SESSION_ID: process.env.HARNESS_SESSION_ID,
    RUNTIME_CONFIG_APP_ID: process.env.RUNTIME_CONFIG_APP_ID,
  };
  const io = deps.io ?? {
    writeStdout: (text: string) => {
      process.stdout.write(text);
    },
    writeStderr: (text: string) => {
      process.stderr.write(text);
    },
  };
  const randomUuid = deps.randomUuid ?? randomUUID;
  const readRuntimeConfig =
    deps.readRuntimeConfig ?? readAgentCoreRuntimeConfig;
  const createClient =
    deps.createClient ??
    // No explicit credentials: the standard AWS SDK default provider chain
    // (environment, shared config/SSO, or instance metadata) applies.
    ((region: string): HarnessInvocationClient =>
      new BedrockAgentCoreClient({ region }));

  // Reject an empty or whitespace-only prompt with usage guidance before
  // any AWS access.
  if (prompt.trim() === '') {
    throw new Error(`Provide a prompt, for example: ${INVOKE_EXAMPLE}`);
  }

  // Validate or generate the Runtime Session ID before any AWS access.
  const runtimeSessionId = resolveSessionId(env, randomUuid);

  // Discover the Harness ARN: direct value first, Runtime Configuration
  // second, actionable failure otherwise.
  const harnessArn = await resolveHarnessArn(env, readRuntimeConfig);

  // Derive the Region from the ARN before constructing the client; no
  // fixed Region is embedded in this project.
  const region = parseHarnessRegion(harnessArn);

  // Report the reusable session ID separately from streamed response text.
  io.writeStderr(`Harness session: ${runtimeSessionId}\n`);

  const client = createClient(region);
  const response = await client.send(
    new InvokeHarnessCommand({
      harnessArn,
      runtimeSessionId,
      messages: [{ role: 'user', content: [{ text: prompt }] }],
    }),
  );

  if (!response.stream) {
    throw new Error(
      'AgentCore returned no event stream for the invocation. Confirm the ' +
        'Harness is deployed and the caller has the ' +
        'bedrock-agentcore:InvokeHarness permission.',
    );
  }

  await consumeHarnessStream(response.stream, io);

  // Terminate the streamed text so the shell prompt starts on a new line.
  io.writeStdout('\n');
  return 0;
};
