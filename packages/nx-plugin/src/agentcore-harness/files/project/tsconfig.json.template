{
  // Isolated no-emit type-check configuration for the Harness Project, run
  // by the `build` target (`tsc --noEmit --project tsconfig.json`). It does
  // not extend a workspace tsconfig, so the project stays standalone.
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    // The Invocation Client runs as Node ESM through `tsx`, which resolves
    // package.json `exports` subpaths and extensionless relative imports.
    // `moduleDetection: force` keeps top-level `await` valid regardless of
    // the workspace root package.json `type` field.
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["invoke.ts", "invoke-harness.ts"]
}
