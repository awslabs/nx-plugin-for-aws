import { runHarnessCli } from './invoke-harness';

// Deterministic prompt normalization: every argument after the script path
// is joined with one ASCII space and the result is trimmed. A shell-quoted
// prompt stays one argument; unquoted words follow the same join rule.
const prompt = process.argv.slice(2).join(' ').trim();

// A promise chain (rather than top-level await) keeps this entry point valid
// whether tsx executes it as ESM or CommonJS. Every failure maps to one
// stderr diagnostic and a non-zero exit status; response text already
// streamed to stdout is preserved.
runHarnessCli(prompt)
  .then((exitCode) => {
    process.exitCode = exitCode;
  })
  .catch((error: unknown) => {
    console.error(error instanceof Error ? error.message : String(error));
    process.exitCode = 1;
  });
