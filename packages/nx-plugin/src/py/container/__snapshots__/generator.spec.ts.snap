exports[`py#container generator > snapshots > should vend the service with infra=ecs and iac=cdk > packages/my_proj/proj_my_proj/service/Dockerfile 1`] = `
"FROM public.ecr.aws/docker/library/python:3.14-slim

# Apply the distribution's security updates: base image tags lag behind the
# security suite, so its OS packages carry fixed HIGH/CRITICAL vulnerabilities
# flagged by the image scan.
RUN apt-get update && \\
    apt-get upgrade -y --no-install-recommends && \\
    rm -rf /var/lib/apt/lists/*

# Remove the base image's pip: the service runs from the bundled environment and
# never needs it at runtime, and pip's vendored packages carry known
# HIGH/CRITICAL vulnerabilities flagged by the image scan.
RUN python -m pip uninstall -y pip && \\
    rm -rf /usr/local/lib/python*/site-packages/pip \\
           /usr/local/lib/python*/site-packages/pip-*.dist-info

# uid and gid 1000 match the user the ECS task definition sets (EcsService
# \`user\`, Terraform \`container_user\`), the same uid as the node image's user.
RUN groupadd --gid 1000 app && \\
    useradd --uid 1000 --gid app --no-create-home --shell /usr/sbin/nologin app

WORKDIR /app

# Copy bundled package
COPY . /app

ENV PYTHONPATH=/app
ENV PATH="/app/bin:\${PATH}"
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV HOST=0.0.0.0
ENV PORT=8080

EXPOSE 8080

USER 1000:1000

CMD ["python", "-m", "proj_my_proj.service.main"]
"
`;

exports[`py#container generator > snapshots > should vend the service with infra=ecs and iac=cdk > packages/my_proj/proj_my_proj/service/main.py 1`] = `
"import os
from typing import Annotated

import uvicorn
from fastapi import FastAPI, Query
from pydantic import BaseModel

app = FastAPI(title="MyProjService")


class HealthOutput(BaseModel):
    status: str


class EchoOutput(BaseModel):
    message: str


@app.get("/health")
def health() -> HealthOutput:
    return HealthOutput(status="ok")


@app.get("/echo")
def echo(message: Annotated[str, Query(max_length=1024)]) -> EchoOutput:
    return EchoOutput(message=message)


if __name__ == "__main__":
    uvicorn.run(app, host=os.environ.get("HOST", "127.0.0.1"), port=int(os.environ.get("PORT", "8080")))
"
`;

