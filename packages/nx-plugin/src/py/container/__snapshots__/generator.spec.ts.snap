"{
  "name": "proj.my_proj",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "packages/my_proj/proj_my_proj",
  "release": {
    "version": {
      "versionActions": "@nxlv/python/release/version-actions"
    }
  },
  "tags": [],
  "metadata": {
    "generator": "py#project",
    "ports": [8081],
    "components": [
      {
        "generator": "py#container",
        "path": "proj_my_proj/service",
        "name": "service",
        "infra": "ecs",
        "port": 8081,
        "rc": "MyProjService",
        "iac": "cdk"
      }
    ]
  },
  "targets": {
    "add": {
      "executor": "@nxlv/python:add",
      "options": {}
    },
    "assemble": {
      "dependsOn": ["compile", "bundle", "docker"]
    },
    "build": {
      "dependsOn": ["lint", "compile", "test", "typecheck", "bundle", "docker"],
      "inputs": ["default", "^production"],
      "options": {
        "outputPath": "{workspaceRoot}/dist/{projectRoot}"
      }
    },
    "bundle": {
      "dependsOn": ["bundle-arm"]
    },
    "bundle-arm": {
      "executor": "nx:run-commands",
      "dependsOn": ["compile"],
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{workspaceRoot}/dist/{projectRoot}/bundle-arm"],
      "options": {
        "commands": [
          "uv export --frozen --no-dev --no-editable --project {projectRoot} --package proj.my_proj -o dist/{projectRoot}/bundle-arm/requirements.txt",
          "uv pip install -n --no-deps --no-installer-metadata --no-compile-bytecode --python-platform aarch64-manylinux_2_28 --python-version 3.14 --target dist/{projectRoot}/bundle-arm -r dist/{projectRoot}/bundle-arm/requirements.txt"
        ],
        "parallel": false
      }
    },
    "compile": {
      "executor": "@nxlv/python:build",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}/build"],
      "cache": true,
      "inputs": ["production", "^production"],
      "options": {
        "outputPath": "{workspaceRoot}/dist/{projectRoot}/build",
        "publish": false,
        "lockedVersions": true,
        "bundleLocalDependencies": true,
        "ignorePaths": [
          ".venv",
          ".tox",
          "tests",
          "__pycache__",
          ".coverage",
          ".coverage.*",
          ".pytest_cache",
          "pytest-cache-files-*",
          ".ruff_cache"
        ]
      }
    },
    "docker": {
      "dependsOn": ["service-docker"]
    },
    "format": {
      "executor": "@nxlv/python:ruff-format",
      "outputs": [],
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "filePatterns": ["proj_my_proj", "tests"],
        "check": true
      },
      "configurations": {
        "fix": {
          "check": false
        },
        "skip-lint": {
          "check": false
        }
      }
    },
    "install": {
      "executor": "@nxlv/python:install",
      "options": {
        "silent": false,
        "args": "",
        "verbose": false,
        "debug": false
      }
    },
    "lint": {
      "executor": "@nxlv/python:ruff-check",
      "dependsOn": ["format"],
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": [],
      "options": {
        "lintFilePatterns": ["proj_my_proj", "tests"]
      },
      "configurations": {
        "fix": {
          "fix": true
        },
        "skip-lint": {
          "exitZero": true
        }
      }
    },
    "lock": {
      "executor": "@nxlv/python:lock",
      "options": {
        "update": false
      }
    },
    "remove": {
      "executor": "@nxlv/python:remove",
      "options": {}
    },
    "service-docker": {
      "executor": "nx:run-commands",
      "dependsOn": ["bundle-arm"],
      "cache": false,
      "options": {
        "commands": [
          "shx rm -rf dist/packages/my_proj/docker/my-proj-service",
          "shx mkdir -p dist/packages/my_proj/docker/my-proj-service",
          "shx cp -R dist/packages/my_proj/bundle-arm/. dist/packages/my_proj/docker/my-proj-service",
          "shx cp packages/my_proj/proj_my_proj/service/Dockerfile dist/packages/my_proj/docker/my-proj-service/Dockerfile",
          "shx cp packages/my_proj/proj_my_proj/service/.dockerignore dist/packages/my_proj/docker/my-proj-service/.dockerignore",
          "docker build --platform linux/arm64 -t proj-my-proj-service:latest dist/packages/my_proj/docker/my-proj-service"
        ],
        "parallel": false
      }
    },
    "service-serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "commands": ["uv run python -m proj_my_proj.service.main"],
        "cwd": "{projectRoot}",
        "env": {
          "PORT": "8081",
          "LOCAL_DEV": "true"
        }
      }
    },
    "service-trivy": {
      "executor": "nx:run-commands",
      "dependsOn": ["service-docker"],
      "cache": false,
      "outputs": [
        "{workspaceRoot}/dist/packages/my_proj/trivy/proj-my-proj-service-latest"
      ],
      "options": {
        "commands": [
          "shx rm -rf dist/packages/my_proj/trivy/proj-my-proj-service-latest",
          "shx mkdir -p dist/packages/my_proj/trivy/proj-my-proj-service-latest",
          "shx cp packages/my_proj/.trivyignore dist/packages/my_proj/trivy/proj-my-proj-service-latest/.trivyignore",
          "docker save -o dist/packages/my_proj/trivy/proj-my-proj-service-latest/image-0.tar proj-my-proj-service:latest",
          "docker run --rm -v \\"./dist/packages/my_proj/trivy/proj-my-proj-service-latest\\":/scan public.ecr.aws/aquasecurity/trivy:0.72.0 image --input /scan/image-0.tar --ignorefile /scan/.trivyignore --scanners vuln --severity HIGH,CRITICAL --ignore-unfixed --exit-code 1 --no-progress -q"
        ],
        "parallel": false
      }
    },
    "sync": {
      "executor": "@nxlv/python:sync",
      "options": {}
    },
    "test": {
      "executor": "@nxlv/python:run-commands",
      "outputs": [
        "{workspaceRoot}/reports/{projectRoot}/unittests",
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "cache": true,
      "options": {
        "command": "uv run pytest tests/",
        "cwd": "{projectRoot}"
      }
    },
    "trivy": {
      "dependsOn": ["service-trivy"]
    },
    "typecheck": {
      "cache": true,
      "inputs": ["default", "^production"],
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "uv run ty check",
        "cwd": "{projectRoot}"
      }
    },
    "update": {
      "executor": "@nxlv/python:update",
      "options": {}
    }
  }
}
"
`;

exports[`py#container generator > snapshots > should vend the service with infra=ecs and iac=cdk > packages/my_proj/pyproject.toml 1`] = `
"[tool.coverage.run]
branch = true
source = [ "proj_my_proj" ]

[tool.coverage.report]
exclude_lines = [ "if TYPE_CHECKING:" ]
show_missing = true

[tool.pytest.ini_options]
addopts = """
 --cov
 --cov-report html:'../../coverage/packages/my_proj/html'
 --cov-report xml:'../../coverage/packages/my_proj/coverage.xml'
 --html='../../reports/packages/my_proj/unittests/html/index.html'
 --junitxml='../../reports/packages/my_proj/unittests/junit.xml'
"""

[tool.hatch.build.targets.wheel]
packages = [ "proj_my_proj" ]

[tool.hatch.metadata]
allow-direct-references = true

[tool.ruff]
exclude = [ ".ruff_cache", ".svn", ".tox", ".venv", "dist" ]
line-length = 120
indent-width = 4

  [tool.ruff.lint]
  select = [ "E", "F", "UP", "B", "SIM", "I" ]
  ignore = [ ]
  fixable = [ "ALL" ]
  unfixable = [ ]

[project]
name = "proj-my-proj"
version = "1.0.0"
description = "Automatically generated by Nx."
requires-python = ">=3.14"
readme = "README.md"
dependencies = [ "fastapi==0.163.1", "uvicorn==0.54.0" ]

[build-system]
requires = [ "hatchling" ]
build-backend = "hatchling.build"
"
`;

