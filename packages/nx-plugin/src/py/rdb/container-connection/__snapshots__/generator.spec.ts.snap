exports[`py#rdb#container-connection generator > should install the RDS CA bundle in the Dockerfile 1`] = `
"FROM public.ecr.aws/docker/library/python:3.12-slim

WORKDIR /app
COPY . /app

ADD https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem /usr/local/share/ca-certificates/rds-global-bundle.crt
RUN update-ca-certificates

EXPOSE 8080

CMD ["python", "-m", "py_svc.reports.main"]
"
`;
