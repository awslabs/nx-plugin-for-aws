import uuid

import uvicorn
from bedrock_agentcore.runtime.models import PingStatus
from pydantic import BaseModel, Field
<%_ if (auth === 'cognito') { _%>
from <%- agentConnectionModuleName %> import (
    get_current_session_id,
    get_current_user_id,
    get_session_storage_key,
    session_id_context,
)
<%_ } else { _%>
from <%- agentConnectionModuleName %> import (
    get_current_session_id,
    get_session_storage_key,
    session_id_context,
)
<%_ } _%>

from .init import JsonStreamingResponse, app
from .middleware.session_id_middleware import SessionIdMiddleware


class InvokeInput(BaseModel):
    prompt: str = Field(max_length=100000)


class StreamChunk(BaseModel):
    content: str


def _text(content) -> str:
    # ChatBedrockConverse streams content as a list of blocks, not a plain string.
    if isinstance(content, str):
        return content
    return "".join(
        block.get("text", "")
        for block in content
        if isinstance(block, dict) and block.get("type") == "text"
    )


async def handle_invoke(input: InvokeInput, session_id: str, user_id: str | None = None):
    """Streaming handler for agent invocation"""
    # The session id is the LangGraph thread id. The user id is passed
    # explicitly: this body streams outside the middleware's context.
    config = {"configurable": {"thread_id": get_session_storage_key(session_id, user_id)}}
    # Re-bind the session: the streaming body runs outside the middleware scope.
    with session_id_context(session_id):
        stream = app.state.graph.astream(
            {"messages": [{"role": "user", "content": input.prompt}]},
            config,
            stream_mode="messages",
        )
        async for message_chunk, _metadata in stream:
            text = _text(message_chunk.content)
            if text:
                yield StreamChunk(content=text)


@app.post(
    "/invocations",
    response_class=JsonStreamingResponse,
    responses={200: JsonStreamingResponse.openapi_response(StreamChunk, "Stream of agent response chunks")},
)
async def invoke(input: InvokeInput) -> JsonStreamingResponse:
    """Entry point for agent invocation"""
    session_id = get_current_session_id() or str(uuid.uuid4())
<%_ if (auth === 'cognito') { _%>
    return JsonStreamingResponse(handle_invoke(input, session_id, get_current_user_id()))
<%_ } else { _%>
    return JsonStreamingResponse(handle_invoke(input, session_id))
<%_ } _%>


app.add_middleware(SessionIdMiddleware)


@app.get("/ping")
def ping() -> str:
    # TODO: if running an async task, return PingStatus.HEALTHY_BUSY
    return PingStatus.HEALTHY


if __name__ == "__main__":
    uvicorn.run("<%- moduleName %>.<%- agentNameSnakeCase %>.main:app", port=8080)
