exports[`py#agent#guardrails generator > framework langchain > protocol http > should generate the guardrail with terraform > guardrail.py 1`] = `
"import logging
import os
import re
import threading
import time
from collections.abc import Iterator
from typing import Any, TypedDict

from langchain_aws import ChatBedrockConverse
from langchain_core.callbacks import CallbackManagerForLLMRun
from langchain_core.messages import BaseMessage
from langchain_core.outputs import ChatGenerationChunk, ChatResult
from proj_agent_connection.core.runtime_config import get_agentcore_runtime_config

logger = logging.getLogger(__name__)

RUNTIME_CONFIG_KEY = "agentcore.guardrails.TestProjectAgent"
CACHE_SECONDS = 5


class GuardrailConfig(TypedDict):
    guardrailIdentifier: str
    guardrailVersion: str
    trace: str


_lock = threading.Lock()
_cache: tuple[float, dict[str, Any] | None] | None = None
_warned_unguarded = False


def _read_entry() -> dict[str, Any] | None:
    """This agent's entry in runtime config, written by the TestProjectAgentGuardrail
    construct or the test-project-agent guardrail module, cached for CACHE_SECONDS."""
    global _cache
    with _lock:
        if _cache is None or time.monotonic() - _cache[0] >= CACHE_SECONDS:
            guardrails = get_agentcore_runtime_config().get("guardrails") or {}
            _cache = (time.monotonic(), guardrails.get("TestProjectAgent"))
        return _cache[1]


def resolve_guardrail() -> GuardrailConfig | None:
    """The guardrail to apply, read from runtime config on every model call (cached for 5 seconds)."""
    global _warned_unguarded
    local_dev = os.environ.get("LOCAL_DEV") == "true"
    entry: dict[str, Any] | None = None
    if not local_dev:
        entry = _read_entry()
    elif os.environ.get("RUNTIME_CONFIG_APP_ID"):
        try:
            entry = _read_entry()
        except Exception:
            entry = None

    guardrail_id = (entry or {}).get("guardrailId")
    guardrail_version = (entry or {}).get("guardrailVersion")
    if not guardrail_id or not guardrail_version:
        if not local_dev:
            raise RuntimeError(
                f"No guardrail for this agent in runtime config at {RUNTIME_CONFIG_KEY}. "
                "Add the TestProjectAgentGuardrail construct (CDK) or the "
                "guardrails/test-project-agent module (Terraform) to your infrastructure."
            )
        if not _warned_unguarded:
            _warned_unguarded = True
            logger.warning(
                "No guardrail for this agent in runtime config at %s, "
                "so the agent is running without a guardrail (LOCAL_DEV=true).",
                RUNTIME_CONFIG_KEY,
            )
        return None

    if not re.fullmatch(r"[1-9][0-9]*", str(guardrail_version)):
        raise RuntimeError(
            f"The guardrail version in runtime config at {RUNTIME_CONFIG_KEY} "
            f"must be a numbered guardrail version, but is {guardrail_version}."
        )
    return {
        "guardrailIdentifier": str(guardrail_id),
        "guardrailVersion": str(guardrail_version),
        "trace": "enabled",
    }


class GuardrailedChatBedrockConverse(ChatBedrockConverse):
    """A ChatBedrockConverse model that applies this agent's guardrail from runtime config
    to each model call, so a new guardrail version applies without a restart."""

    def _generate(
        self,
        messages: list[BaseMessage],
        stop: list[str] | None = None,
        run_manager: CallbackManagerForLLMRun | None = None,
        **kwargs: Any,
    ) -> ChatResult:
        kwargs["guardrail_config"] = resolve_guardrail()
        return super()._generate(messages, stop=stop, run_manager=run_manager, **kwargs)

    def _stream(
        self,
        messages: list[BaseMessage],
        stop: list[str] | None = None,
        run_manager: CallbackManagerForLLMRun | None = None,
        **kwargs: Any,
    ) -> Iterator[ChatGenerationChunk]:
        kwargs["guardrail_config"] = resolve_guardrail()
        yield from super()._stream(
            messages, stop=stop, run_manager=run_manager, **kwargs
        )
"
`;

exports[`py#agent#guardrails generator > framework langchain > protocol http > should generate the guardrail with terraform > module 1`] = `
"terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "6.69.1"
    }
    random = {
      source  = "hashicorp/random"
      version = "3.9.1"
    }
  }
}

variable "tags" {
  description = "Tags to apply to resources"
  type        = map(string)
  default     = {}
}

locals {
  policy_file = "\${path.module}/../../../../../../../apps/test-project/proj_test_project/agent/guardrail.json"
  policy      = jsondecode(file(local.policy_file))
  name_prefix = "test-project-agent-guardrail"
}

resource "random_id" "unique_suffix" {
  byte_length = 4
}

resource "aws_bedrock_guardrail" "this" {
  name                      = "\${local.name_prefix}-\${random_id.unique_suffix.hex}"
  blocked_input_messaging   = local.policy.blockedInputMessaging
  blocked_outputs_messaging = local.policy.blockedOutputsMessaging

  dynamic "topic_policy_config" {
    for_each = length(try(local.policy.deniedTopics, [])) > 0 ? [1] : []
    content {
      dynamic "topics_config" {
        for_each = local.policy.deniedTopics
        content {
          name       = topics_config.value.name
          definition = topics_config.value.definition
          examples   = try(topics_config.value.examples, [])
          type       = "DENY"
        }
      }
    }
  }

  dynamic "sensitive_information_policy_config" {
    for_each = length(try(local.policy.piiEntities, [])) > 0 ? [1] : []
    content {
      dynamic "pii_entities_config" {
        for_each = local.policy.piiEntities
        content {
          type   = pii_entities_config.value.type
          action = pii_entities_config.value.action
        }
      }
    }
  }

  tags = var.tags
}

resource "aws_bedrock_guardrail_version" "this" {
  guardrail_arn = aws_bedrock_guardrail.this.guardrail_arn
  description   = "guardrail.json sha256 \${filesha256(local.policy_file)}"

  lifecycle {
    create_before_destroy = true
  }
}

module "add_guardrail_to_runtime_config" {
  source = "../../../core/runtime-config/entry"

  namespace = "agentcore"
  key       = "guardrails"
  value     = { "TestProjectAgent" = { guardrailId = aws_bedrock_guardrail.this.guardrail_id, guardrailVersion = aws_bedrock_guardrail_version.this.version } }
}

output "guardrail_id" {
  description = "ID of the guardrail"
  value       = aws_bedrock_guardrail.this.guardrail_id
}

output "guardrail_arn" {
  description = "ARN of the guardrail"
  value       = aws_bedrock_guardrail.this.guardrail_arn
}

output "guardrail_version" {
  description = "Numbered version of the guardrail"
  value       = aws_bedrock_guardrail_version.this.version
}

output "iam_policy_statements" {
  description = "IAM policy statements that allow the agent to apply the guardrail"
  value = [
    {
      Effect   = "Allow"
      Action   = ["bedrock:ApplyGuardrail"]
      Resource = [aws_bedrock_guardrail.this.guardrail_arn]
    }
  ]
  depends_on = [module.add_guardrail_to_runtime_config]
}
"
`;

