import logging
import os
import re
import threading
import time
from collections.abc import Iterator
from typing import Any, TypedDict

from langchain_aws import ChatBedrockConverse
from langchain_core.callbacks import CallbackManagerForLLMRun
from langchain_core.messages import AIMessage, BaseMessage, HumanMessage
from langchain_core.outputs import ChatGenerationChunk, ChatResult

from <%- agentConnectionModuleName %>.core.runtime_config import get_agentcore_runtime_config

logger = logging.getLogger(__name__)

RUNTIME_CONFIG_KEY = "agentcore.guardrails.<%- agentNameClassName %>"
CACHE_SECONDS = 5
REDACTED_INPUT = "[User input redacted.]"


class GuardrailConfig(TypedDict):
    guardrailIdentifier: str
    guardrailVersion: str
    trace: str


_lock = threading.Lock()
_cache: tuple[float, dict[str, Any] | None] | None = None
_warned_unguarded = False


def _read_entry() -> dict[str, Any] | None:
    """This agent's entry in runtime config, written by the <%- agentNameClassName %>Guardrail
    construct or the <%- nameKebabCase %> guardrail module, cached for CACHE_SECONDS."""
    global _cache
    with _lock:
        if _cache is None or time.monotonic() - _cache[0] >= CACHE_SECONDS:
            guardrails = get_agentcore_runtime_config().get("guardrails") or {}
            _cache = (time.monotonic(), guardrails.get("<%- agentNameClassName %>"))
        return _cache[1]


def resolve_guardrail() -> GuardrailConfig | None:
    """The guardrail to apply, read from runtime config on every model call (cached for 5 seconds)."""
    global _warned_unguarded
    local_dev = os.environ.get("LOCAL_DEV") == "true"
    entry: dict[str, Any] | None = None
    if not local_dev:
        entry = _read_entry()
    elif os.environ.get("RUNTIME_CONFIG_APP_ID"):
        try:
            entry = _read_entry()
        except Exception:
            entry = None

    guardrail_id = (entry or {}).get("guardrailId")
    guardrail_version = (entry or {}).get("guardrailVersion")
    if not guardrail_id or not guardrail_version:
        if not local_dev:
            raise RuntimeError(
                f"No guardrail for this agent in runtime config at {RUNTIME_CONFIG_KEY}. "
                "Add the <%- agentNameClassName %>Guardrail construct (CDK) or the "
                "guardrails/<%- nameKebabCase %> module (Terraform) to your infrastructure."
            )
        if not _warned_unguarded:
            _warned_unguarded = True
            logger.warning(
                "No guardrail for this agent in runtime config at %s, "
                "so the agent is running without a guardrail (LOCAL_DEV=true).",
                RUNTIME_CONFIG_KEY,
            )
        return None

    if not re.fullmatch(r"[1-9][0-9]*", str(guardrail_version)):
        raise RuntimeError(
            f"The guardrail version in runtime config at {RUNTIME_CONFIG_KEY} "
            f"must be a numbered guardrail version, but is {guardrail_version}."
        )
    return {"guardrailIdentifier": str(guardrail_id), "guardrailVersion": str(guardrail_version), "trace": "enabled"}


def _blocked(value: Any) -> bool:
    """Whether a guardrail trace holds a policy that detected and blocked content."""
    if isinstance(value, dict):
        if value.get("action") == "BLOCKED" and value.get("detected") is True:
            return True
        return any(_blocked(item) for item in value.values())
    if isinstance(value, list):
        return any(_blocked(item) for item in value)
    return False


def redact_blocked_input(messages: list[BaseMessage]) -> list[BaseMessage]:
    """The messages with each user message whose turn the guardrail blocked replaced by
    REDACTED_INPUT, as Strands does. Bedrock checks every message of the conversation on
    each call, so a blocked message left in the session would block every later message."""
    redacted = list(messages)
    for index, message in enumerate(messages):
        if not isinstance(message, AIMessage) or message.response_metadata.get("stopReason") != "guardrail_intervened":
            continue
        trace = (message.response_metadata.get("trace") or {}).get("guardrail")
        if trace is not None and not _blocked(trace):
            continue
        for previous in range(index - 1, -1, -1):
            if isinstance(redacted[previous], HumanMessage):
                redacted[previous] = redacted[previous].model_copy(update={"content": REDACTED_INPUT})
                break
    return redacted


class GuardrailedChatBedrockConverse(ChatBedrockConverse):
    """A ChatBedrockConverse model that applies this agent's guardrail from runtime config
    to each model call, so a new guardrail version applies without a restart."""

    def _generate(
        self,
        messages: list[BaseMessage],
        stop: list[str] | None = None,
        run_manager: CallbackManagerForLLMRun | None = None,
        **kwargs: Any,
    ) -> ChatResult:
        kwargs["guardrail_config"] = resolve_guardrail()
        return super()._generate(redact_blocked_input(messages), stop=stop, run_manager=run_manager, **kwargs)

    def _stream(
        self,
        messages: list[BaseMessage],
        stop: list[str] | None = None,
        run_manager: CallbackManagerForLLMRun | None = None,
        **kwargs: Any,
    ) -> Iterator[ChatGenerationChunk]:
        kwargs["guardrail_config"] = resolve_guardrail()
        yield from super()._stream(redact_blocked_input(messages), stop=stop, run_manager=run_manager, **kwargs)
