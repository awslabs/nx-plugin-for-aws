"import { BedrockModel, type BedrockGuardrailConfig } from '@strands-agents/sdk';
import {
  type AgentCoreRuntimeConfig,
  getAgentCoreRuntimeConfig,
} from '@proj/agent-connection';

/**
 * This agent's entry in runtime config, written by the
 * TestProjectAgentGuardrail construct or the test-project-agent guardrail module.
 */
interface GuardrailEntry {
  guardrailId?: string;
  guardrailVersion?: string;
}

const RUNTIME_CONFIG_KEY = 'agentcore.guardrails.TestProjectAgent';

let warnedUnguarded = false;

const readEntry = async (): Promise<GuardrailEntry | undefined> => {
  const config: AgentCoreRuntimeConfig & {
    guardrails?: Record<string, GuardrailEntry>;
  } = await getAgentCoreRuntimeConfig();
  return config.guardrails?.['TestProjectAgent'];
};

/**
 * The guardrail to apply, read from runtime config on every model call
 * (cached for 5 seconds).
 */
const resolveGuardrail = async (): Promise<
  BedrockGuardrailConfig | undefined
> => {
  const localDev = process.env.LOCAL_DEV === 'true';
  let entry: GuardrailEntry | undefined;
  if (!localDev) {
    entry = await readEntry();
  } else if (process.env.RUNTIME_CONFIG_APP_ID) {
    entry = await readEntry().catch(() => undefined);
  }

  if (!entry?.guardrailId || !entry.guardrailVersion) {
    if (!localDev) {
      throw new Error(
        \`No guardrail for this agent in runtime config at \${RUNTIME_CONFIG_KEY}. Add the TestProjectAgentGuardrail construct (CDK) or the guardrails/test-project-agent module (Terraform) to your infrastructure.\`,
      );
    }
    if (!warnedUnguarded) {
      warnedUnguarded = true;
      console.warn(
        \`No guardrail for this agent in runtime config at \${RUNTIME_CONFIG_KEY}, so the agent is running without a guardrail (LOCAL_DEV=true).\`,
      );
    }
    return undefined;
  }

  if (!/^[1-9][0-9]*$/.test(entry.guardrailVersion)) {
    throw new Error(
      \`The guardrail version in runtime config at \${RUNTIME_CONFIG_KEY} must be a numbered guardrail version, but is \${entry.guardrailVersion}.\`,
    );
  }

  return {
    guardrailIdentifier: entry.guardrailId,
    guardrailVersion: entry.guardrailVersion,
    trace: 'enabled',
  };
};

/**
 * A Bedrock model that applies this agent's guardrail from runtime config
 * before each model call, so a new guardrail version applies without a
 * restart.
 */
export class GuardrailedBedrockModel extends BedrockModel {
  override async *stream(...args: Parameters<BedrockModel['stream']>) {
    this.updateConfig({ guardrailConfig: await resolveGuardrail() });
    return yield* super.stream(...args);
  }
}

/**
 * The Bedrock model with this agent's guardrail applied.
 */
export const getGuardrailedModel = (): BedrockModel =>
  new GuardrailedBedrockModel();
"
`;

exports[`ts#agent#guardrails generator > protocol ag-ui > should generate the guardrail with terraform > module 1`] = `
"terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "6.70.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "3.9.1"
    }
    time = {
      source  = "hashicorp/time"
      version = "0.14.2"
    }
  }
}

variable "tags" {
  description = "Tags to apply to resources"
  type        = map(string)
  default     = {}
}

locals {
  policy_file = "\${path.module}/../../../../../../../apps/test-project/src/agent/guardrail.json"
  policy      = jsondecode(file(local.policy_file))
  name_prefix = "test-project-agent-guardrail"
}

resource "random_id" "unique_suffix" {
  byte_length = 4
}

resource "aws_bedrock_guardrail" "this" {
  name                      = "\${local.name_prefix}-\${random_id.unique_suffix.hex}"
  blocked_input_messaging   = local.policy.blockedInputMessaging
  blocked_outputs_messaging = local.policy.blockedOutputsMessaging

  dynamic "topic_policy_config" {
    for_each = length(try(local.policy.deniedTopics, [])) > 0 ? [1] : []
    content {
      dynamic "topics_config" {
        for_each = local.policy.deniedTopics
        content {
          name       = topics_config.value.name
          definition = topics_config.value.definition
          examples   = try(topics_config.value.examples, [])
          type       = "DENY"
        }
      }
    }
  }

  dynamic "sensitive_information_policy_config" {
    for_each = length(try(local.policy.piiEntities, [])) > 0 ? [1] : []
    content {
      dynamic "pii_entities_config" {
        for_each = local.policy.piiEntities
        content {
          type   = pii_entities_config.value.type
          action = pii_entities_config.value.action
        }
      }
    }
  }

  tags = var.tags
}

resource "aws_bedrock_guardrail_version" "this" {
  guardrail_arn = aws_bedrock_guardrail.this.guardrail_arn
  description   = "guardrail.json sha256 \${filesha256(local.policy_file)}"

  lifecycle {
    create_before_destroy = true
  }
}

resource "time_sleep" "version_retention" {
  destroy_duration = "15s"

  triggers = {
    guardrail_id      = aws_bedrock_guardrail.this.guardrail_id
    guardrail_version = aws_bedrock_guardrail_version.this.version
  }

  lifecycle {
    create_before_destroy = true
  }
}

module "add_guardrail_to_runtime_config" {
  source = "../../../core/runtime-config/entry"

  namespace = "agentcore"
  key       = "guardrails"
  value     = { "TestProjectAgent" = { guardrailId = time_sleep.version_retention.triggers.guardrail_id, guardrailVersion = time_sleep.version_retention.triggers.guardrail_version } }
}

output "guardrail_id" {
  description = "ID of the guardrail"
  value       = aws_bedrock_guardrail.this.guardrail_id
}

output "guardrail_arn" {
  description = "ARN of the guardrail"
  value       = aws_bedrock_guardrail.this.guardrail_arn
}

output "guardrail_version" {
  description = "Numbered version of the guardrail"
  value       = aws_bedrock_guardrail_version.this.version
}

output "iam_policy_statements" {
  description = "IAM policy statements that allow the agent to apply the guardrail"
  value = [
    {
      Effect   = "Allow"
      Action   = ["bedrock:ApplyGuardrail"]
      Resource = [aws_bedrock_guardrail.this.guardrail_arn]
    }
  ]
  depends_on = [module.add_guardrail_to_runtime_config]
}
"
`;

