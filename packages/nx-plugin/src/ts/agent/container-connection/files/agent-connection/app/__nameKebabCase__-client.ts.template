import { getAppConfig } from '@aws-lambda-powertools/parameters/appconfig';
import { fromNodeProviderChain } from '@aws-sdk/credential-providers';
import { AwsClient } from 'aws4fetch';

type ServiceFetch = (url: string, init?: RequestInit) => Promise<Response>;

/**
 * Client for the <%- nameClassName %> container service. Requests are signed
 * with SigV4 using the caller's own role.
 */
export class <%- nameClassName %>Client {
  private constructor(
    readonly url: string,
    private readonly serviceFetch: ServiceFetch,
  ) {}

  static async create(): Promise<<%- nameClassName %>Client> {
    if (process.env.LOCAL_DEV === 'true') {
      return new <%- nameClassName %>Client('http://localhost:<%- port %>', (url, init) =>
        fetch(url, init),
      );
    }
    const application = process.env.RUNTIME_CONFIG_APP_ID;
    if (!application) {
      throw new Error(
        'RUNTIME_CONFIG_APP_ID is not set, so the <%- nameClassName %> service URL cannot be read from AppConfig.',
      );
    }
    const config = (await getAppConfig('connection', {
      application,
      environment: 'default',
      transform: 'json',
    })) as { services?: Record<string, string> };
    const url = config.services?.['<%- nameClassName %>'];
    if (!url) {
      throw new Error(
        "No container service named '<%- nameClassName %>' found in runtime configuration.",
      );
    }
    const credentialProvider = fromNodeProviderChain();
    const region = process.env.AWS_REGION ?? process.env.AWS_DEFAULT_REGION;
    return new <%- nameClassName %>Client(url, async (target, init) => {
      const client = new AwsClient({
        ...(await credentialProvider()),
        service: 'execute-api',
        region,
      });
      return client.fetch(target, init);
    });
  }

  /** Calls `path` on the service, for example `/health`. */
  fetch(path: string, init?: RequestInit): Promise<Response> {
    return this.serviceFetch(
      `${this.url.replace(/\/$/, '')}/${path.replace(/^\//, '')}`,
      init,
    );
  }
}
