import type { Request } from 'express';

const SESSION_ID_HEADER = 'x-amzn-bedrock-agentcore-runtime-session-id';

/**
 * Per-request context handed to tool registrations. Tools that store per-caller
 * data should scope it on this rather than on a model-supplied argument.
 */
export interface McpRequestContext {
  /** The caller's AgentCore session id, when invoked over HTTP. */
  sessionId?: string;
}

/** Reads the request context an HTTP transport received. */
export const requestContext = (req: Request): McpRequestContext => {
  const header = req.headers[SESSION_ID_HEADER];
  return {
    sessionId: Array.isArray(header) ? header[0] : header,
  };
};
