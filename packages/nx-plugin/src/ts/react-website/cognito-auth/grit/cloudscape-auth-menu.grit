`<TopNavigation $attrs />` => raw`<TopNavigation $attrs utilities={[{
  type: 'menu-dropdown',
  text: \`\${user?.profile?.['cognito:username']}\`,
  iconName: 'user-profile-active',
  onItemClick: (e) => {
    if (e.detail.id === 'signout') {
      removeUser();
      signoutRedirect({
        post_logout_redirect_uri: window.location.origin + new URL(import.meta.env.BASE_URL, document.baseURI).pathname.replace(/^\\/$/, ''),
        extraQueryParams: {
          redirect_uri: window.location.origin + new URL(import.meta.env.BASE_URL, document.baseURI).pathname.replace(/^\\/$/, ''),
          response_type: 'code',
        },
      });
      clearStaleState();
    }
  },
  items: [{ id: 'signout', text: 'Sign out' }],
}]} />` where {
  $attrs <: not contains `iconName: 'user-profile-active'`
}
