exports[`ts#container#react-connection generator > should vend the cognito hook 1`] = `
"import { useCallback } from 'react';
import { useAuth } from 'react-oidc-context';
import { useRuntimeConfig } from './useRuntimeConfig';

/**
 * Calls the Orders container service, whose URL runtime config holds
 * under \`services.Orders\`.
 */
export const useOrders = () => {
  const url: string | undefined = useRuntimeConfig().services?.Orders;
  const { user } = useAuth();

  const serviceFetch = useCallback(
    async (path: string, init?: RequestInit): Promise<Response> => {
      if (!url) {
        throw new Error(
          'No URL for the Orders service in runtime config (services.Orders)',
        );
      }
      const target = \`\${url.replace(/\\/$/, '')}/\${path.replace(/^\\//, '')}\`;
      const headers = new Headers(init?.headers);
      headers.set('Authorization', \`Bearer \${user?.access_token}\`);
      return fetch(target, { ...init, headers });
    },
    [url, user?.access_token],
  );

  return { url, fetch: serviceFetch };
};
"
`;

exports[`ts#container#react-connection generator > should vend the iam hook 1`] = `
"import { useCallback } from 'react';
import { useRuntimeConfig } from './useRuntimeConfig';
import { useSigV4 } from './useSigV4';

/**
 * Calls the Orders container service, whose URL runtime config holds
 * under \`services.Orders\`.
 */
export const useOrders = () => {
  const url: string | undefined = useRuntimeConfig().services?.Orders;
  const { fetch: signedFetch } = useSigV4();

  const serviceFetch = useCallback(
    async (path: string, init?: RequestInit): Promise<Response> => {
      if (!url) {
        throw new Error(
          'No URL for the Orders service in runtime config (services.Orders)',
        );
      }
      const target = \`\${url.replace(/\\/$/, '')}/\${path.replace(/^\\//, '')}\`;
      return signedFetch(target, init);
    },
    [url, signedFetch],
  );

  return { url, fetch: serviceFetch };
};
"
`;

