import { useCallback } from 'react';
<%_ if (auth === 'cognito') { _%>
import { useAuth } from 'react-oidc-context';
<%_ } _%>
import { useRuntimeConfig } from './useRuntimeConfig';
<%_ if (auth === 'iam') { _%>
import { useSigV4 } from './useSigV4';
<%_ } _%>

/**
 * Calls the <%- nameClassName %> container service, whose URL runtime config holds
 * under `services.<%- nameClassName %>`.
 */
export const use<%- nameClassName %> = () => {
  const url: string | undefined = useRuntimeConfig().services?.<%- nameClassName %>;
<%_ if (auth === 'iam') { _%>
  const { fetch: signedFetch } = useSigV4();
<%_ } else if (auth === 'cognito') { _%>
  const { user } = useAuth();
<%_ } _%>

  const serviceFetch = useCallback(
    async (path: string, init?: RequestInit): Promise<Response> => {
      if (!url) {
        throw new Error(
          'No URL for the <%- nameClassName %> service in runtime config (services.<%- nameClassName %>)',
        );
      }
      const target = `${url.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
<%_ if (auth === 'iam') { _%>
      return signedFetch(target, init);
<%_ } else if (auth === 'cognito') { _%>
      const headers = new Headers(init?.headers);
      headers.set('Authorization', `Bearer ${user?.access_token}`);
      return fetch(target, { ...init, headers });
<%_ } else { _%>
      return fetch(target, init);
<%_ } _%>
    },
    [url<% if (auth === 'iam') { %>, signedFetch<% } else if (auth === 'cognito') { %>, user?.access_token<% } %>],
  );

  return { url, fetch: serviceFetch };
};
