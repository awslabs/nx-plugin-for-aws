FROM <%- nodeBaseImage %>

# Apply the distribution's security updates: base image tags lag behind the
# security suite, so its OS packages carry fixed HIGH/CRITICAL vulnerabilities
# flagged by the image scan.
RUN apt-get update && \
    apt-get upgrade -y --no-install-recommends && \
    rm -rf /var/lib/apt/lists/*

# The runtime only needs node; npm's bundled dependencies would otherwise carry
# vulnerabilities into the image.
RUN npm uninstall -g npm

WORKDIR /app

# Copy the bundled server
COPY index.js /app

# The server listens on loopback unless HOST is set.
ENV HOST=0.0.0.0

EXPOSE 8080

# Run as the image's non-root user. Kept after EXPOSE: connections such as
# ts#rdb#container-connection insert root-only install steps before EXPOSE.
USER node

CMD [ "node", "index.js" ]
