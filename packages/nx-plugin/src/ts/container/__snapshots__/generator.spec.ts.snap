"{
  "name": "test-project",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/test-project/src",
  "metadata": {
    "ports": [8081],
    "components": [
      {
        "generator": "ts#container",
        "path": "src/service",
        "name": "service",
        "infra": "ecs",
        "ingress": "http-api",
        "auth": "cognito",
        "port": 8081,
        "rc": "TestProjectService",
        "iac": "cdk"
      }
    ]
  },
  "targets": {
    "assemble": {
      "dependsOn": ["bundle", "docker"]
    },
    "build": {
      "executor": "@nx/js:tsc",
      "dependsOn": ["bundle", "docker"],
      "options": {
        "outputPath": "dist/apps/test-project"
      }
    },
    "bundle": {
      "executor": "nx:run-commands",
      "dependsOn": ["compile"],
      "cache": true,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/{projectRoot}/bundle"],
      "options": {
        "command": "rolldown -c rolldown.config.ts",
        "cwd": "{projectRoot}"
      }
    },
    "dev": {
      "dependsOn": ["service-serve"],
      "continuous": true
    },
    "docker": {
      "dependsOn": ["service-docker"]
    },
    "service-docker": {
      "executor": "nx:run-commands",
      "dependsOn": ["bundle"],
      "cache": false,
      "options": {
        "commands": [
          "shx cp apps/test-project/src/service/Dockerfile dist/apps/test-project/bundle/container/test-project-service/Dockerfile",
          "shx cp apps/test-project/src/service/.dockerignore dist/apps/test-project/bundle/container/test-project-service/.dockerignore",
          "docker build --platform linux/arm64 -t proj-test-project-service:latest dist/apps/test-project/bundle/container/test-project-service"
        ],
        "parallel": false
      }
    },
    "service-serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "commands": ["tsx --watch ./src/service/index.ts"],
        "cwd": "{projectRoot}",
        "env": {
          "PORT": "8081"
        }
      }
    },
    "service-trivy": {
      "executor": "nx:run-commands",
      "dependsOn": ["service-docker"],
      "cache": false,
      "outputs": [
        "{workspaceRoot}/dist/apps/test-project/trivy/proj-test-project-service-latest"
      ],
      "options": {
        "commands": [
          "shx rm -rf dist/apps/test-project/trivy/proj-test-project-service-latest",
          "shx mkdir -p dist/apps/test-project/trivy/proj-test-project-service-latest",
          "shx cp apps/test-project/.trivyignore dist/apps/test-project/trivy/proj-test-project-service-latest/.trivyignore",
          "docker save -o dist/apps/test-project/trivy/proj-test-project-service-latest/image-0.tar proj-test-project-service:latest",
          "docker run --rm -v \\"./dist/apps/test-project/trivy/proj-test-project-service-latest\\":/scan public.ecr.aws/aquasecurity/trivy:0.72.0 image --input /scan/image-0.tar --ignorefile /scan/.trivyignore --scanners vuln --severity HIGH,CRITICAL --ignore-unfixed --exit-code 1 --no-progress -q"
        ],
        "parallel": false
      }
    },
    "trivy": {
      "dependsOn": ["service-trivy"]
    }
  }
}
"
`;

