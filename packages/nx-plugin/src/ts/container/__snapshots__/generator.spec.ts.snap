exports[`ts#container generator > should match the generated files snapshot (ecs) > packages/common/constructs/src/app/services/test-project-container.ts 1`] = `
"import * as path from 'path';
import * as url from 'url';
import { Duration } from 'aws-cdk-lib';
import { Construct } from 'constructs';
import {
  EcsService,
  EcsServiceImage,
  EcsServiceProps,
} from '../../core/container/ecs-service.js';
import { RuntimeConfig } from '../../core/runtime-config.js';
import { findWorkspaceRoot } from '../../core/workspace.js';

const dockerBuildContextDir = path.join(
  findWorkspaceRoot(url.fileURLToPath(new URL(import.meta.url))),
  'dist/apps/test-project/bundle/container/test-project-container',
);

export type TestProjectContainerProps = Omit<
  EcsServiceProps,
  'serviceName' | 'image'
> & {
  /**
   * The image to run.
   *
   * @default the image built from dist/apps/test-project/bundle/container/test-project-container
   */
  readonly image?: EcsServiceImage;
};

/**
 * The TestProjectContainer container service on Amazon ECS. The container runs a
 * health check on \`/health\`, gets \`RUNTIME_CONFIG_APP_ID\`, and its task role may
 * read runtime configuration from AWS AppConfig.
 */
export class TestProjectContainer extends EcsService {
  constructor(scope: Construct, id: string, props: TestProjectContainerProps) {
    const rc = RuntimeConfig.ensure(scope);
    super(scope, id, {
      containerPort: 8080,
      healthCheck: {
        command: [
          'CMD',
          'node',
          '-e',
          "fetch('http://127.0.0.1:'+(process.env.PORT||'8080')+'/health',{signal:AbortSignal.timeout(3000)}).then(r=>process.exit(r.ok?0:1),()=>process.exit(1))",
        ],
        interval: Duration.seconds(30),
        timeout: Duration.seconds(5),
        retries: 3,
        startPeriod: Duration.seconds(30),
      },
      ...props,
      serviceName: 'TestProjectContainer',
      image: props.image ?? { directory: dockerBuildContextDir },
      environment: {
        RUNTIME_CONFIG_APP_ID: rc.appConfigApplicationId,
        ...props.environment,
      },
    });

    rc.grantReadAppConfig(this.taskRole);
  }
}
"
`;

