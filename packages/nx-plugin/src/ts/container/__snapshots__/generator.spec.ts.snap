"import * as path from 'path';
import * as url from 'url';
import { Construct } from 'constructs';
import {
  EcsService,
  EcsServiceImage,
  EcsServiceProps,
} from '../../core/container/ecs-service.js';
import { findWorkspaceRoot } from '../../core/workspace.js';

const dockerBuildContextDir = path.join(
  findWorkspaceRoot(url.fileURLToPath(new URL(import.meta.url))),
  'dist/apps/test-project/bundle/container/test-project-service',
);

export type TestProjectServiceProps = Omit<
  EcsServiceProps,
  'serviceName' | 'image' | 'ingress' | 'auth'
> & {
  /**
   * The image to run.
   *
   * @default the image built from dist/apps/test-project/bundle/container/test-project-service
   */
  readonly image?: EcsServiceImage;
};

/**
 * The TestProjectService container service on Amazon ECS.
 */
export class TestProjectService extends EcsService {
  constructor(scope: Construct, id: string, props: TestProjectServiceProps) {
    super(scope, id, {
      containerPort: 8080,
      ...props,
      serviceName: 'TestProjectService',
      image: props.image ?? { directory: dockerBuildContextDir },
      ...(props.loadBalancer === false
        ? {}
        : {
            ingress: 'http-api',
            auth: { type: 'none' },
          }),
    });
  }
}
"
`;

