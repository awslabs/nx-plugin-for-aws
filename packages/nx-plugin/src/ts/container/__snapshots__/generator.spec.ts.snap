      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/{projectRoot}/bundle"],
      "options": {
        "command": "rolldown -c rolldown.config.ts",
        "cwd": "{projectRoot}"
      }
    },
    "container-docker": {
      "executor": "nx:run-commands",
      "dependsOn": ["bundle"],
      "cache": false,
      "options": {
        "commands": [
          "shx cp apps/test-project/src/container/Dockerfile dist/apps/test-project/bundle/container/test-project-container/Dockerfile",
          "shx cp apps/test-project/src/container/.dockerignore dist/apps/test-project/bundle/container/test-project-container/.dockerignore",
          "docker build --platform linux/arm64 -t proj-test-project-container:latest dist/apps/test-project/bundle/container/test-project-container"
        ],
        "parallel": false
      }
    },
    "container-serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "commands": ["tsx --watch ./src/container/index.ts"],
        "cwd": "{projectRoot}",
        "env": {
          "PORT": "8081",
          "LOCAL_DEV": "true"
        }
      }
    },
    "container-trivy": {
      "executor": "nx:run-commands",
      "dependsOn": ["container-docker"],
      "cache": false,
      "outputs": [
