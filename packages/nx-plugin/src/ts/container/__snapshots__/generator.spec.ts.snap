          "shx mkdir -p dist/apps/test-project/trivy/proj-test-project-container-latest",
          "shx cp apps/test-project/.trivyignore dist/apps/test-project/trivy/proj-test-project-container-latest/.trivyignore",
          "docker save -o dist/apps/test-project/trivy/proj-test-project-container-latest/image-0.tar proj-test-project-container:latest",
          "docker run --rm -v \\"./dist/apps/test-project/trivy/proj-test-project-container-latest\\":/scan public.ecr.aws/aquasecurity/trivy:0.72.0 image --input /scan/image-0.tar --ignorefile /scan/.trivyignore --scanners vuln --severity HIGH,CRITICAL --ignore-unfixed --exit-code 1 --no-progress -q"
        ],
        "parallel": false
      }
    },
    "dev": {
      "dependsOn": ["container-serve"],
      "continuous": true
    },
    "docker": {
      "dependsOn": ["container-docker"]
    },
