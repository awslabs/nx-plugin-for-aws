exports[`ts#container generator > should match the generated files snapshot (http-api cognito) > apps/test-project/src/service/Dockerfile 1`] = `
"FROM public.ecr.aws/docker/library/node:lts-slim

# Apply the distribution's security updates: base image tags lag behind the
# security suite, so its OS packages carry fixed HIGH/CRITICAL vulnerabilities
# flagged by the image scan.
RUN apt-get update && \\
    apt-get upgrade -y --no-install-recommends && \\
    rm -rf /var/lib/apt/lists/*

# The runtime only needs node; npm's bundled dependencies would otherwise carry
# vulnerabilities into the image.
RUN npm uninstall -g npm

WORKDIR /app

# Copy the bundled server
COPY index.js /app

USER node

EXPOSE 8080

CMD [ "node", "index.js" ]
"
`;

exports[`ts#container generator > should match the generated files snapshot (http-api cognito) > apps/test-project/src/service/index.ts 1`] = `
"import { createServer } from './server.js';

const PORT = parseInt(process.env.PORT || '8080');

const server = createServer();

server.listen(PORT, () => {
  console.log(\`Listening on port \${PORT}\`);
});

// ECS stops a task with SIGTERM.
process.on('SIGTERM', () => {
  server.close(() => process.exit(0));
});
"
`;

exports[`ts#container generator > should match the generated files snapshot (http-api cognito) > apps/test-project/src/service/server.ts 1`] = `
"import {
  createServer as createHttpServer,
  Server,
  ServerResponse,
} from 'node:http';

const json = (res: ServerResponse, status: number, body: unknown) => {
  res.writeHead(status, { 'content-type': 'application/json' });
  res.end(JSON.stringify(body));
};

export const createServer = (): Server =>
  createHttpServer((req, res) => {
    const url = new URL(req.url ?? '/', 'http://localhost');

    if (req.method === 'GET' && url.pathname === '/health') {
      return json(res, 200, { status: 'ok' });
    }

    if (req.method === 'GET' && url.pathname === '/hello') {
      const name = url.searchParams.get('name') ?? 'world';
      return json(res, 200, { message: \`Hello, \${name}!\` });
    }

    return json(res, 404, { message: 'Not found' });
  });
"
`;

