import { createServer as createHttpServer, Server } from 'node:http';
import { createHTTPHandler } from '@trpc/server/adapters/standalone';
import { appRouter } from '../router<% if (esm) { %>.js<% } %>';

/**
 * Path the load balancer's target group and the container health check call.
 * Changing it means changing the health check in your API CDK construct too.
 */
export const HEALTH_CHECK_PATH = '<%- healthCheckPath %>';

/**
 * Serves the tRPC router over HTTP. A load balancer forwards the request here,
 * so there is no API Gateway event and no Lambda context: the procedure context
 * holds only what the middleware puts in it. The caller's identity is checked by
 * the HTTP API's authorizer and does not reach the container unless your API
 * construct maps it to a request header.
 */
const handleTrpcRequest = createHTTPHandler({
  router: appRouter,
  createContext() {
    return {};
  },
});

export const createServer = (): Server =>
  createHttpServer((req, res) => {
    const url = new URL(req.url ?? '/', 'http://localhost');

    if (req.method === 'GET' && url.pathname === HEALTH_CHECK_PATH) {
      res.writeHead(200, { 'content-type': 'application/json' });
      return res.end(JSON.stringify({ status: 'ok' }));
    }

    return handleTrpcRequest(req, res);
  });
