<%_ if (infra !== 'http-ecs') { _%>
import { CreateAWSLambdaContextOptions } from '@trpc/server/adapters/aws-lambda';
import type { <%- apiGatewayEventType %> } from 'aws-lambda';
<%_ } _%>
import { ILoggerContext } from './logger<% if (esm) { %>.js<% } %>';
import { IMetricsContext } from './metrics<% if (esm) { %>.js<% } %>';
import { ITracerContext } from './tracer<% if (esm) { %>.js<% } %>';

export * from './logger<% if (esm) { %>.js<% } %>';
export * from './metrics<% if (esm) { %>.js<% } %>';
export * from './tracer<% if (esm) { %>.js<% } %>';
export * from './error<% if (esm) { %>.js<% } %>';

<%_ if (infra === 'http-ecs') { _%>
/**
 * The context every procedure receives.
 *
 * A load balancer forwards the request to the container, so no API Gateway
 * event, Lambda context or adapter info arrives with it, and this type names
 * none of them. The caller's identity is checked by the HTTP API's authorizer
 * and reaches the container only if your API construct maps the authorizer
 * context onto a request header.
 */
export type IMiddlewareContext = ILoggerContext
  & IMetricsContext
  & ITracerContext;
<%_ } else { _%>
export type IMiddlewareContext = CreateAWSLambdaContextOptions<<%- apiGatewayEventType %>>
  & ILoggerContext
  & IMetricsContext
  & ITracerContext;
<%_ } _%>
