import { createHTTPServer } from '@trpc/server/adapters/standalone';
import { appRouter } from './router<% if (esm) { %>.js<% } %>';
import cors from 'cors';

const PORT = <%- port %>;
// Loopback, so the local server accepts connections only from this machine.
const HOST = process.env.HOST || '127.0.0.1';

createHTTPServer({
  router: appRouter,
  middleware: cors(),
  createContext() {
    return {
      event: {} as any,
      context: {} as any,
      info: {} as any,
    };
  },
}).listen(PORT, HOST);

console.log(`Local TRPC server listening on ${HOST}:${PORT}`);
