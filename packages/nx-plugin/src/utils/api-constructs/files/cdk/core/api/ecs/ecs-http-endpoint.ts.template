import { Duration } from 'aws-cdk-lib';
import {
  HttpRouteIntegration,
  VpcLink,
} from 'aws-cdk-lib/aws-apigatewayv2';
import { HttpAlbIntegration } from 'aws-cdk-lib/aws-apigatewayv2-integrations';
import {
  IVpc,
  SecurityGroup,
  SubnetSelection,
  SubnetType,
} from 'aws-cdk-lib/aws-ec2';
import { FargateService } from 'aws-cdk-lib/aws-ecs';
import {
  ApplicationListener,
  ApplicationLoadBalancer,
  ApplicationProtocol,
  ApplicationTargetGroup,
} from 'aws-cdk-lib/aws-elasticloadbalancingv2';
import { Construct } from 'constructs';
import { suppressRules } from '../checkov<% if (esm) { %>.js<% } %>';

/** Port the internal load balancer's listener accepts requests on. */
const LISTENER_PORT = 80;

/**
 * Properties for an {@link EcsHttpEndpoint}.
 */
export interface EcsHttpEndpointProps {
  /**
   * VPC holding the load balancer and the VPC link. It must be the VPC the
   * service runs in.
   */
  readonly vpc: IVpc;
  /**
   * Subnets for the load balancer and the VPC link. They must be private:
   * nothing here is reachable from the internet.
   *
   * @default { subnetType: SubnetType.PRIVATE_WITH_EGRESS }
   */
  readonly vpcSubnets?: SubnetSelection;
  /**
   * The Fargate service to send requests to, registered as IP targets.
   */
  readonly service: FargateService;
  /**
   * Port the server listens on inside the container.
   */
  readonly containerPort: number;
  /**
   * Path the target group health check calls, which must answer 200.
   */
  readonly healthCheckPath: string;
}

/**
 * The path API Gateway reaches a private container service through: a VPC
 * link, an internal load balancer, and a target group holding the service's
 * tasks.
 *
 * Every API that hosts its operations on Amazon ECS uses this construct, so
 * the load balancer, the VPC link and the security-group rules between them
 * are defined in one place.
 *
 * Exactly two connections are allowed: the VPC link to the load balancer's
 * listener, and the load balancer to the tasks' container port. Neither the
 * load balancer nor the tasks are reachable from the internet, and no rule
 * names an address range.
 */
export class EcsHttpEndpoint extends Construct {
  /** The internal load balancer in front of the service. */
  public readonly loadBalancer: ApplicationLoadBalancer;
  /** The load balancer's listener, which API Gateway integrates with. */
  public readonly listener: ApplicationListener;
  /** The target group holding the service's tasks. */
  public readonly targetGroup: ApplicationTargetGroup;
  /** API Gateway's path into the VPC. */
  public readonly vpcLink: VpcLink;
  /** The integration an HTTP API route uses to reach the service. */
  public readonly integration: HttpRouteIntegration;

  constructor(scope: Construct, id: string, props: EcsHttpEndpointProps) {
    super(scope, id);
    const vpcSubnets = props.vpcSubnets ?? {
      subnetType: SubnetType.PRIVATE_WITH_EGRESS,
    };

    // Named so the load balancer's only inbound rule can reference it.
    const vpcLinkSecurityGroup = new SecurityGroup(
      this,
      'VpcLinkSecurityGroup',
      {
        vpc: props.vpc,
        description:
          'API Gateway VPC link. Reaches the internal load balancer only.',
        allowAllOutbound: true,
      },
    );
    this.vpcLink = new VpcLink(this, 'VpcLink', {
      vpc: props.vpc,
      subnets: vpcSubnets,
      securityGroups: [vpcLinkSecurityGroup],
    });

    this.loadBalancer = new ApplicationLoadBalancer(this, 'LoadBalancer', {
      vpc: props.vpc,
      vpcSubnets,
      // Only API Gateway reaches this load balancer, through the VPC link.
      internetFacing: false,
      // Headers that do not parse are dropped rather than passed to the
      // container.
      dropInvalidHeaderFields: true,
    });
    suppressRules(
      this.loadBalancer,
      ['CKV_AWS_91'],
      'API Gateway is the only caller, and its stage logs every request to CloudWatch Logs',
    );

    this.listener = this.loadBalancer.addListener('Listener', {
      port: LISTENER_PORT,
      protocol: ApplicationProtocol.HTTP,
      // `open` defaults to true, which would allow 0.0.0.0/0 on the listener
      // port. The VPC link's security group below is the only source allowed.
      open: false,
    });
    this.listener.connections.allowDefaultPortFrom(
      vpcLinkSecurityGroup,
      'API Gateway VPC link to the load balancer',
    );
    suppressRules(
      this.listener,
      ['CKV_AWS_2', 'CKV_AWS_103'],
      'TLS terminates at API Gateway; this listener is reachable only from the VPC link inside the VPC',
    );

    // Registering the service as a target adds the tasks' only inbound rule:
    // the load balancer's security group on the container port.
    this.targetGroup = this.listener.addTargets('Targets', {
      port: props.containerPort,
      protocol: ApplicationProtocol.HTTP,
      targets: [props.service],
      healthCheck: {
        path: props.healthCheckPath,
        healthyHttpCodes: '200',
        interval: Duration.seconds(15),
        timeout: Duration.seconds(5),
        healthyThresholdCount: 2,
        unhealthyThresholdCount: 3,
      },
      deregistrationDelay: Duration.seconds(30),
    });

    this.integration = new HttpAlbIntegration(
      'AlbIntegration',
      this.listener,
      { vpcLink: this.vpcLink },
    );
  }
}
