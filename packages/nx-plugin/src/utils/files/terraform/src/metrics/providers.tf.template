# Kept beside metrics.tf rather than in it: the metric id, version and tags are
# rewritten in place by the generators, which matches metrics.tf against the
# shape vended here.
terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "<%- awsProviderVersion %>"
    }
    random = {
      source  = "hashicorp/random"
      version = "<%- randomProviderVersion %>"
    }
  }
}
