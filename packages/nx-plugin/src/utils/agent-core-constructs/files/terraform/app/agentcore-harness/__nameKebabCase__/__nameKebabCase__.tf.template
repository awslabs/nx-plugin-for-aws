terraform {
  required_version = ">= 1.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "<%- awsProviderVersion %>"
    }
    random = {
      source  = "hashicorp/random"
      version = "<%- randomProviderVersion %>"
    }
  }
}

variable "model_id" {
  description = "Amazon Bedrock model or inference profile used by default."
  type        = string
  default     = <%- modelIdHcl %>
}

variable "system_prompt" {
  description = "Default system prompt for the Harness."
  type        = string
  sensitive   = true
  default     = <%- systemPromptHcl %>
}

variable "allowed_tools" {
  description = "Tool patterns the Harness may call (e.g. \"@builtin\")."
  type        = list(string)
  default     = <%- allowedToolsHcl %>

  validation {
    condition     = length(var.allowed_tools) >= 1 && length(var.allowed_tools) <= 64
    error_message = "allowed_tools must contain between 1 and 64 entries."
  }

  validation {
    condition     = alltrue([for tool in var.allowed_tools : length(trimspace(tool)) > 0])
    error_message = "Every allowed_tools entry must contain at least one non-whitespace character."
  }
}

variable "max_iterations" {
  description = "Maximum agent-loop iterations per invocation; null uses the AgentCore service default."
  type        = number
  default     = <%- maxIterations === undefined ? 'null' : maxIterations %>

  validation {
    condition     = var.max_iterations == null ? true : var.max_iterations > 0
    error_message = "max_iterations must be a positive number when set."
  }
}

variable "max_tokens" {
  description = "Maximum total output-token budget per invocation; null uses the AgentCore service default."
  type        = number
  default     = <%- maxTokens === undefined ? 'null' : maxTokens %>

  validation {
    condition     = var.max_tokens == null ? true : var.max_tokens > 0
    error_message = "max_tokens must be a positive number when set."
  }
}

variable "timeout_seconds" {
  description = "Maximum execution time per invocation; null uses the AgentCore service default."
  type        = number
  default     = <%- timeoutSeconds === undefined ? 'null' : timeoutSeconds %>

  validation {
    condition     = var.timeout_seconds == null ? true : var.timeout_seconds > 0
    error_message = "timeout_seconds must be a positive number when set."
  }
}

variable "model_resource_arns" {
  description = "Bedrock model and inference-profile ARNs the execution role may invoke. Defaults to every foundation model plus this account's Bedrock resources in the deployment region; replace with narrower ARNs to restrict baseline model access."
  type        = set(string)
  default     = null
}

variable "additional_execution_role_policy_statements" {
  description = "Additional least-privilege IAM policy statements required by configured optional capabilities (e.g. customer-owned Gateways, memory, custom browsers or code interpreters, skills, secrets). Sid and Condition are optional; null fields are omitted from the rendered policy."
  type = list(object({
    Sid       = optional(string)
    Effect    = string
    Action    = list(string)
    Resource  = list(string)
    Condition = optional(any)
  }))
  default = []
}

data "aws_caller_identity" "current" {}
data "aws_partition" "current" {}
data "aws_region" "current" {}

resource "random_id" "unique_suffix" {
  byte_length = 4
}

locals {
  account_id = data.aws_caller_identity.current.account_id
  partition  = data.aws_partition.current.partition
  region     = data.aws_region.current.region

  # Deployed Harness names must start with an ASCII letter, contain only
  # ASCII letters, digits or underscores, and be at most 40 characters long.
  # The class name can start with "_" when the project name starts with a
  # digit, so an "H" is prepended when needed; the prefix is then truncated
  # to 31 characters so the "_" separator plus the eight-hex random suffix
  # keeps the deployed name within 40 characters. The execution role and
  # policy names below reuse the same truncated prefix so they also stay
  # within their IAM limits (64 and 128 characters) for long project names.
  harness_name_prefix = substr(length(regexall("^[A-Za-z]", "<%- nameClassName %>")) > 0 ? "<%- nameClassName %>" : "H<%- nameClassName %>", 0, 31)
  harness_name        = "${local.harness_name_prefix}_${random_id.unique_suffix.hex}"

  # Default model access spans every foundation model plus this account's
  # Bedrock resources (e.g. inference profiles) in the deployment region;
  # set var.model_resource_arns to narrow it.
  model_resource_arns = var.model_resource_arns != null ? var.model_resource_arns : [
    "arn:${local.partition}:bedrock:*::foundation-model/*",
    "arn:${local.partition}:bedrock:${local.region}:${local.account_id}:*",
  ]
}

resource "aws_iam_role" "execution_role" {
  # Truncated prefix + 13-character literal + 8-hex suffix is at most 52
  # characters, within the 64-character IAM role name limit.
  name = "${local.harness_name_prefix}-HarnessRole-${random_id.unique_suffix.hex}"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = {
        Service = "bedrock-agentcore.amazonaws.com"
      }
      Action = "sts:AssumeRole"
      Condition = {
        StringEquals = {
          "aws:SourceAccount" = local.account_id
        }
        ArnLike = {
          "aws:SourceArn" = "arn:${local.partition}:bedrock-agentcore:${local.region}:${local.account_id}:*"
        }
      }
    }]
  })
}

# Baseline permissions from the AgentCore Harness security guidance:
# https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/harness-security.html
# Access to customer-owned resources (Gateways, memory, custom browsers or
# code interpreters, skills, secrets, VPCs) is an explicit extension via
# var.additional_execution_role_policy_statements.
resource "aws_iam_role_policy" "execution_role" {
  name = "${local.harness_name_prefix}-HarnessPolicy"
  role = aws_iam_role.execution_role.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = concat([
      {
        Sid    = "BedrockModelInvocation"
        Effect = "Allow"
        Action = [
          "bedrock:InvokeModel",
          "bedrock:InvokeModelWithResponseStream",
        ]
        Resource = local.model_resource_arns
      },
      {
        Sid      = "EcrPublicTokenAccess"
        Effect   = "Allow"
        Action   = ["ecr-public:GetAuthorizationToken"]
        Resource = ["*"]
      },
      {
        Sid      = "StsForEcrPublicPull"
        Effect   = "Allow"
        Action   = ["sts:GetServiceBearerToken"]
        Resource = ["*"]
      },
      {
        Sid    = "XRayTracingAccess"
        Effect = "Allow"
        Action = [
          "xray:PutTraceSegments",
          "xray:PutTelemetryRecords",
          "xray:GetSamplingRules",
          "xray:GetSamplingTargets",
        ]
        Resource = ["*"]
      },
      {
        Sid    = "CloudWatchLogsGroup"
        Effect = "Allow"
        Action = [
          "logs:CreateLogGroup",
          "logs:DescribeLogStreams",
        ]
        Resource = [
          "arn:${local.partition}:logs:${local.region}:${local.account_id}:log-group:/aws/bedrock-agentcore/runtimes/*",
        ]
      },
      {
        Sid      = "CloudWatchLogsDescribeGroups"
        Effect   = "Allow"
        Action   = ["logs:DescribeLogGroups"]
        Resource = ["arn:${local.partition}:logs:${local.region}:${local.account_id}:log-group:*"]
      },
      {
        Sid    = "CloudWatchLogsStream"
        Effect = "Allow"
        Action = [
          "logs:CreateLogStream",
          "logs:PutLogEvents",
        ]
        Resource = [
          "arn:${local.partition}:logs:${local.region}:${local.account_id}:log-group:/aws/bedrock-agentcore/runtimes/*:log-stream:*",
        ]
      },
      {
        Sid      = "CloudWatchMetricsPublish"
        Effect   = "Allow"
        Action   = ["cloudwatch:PutMetricData"]
        Resource = ["*"]
        Condition = {
          StringEquals = {
            "cloudwatch:namespace" = "bedrock-agentcore"
          }
        }
      },
      {
        Sid    = "AgentCoreWorkloadIdentity"
        Effect = "Allow"
        Action = [
          "bedrock-agentcore:GetWorkloadAccessToken",
          "bedrock-agentcore:GetWorkloadAccessTokenForJWT",
        ]
        Resource = [
          "arn:${local.partition}:bedrock-agentcore:${local.region}:${local.account_id}:workload-identity-directory/default",
          "arn:${local.partition}:bedrock-agentcore:${local.region}:${local.account_id}:workload-identity-directory/default/workload-identity/harness_${local.harness_name}-*",
        ]
      },
      # The Harness provisions a managed AgentCore Memory instance by default
      # and the agent loop reads and writes it on every invocation. The
      # service derives the managed memory name from a truncated harness name
      # plus a generated suffix, so this is scoped by name prefix within the
      # deployment account and Region. Narrow it to the exact memory ARN once
      # the deployment is known, or when attaching a BYO memory instance.
      {
        Sid    = "AgentCoreManagedMemory"
        Effect = "Allow"
        Action = [
          "bedrock-agentcore:CreateEvent",
          "bedrock-agentcore:DeleteEvent",
          "bedrock-agentcore:GetEvent",
          "bedrock-agentcore:ListEvents",
          "bedrock-agentcore:RetrieveMemoryRecords",
        ]
        Resource = [
          "arn:${local.partition}:bedrock-agentcore:${local.region}:${local.account_id}:memory/harness_*",
        ]
      },
      {
        Sid    = "AgentCoreBrowserDefault"
        Effect = "Allow"
        Action = [
          "bedrock-agentcore:StartBrowserSession",
          "bedrock-agentcore:StopBrowserSession",
          "bedrock-agentcore:GetBrowserSession",
          "bedrock-agentcore:ListBrowserSessions",
          "bedrock-agentcore:UpdateBrowserStream",
          "bedrock-agentcore:ConnectBrowserAutomationStream",
          "bedrock-agentcore:ConnectBrowserLiveViewStream",
        ]
        Resource = [
          "arn:${local.partition}:bedrock-agentcore:${local.region}:aws:browser/*",
        ]
      },
      {
        Sid    = "AgentCoreCodeInterpreterDefault"
        Effect = "Allow"
        Action = [
          "bedrock-agentcore:StartCodeInterpreterSession",
          "bedrock-agentcore:StopCodeInterpreterSession",
          "bedrock-agentcore:GetCodeInterpreterSession",
          "bedrock-agentcore:ListCodeInterpreterSessions",
          "bedrock-agentcore:InvokeCodeInterpreter",
        ]
        Resource = [
          "arn:${local.partition}:bedrock-agentcore:${local.region}:aws:code-interpreter/*",
        ]
      },
      ], [
      # Optional Sid/Condition fields are dropped when null so the rendered
      # policy JSON contains only the keys each statement actually sets.
      for statement in var.additional_execution_role_policy_statements :
      { for key, value in statement : key => value if value != null }
    ])
  })
}

# The AgentCore Harness. Omitting authorizer_configuration (the default)
# means the Harness uses IAM inbound authorization; add a
# custom_jwt_authorizer block in the extension region below to change that.
resource "aws_bedrockagentcore_harness" "this" {
  harness_name       = local.harness_name
  execution_role_arn = aws_iam_role.execution_role.arn

  # Generated defaults; module arguments override the variable defaults.
  model {
    bedrock_model_config {
      model_id = var.model_id
    }
  }

  system_prompt {
    text = var.system_prompt
  }

  allowed_tools   = var.allowed_tools
  max_iterations  = var.max_iterations
  max_tokens      = var.max_tokens
  timeout_seconds = var.timeout_seconds

  # ---------------------------------------------------------------------------
  # Advanced extension region (provider-native fields of AWS provider 6.54.0).
  #
  # This file is yours after generation (reruns keep existing files), so
  # configure advanced Harness features by adding or replacing provider-native
  # arguments and blocks directly here, for example:
  #
  #   - model: swap bedrock_model_config for gemini_model_config or
  #     openai_model_config, or tune its max_tokens / temperature / top_p
  #   - tool { ... } blocks: tool definitions (agentcore_browser,
  #     agentcore_code_interpreter, agentcore_gateway, inline_function or
  #     remote_mcp configurations)
  #   - memory { agentcore_memory_configuration { ... } }: managed memory
  #   - skill { path = "..." } blocks: skill sources
  #   - environment, environment_variables and environment_artifact: runtime
  #     environments, environment variables and container artifacts
  #   - truncation: conversation truncation strategy (sliding_window or
  #     summarization)
  #   - authorizer_configuration { custom_jwt_authorizer { ... } }: replaces
  #     the default IAM inbound authorization with JWT authorization
  #   - tags: resource tags
  #
  # Grant any newly configured capability least-privilege access through
  # var.additional_execution_role_policy_statements.
  # ---------------------------------------------------------------------------

  depends_on = [aws_iam_role_policy.execution_role]
}

module "add_harness_arn_to_runtime_config" {
  source = "../../../core/runtime-config/entry"

  namespace = "agentcore"
  key       = "harnesses"
  value     = { "<%- nameClassName %>" = aws_bedrockagentcore_harness.this.arn }
}

output "harness_id" {
  description = "ID of the Amazon Bedrock AgentCore Harness"
  value       = aws_bedrockagentcore_harness.this.harness_id
}

output "harness_arn" {
  description = "ARN of the Amazon Bedrock AgentCore Harness"
  value       = aws_bedrockagentcore_harness.this.arn
}

output "execution_role_arn" {
  description = "ARN of the IAM role assumed by the Harness"
  value       = aws_iam_role.execution_role.arn
}
