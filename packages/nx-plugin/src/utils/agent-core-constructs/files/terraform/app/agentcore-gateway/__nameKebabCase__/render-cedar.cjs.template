// Renders a Cedar policy template for the <%- nameClassName %> Terraform
// module, substituting `<%%= name %>` placeholders. Invoked by the `external`
// data source with JSON on stdin:
//   { "template": "<path>", "gatewayArn": "...", "accountId": "..." }
const fs = require('fs');

const PLACEHOLDER = /<%%[-=]?\s*([A-Za-z_$][\w$]*)\s*%>/g;

const render = (source, variables) =>
  source.replace(PLACEHOLDER, (_match, name) => {
    if (!Object.hasOwn(variables, name)) {
      throw new Error(
        `Cedar policy references '${name}', which is not one of the available variables: ${Object.keys(variables).join(', ')}`,
      );
    }
    return String(variables[name]);
  });

let input = '';
process.stdin.on('data', (chunk) => {
  input += chunk;
});
process.stdin.on('end', () => {
  try {
    const { template, ...variables } = JSON.parse(input);
    process.stdout.write(
      JSON.stringify({
        rendered: render(fs.readFileSync(template, 'utf-8'), variables),
      }),
    );
  } catch (e) {
    process.stderr.write(`${e instanceof Error ? e.message : String(e)}\n`);
    process.exitCode = 1;
  }
});
