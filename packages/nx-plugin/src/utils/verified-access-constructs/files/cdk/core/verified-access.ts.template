import { Aspects, Duration, Fn, RemovalPolicy, Stack, Token } from 'aws-cdk-lib';
import {
  CfnBasePathMapping,
  CfnBasePathMappingV2,
  CfnRestApi,
  CfnDomainNameAccessAssociation,
  CfnDomainNameV2,
  CfnStage,
  RestApi,
} from 'aws-cdk-lib/aws-apigateway';
import {
  Certificate,
  CertificateValidation,
} from 'aws-cdk-lib/aws-certificatemanager';
import {
  CfnManagedLoginBranding,
  IUserPool,
  OAuthScope,
  UserPoolDomain,
} from 'aws-cdk-lib/aws-cognito';
import {
  CfnVerifiedAccessEndpoint,
  CfnVerifiedAccessGroup,
  CfnVerifiedAccessInstance,
  CfnVerifiedAccessTrustProvider,
  InterfaceVpcEndpoint,
  InterfaceVpcEndpointAwsService,
  IVpc,
  Peer,
  Port,
  SecurityGroup,
} from 'aws-cdk-lib/aws-ec2';
import {
  AnyPrincipal,
  Effect,
  PolicyDocument,
  PolicyStatement,
  ServicePrincipal,
} from 'aws-cdk-lib/aws-iam';
import { Key } from 'aws-cdk-lib/aws-kms';
import { LogGroup, RetentionDays } from 'aws-cdk-lib/aws-logs';
import { CnameRecord, IHostedZone } from 'aws-cdk-lib/aws-route53';
import {
  CfnLoggingConfiguration,
  CfnWebACL,
  CfnWebACLAssociation,
} from 'aws-cdk-lib/aws-wafv2';
import { Construct, IConstruct } from 'constructs';
import { RuntimeConfig } from './runtime-config<% if (esm) { %>.js<% } %>';

const TRUST_PROVIDER_REFERENCE = 'cognito';

/** Admits anyone whose email address the user pool has verified */
export const DEFAULT_VERIFIED_ACCESS_POLICY = `permit(principal, action, resource) when { context.${TRUST_PROVIDER_REFERENCE}.email_verified == true || context.${TRUST_PROVIDER_REFERENCE}.email_verified == "true" };`;

export interface VerifiedAccessProps {
  /**
   * The REST API the door leads to, such as a construct generated by
   * ts#smithy-api. The door makes it private to its execute-api endpoint.
   */
  readonly api: { readonly api: RestApi };
  /**
   * The VPC the private API is reached from, through its execute-api endpoint.
   * It needs a subnet in at least one Availability Zone the endpoint can use.
   */
  readonly vpc: IVpc;
  /**
   * An execute-api interface endpoint in `vpc` to reach the API through. The
   * door's security group is allowed to it on port 443.
   *
   * @default a new endpoint in `vpc`, reached from inside the VPC alone
   */
  readonly endpoint?: InterfaceVpcEndpoint;
  /** The user pool that signs users in at the door, through a client of its own */
  readonly identity: {
    readonly userPool: IUserPool;
    readonly userPoolDomain: UserPoolDomain;
    addCallbackUrl(url: string): void;
  };
  /** The hosted zone the door's domain is in */
  readonly hostedZone: IHostedZone;
  /** The door's host name within `hostedZone` */
  readonly recordName: string;
  /**
   * The DNS label put in front of the door endpoint's generated domain
   *
   * @default recordName
   */
  readonly endpointDomainPrefix?: string;
  /**
   * The path the API's stage is served under on the door's domain
   *
   * @default the API's stage name
   */
  readonly basePath?: string;
  /**
   * Who the door admits, as a Cedar policy over the trust provider's claims,
   * referenced as `context.cognito`
   *
   * @default DEFAULT_VERIFIED_ACCESS_POLICY
   */
  readonly policyDocument?: string;
  /**
   * @default RetentionDays.ONE_YEAR
   */
  readonly accessLogRetention?: RetentionDays;
  /**
   * @default RemovalPolicy.DESTROY
   */
  readonly removalPolicy?: RemovalPolicy;
}

/**
 * Adds an execute-api interface endpoint to `vpc`, with no private DNS, so the
 * VPC's other calls to API Gateway are unchanged. It admits nothing until the
 * door allows its own security group in, so nothing else in the VPC can reach
 * the API without passing the door's sign-in.
 */
const addExecuteApiEndpoint = (
  scope: Construct,
  id: string,
  vpc: IVpc,
): InterfaceVpcEndpoint => {
  const securityGroup = new SecurityGroup(scope, `${id}SecurityGroup`, {
    vpc,
    description: 'execute-api endpoint, reached through the Verified Access door alone',
    allowAllOutbound: false,
  });
  return new InterfaceVpcEndpoint(scope, id, {
    vpc,
    service: InterfaceVpcEndpointAwsService.APIGATEWAY,
    privateDnsEnabled: false,
    securityGroups: [securityGroup],
    // CDK would otherwise admit the whole VPC
    open: false,
  });
};

const customDomainError = (api: RestApi) =>
  new Error(
    `${api.node.path} has a custom domain name, so a Verified Access door cannot make it private. A private API can be mapped only to a private custom domain name, and the door creates that domain itself, on its own host name. Remove the API's domain name and base path mappings, and reach the API through the door's domain instead.`,
  );

/**
 * Makes `api` private to `endpoint`: reachable only through it, whatever else
 * the API's resource policy allows. It allows nothing itself.
 */
const makePrivate = (api: RestApi, endpoint: InterfaceVpcEndpoint) => {
  if (api.domainName) {
    throw customDomainError(api);
  }
  const cfnApi = api.node.defaultChild as CfnRestApi;
  const types = (cfnApi.endpointConfiguration as
    | CfnRestApi.EndpointConfigurationProperty
    | undefined)?.types;
  if (Token.isUnresolved(cfnApi.endpointConfiguration) || (types && Token.isUnresolved(types))) {
    throw new Error(
      `${api.node.path} sets its endpoint configuration with a token, so a Verified Access door cannot make it private`,
    );
  }
  cfnApi.endpointConfiguration = {
    types: ['PRIVATE'],
    vpcEndpointIds: [endpoint.vpcEndpointId],
  };
  // Only a deny: what the API's policy allows, through the endpoint, stays as
  // it is, and an IAM operation still needs the caller's own IAM policy
  const fromEndpoint = { 'aws:SourceVpce': endpoint.vpcEndpointId };
  api.addToResourcePolicy(
    new PolicyStatement({
      effect: Effect.DENY,
      principals: [new AnyPrincipal()],
      actions: ['execute-api:Invoke'],
      resources: ['execute-api:/*'],
      conditions: { StringNotEquals: fromEndpoint },
    }),
  );
  // A resource policy takes effect in a new deployment, and the deployment's
  // logical ID does not otherwise cover it. Added at synth, after every route,
  // so the ID does not depend on the order constructs were declared in.
  let applied = false;
  Aspects.of(api).add({
    visit: (node: IConstruct) => {
      if (node === api && !applied) {
        applied = true;
        // A public custom domain mapped after the door is found here
        if (
          Stack.of(api)
            .node.findAll()
            .some(
              (c) =>
                c instanceof CfnBasePathMapping && c.restApiId === api.restApiId,
            )
        ) {
          throw customDomainError(api);
        }
        api.latestDeployment?.addToLogicalId({
          privateTo: endpoint.vpcEndpointId,
        });
      }
    },
  });
};

/**
 * An AWS Verified Access door in front of a private REST API. It signs users
 * in with the user pool and applies its Cedar policy before any request
 * reaches the API, which still checks its own authorization.
 *
 * The door's domain serves the API's stage on a private custom domain, reached
 * through an execute-api endpoint in the VPC. The runtime configuration points
 * the API's clients at the door, and sign-in may return there.
 */
export class VerifiedAccess extends Construct {
  /** The VPC the private API is reached from */
  public readonly vpc: IVpc;
  /** The execute-api endpoint the private API is reached through */
  public readonly executeApiEndpoint: InterfaceVpcEndpoint;
  /** The key the door's and its Web ACL's logs are encrypted with */
  public readonly logsKey: Key;
  /** The door's domain name */
  public readonly domainName: string;
  /** The API's URL through the door */
  public readonly url: string;
  public readonly certificate: Certificate;
  public readonly instance: CfnVerifiedAccessInstance;
  public readonly endpoint: CfnVerifiedAccessEndpoint;

  constructor(scope: Construct, id: string, props: VerifiedAccessProps) {
    super(scope, id);

    const { hostedZone, recordName } = props;
    const { api } = props.api;
    const removalPolicy = props.removalPolicy ?? RemovalPolicy.DESTROY;
    this.vpc = props.vpc;
    this.executeApiEndpoint =
      props.endpoint ??
      addExecuteApiEndpoint(this, 'ExecuteApiEndpoint', props.vpc);
    const endpoint = this.executeApiEndpoint;
    makePrivate(api, endpoint);
    const stack = Stack.of(this);
    this.logsKey = new Key(this, 'LogsKey', {
      enableKeyRotation: true,
      removalPolicy,
    });
    this.logsKey.addToResourcePolicy(
      new PolicyStatement({
        effect: Effect.ALLOW,
        principals: [
          new ServicePrincipal(`logs.${stack.region}.amazonaws.com`),
        ],
        actions: [
          'kms:Encrypt',
          'kms:Decrypt',
          'kms:ReEncrypt*',
          'kms:GenerateDataKey*',
          'kms:DescribeKey',
        ],
        resources: ['*'],
        conditions: {
          ArnLike: {
            'kms:EncryptionContext:aws:logs:arn': `arn:aws:logs:${stack.region}:${stack.account}:log-group:*`,
          },
        },
      }),
    );
    const stageName =
      (api.deploymentStage.node.defaultChild as CfnStage).stageName ?? 'prod';
    const basePath = props.basePath ?? stageName;

    this.domainName = `${recordName}.${hostedZone.zoneName}`;
    this.url = `https://${this.domainName}/${basePath}/`;
    this.certificate = new Certificate(this, 'Certificate', {
      domainName: this.domainName,
      validation: CertificateValidation.fromDns(hostedZone),
    });

    // The door signs users in with a confidential client of its own
    const { userPool, userPoolDomain } = props.identity;
    const client = userPool.addClient('DoorClient', {
      generateSecret: true,
      oAuth: {
        flows: { authorizationCodeGrant: true },
        scopes: [OAuthScope.OPENID, OAuthScope.EMAIL],
        callbackUrls: [`https://${this.domainName}/oauth2/idpresponse`],
      },
      preventUserExistenceErrors: true,
    });
    new CfnManagedLoginBranding(this, 'ManagedLoginBranding', {
      userPoolId: userPool.userPoolId,
      clientId: client.userPoolClientId,
      useCognitoProvidedValues: true,
    }).node.addDependency(client, userPoolDomain);

    const hostedUi = `https://${userPoolDomain.domainName}.auth.${stack.region}.amazoncognito.com`;
    const trustProvider = new CfnVerifiedAccessTrustProvider(
      this,
      'TrustProvider',
      {
        trustProviderType: 'user',
        userTrustProviderType: 'oidc',
        policyReferenceName: TRUST_PROVIDER_REFERENCE,
        oidcOptions: {
          issuer: `https://cognito-idp.${stack.region}.amazonaws.com/${userPool.userPoolId}`,
          authorizationEndpoint: `${hostedUi}/oauth2/authorize`,
          tokenEndpoint: `${hostedUi}/oauth2/token`,
          userInfoEndpoint: `${hostedUi}/oauth2/userInfo`,
          clientId: client.userPoolClientId,
          clientSecret: client.userPoolClientSecret.unsafeUnwrap(),
          scope: 'openid email',
        },
      },
    );

    const accessLogs = new LogGroup(this, 'AccessLogs', {
      retention: props.accessLogRetention ?? RetentionDays.ONE_YEAR,
      encryptionKey: this.logsKey,
      removalPolicy,
    });
    this.instance = new CfnVerifiedAccessInstance(this, 'Instance', {
      verifiedAccessTrustProviderIds: [
        trustProvider.attrVerifiedAccessTrustProviderId,
      ],
      loggingConfigurations: {
        cloudWatchLogs: { enabled: true, logGroup: accessLogs.logGroupName },
        includeTrustContext: true,
      },
    });
    this.addWebAcl(
      id,
      stack.formatArn({
        service: 'ec2',
        resource: 'verified-access-instance',
        resourceName: this.instance.attrVerifiedAccessInstanceId,
      }),
      removalPolicy,
    );

    const group = new CfnVerifiedAccessGroup(this, 'Group', {
      verifiedAccessInstanceId: this.instance.attrVerifiedAccessInstanceId,
      policyEnabled: true,
      policyDocument: props.policyDocument ?? DEFAULT_VERIFIED_ACCESS_POLICY,
    });

    const securityGroup = new SecurityGroup(this, 'SecurityGroup', {
      vpc: this.vpc,
      description: `Verified Access for ${this.domainName}, out to the execute-api endpoint`,
      allowAllOutbound: false,
    });
    securityGroup.addEgressRule(
      Peer.ipv4(this.vpc.vpcCidrBlock),
      Port.tcp(443),
      'HTTPS to the execute-api endpoint',
    );
    // A given endpoint's own security group may admit only some of the VPC
    endpoint.connections.allowFrom(
      securityGroup,
      Port.tcp(443),
      'HTTPS from the Verified Access door',
    );

    this.endpoint = new CfnVerifiedAccessEndpoint(this, 'Endpoint', {
      verifiedAccessGroupId: group.attrVerifiedAccessGroupId,
      endpointType: 'network-interface',
      attachmentType: 'vpc',
      applicationDomain: this.domainName,
      domainCertificateArn: this.certificate.certificateArn,
      // Required by EC2, though CloudFormation lists it as optional
      endpointDomainPrefix: props.endpointDomainPrefix ?? recordName,
      securityGroupIds: [securityGroup.securityGroupId],
      networkInterfaceOptions: {
        networkInterfaceId: Fn.select(
          0,
          endpoint.vpcEndpointNetworkInterfaceIds,
        ),
        port: 443,
        protocol: 'https',
      },
    });

    new CnameRecord(this, 'Record', {
      zone: hostedZone,
      recordName,
      domainName: this.endpoint.attrEndpointDomain,
      ttl: Duration.minutes(1),
    });

    // The door's domain, as a private custom domain of the API, reached
    // through the endpoint alone
    const privateDomain = new CfnDomainNameV2(this, 'PrivateDomain', {
      domainName: this.domainName,
      certificateArn: this.certificate.certificateArn,
      endpointConfiguration: { types: ['PRIVATE'] },
      securityPolicy: 'TLS_1_2',
      policy: new PolicyDocument({
        statements: [
          new PolicyStatement({
            effect: Effect.ALLOW,
            principals: [new AnyPrincipal()],
            actions: ['execute-api:Invoke'],
            resources: ['execute-api:/*'],
            conditions: {
              StringEquals: { 'aws:SourceVpce': endpoint.vpcEndpointId },
            },
          }),
        ],
      }).toJSON(),
    });
    new CfnBasePathMappingV2(this, 'PrivateDomainMapping', {
      domainNameArn: privateDomain.attrDomainNameArn,
      restApiId: api.restApiId,
      basePath,
      stage: api.deploymentStage.stageName,
    });
    new CfnDomainNameAccessAssociation(this, 'PrivateDomainAccess', {
      domainNameArn: privateDomain.attrDomainNameArn,
      accessAssociationSource: endpoint.vpcEndpointId,
      accessAssociationSourceType: 'VPCE',
    });

    // Clients call the API through the door, and sign-in may return there
    const rc = RuntimeConfig.ensure(this);
    const { apis = {} } = rc.get('connection');
    rc.set(
      'connection',
      'apis',
      Object.fromEntries(
        Object.entries(apis).map(([name, url]) => [
          name,
          url === api.url ? this.url : url,
        ]),
      ),
    );
    props.identity.addCallbackUrl(this.url);
  }

  private addWebAcl(
    id: string,
    resourceArn: string,
    removalPolicy: RemovalPolicy,
  ) {
    const webAcl = new CfnWebACL(this, 'WebAcl', {
      defaultAction: { allow: {} },
      scope: 'REGIONAL',
      visibilityConfig: {
        cloudWatchMetricsEnabled: true,
        metricName: `${id}WebAcl`,
        sampledRequestsEnabled: true,
      },
      rules: [
        {
          name: 'CRSRule',
          priority: 0,
          statement: {
            managedRuleGroupStatement: {
              name: 'AWSManagedRulesCommonRuleSet',
              vendorName: 'AWS',
            },
          },
          visibilityConfig: {
            cloudWatchMetricsEnabled: true,
            metricName: `${id}WebAcl-CRS`,
            sampledRequestsEnabled: true,
          },
          overrideAction: { none: {} },
        },
        {
          name: 'KnownBadInputsRule',
          priority: 1,
          statement: {
            managedRuleGroupStatement: {
              name: 'AWSManagedRulesKnownBadInputsRuleSet',
              vendorName: 'AWS',
            },
          },
          visibilityConfig: {
            cloudWatchMetricsEnabled: true,
            metricName: `${id}WebAcl-KnownBadInputs`,
            sampledRequestsEnabled: true,
          },
          overrideAction: { none: {} },
        },
      ],
    });
    new CfnWebACLAssociation(this, 'WebAclAssociation', {
      resourceArn,
      webAclArn: webAcl.attrArn,
    });

    // WAF requires the log group's name to start with aws-waf-logs-
    const logs = new LogGroup(this, 'WebAclLogs', {
      logGroupName: `aws-waf-logs-${id}-${this.node.addr.slice(-8)}`,
      retention: RetentionDays.ONE_MONTH,
      encryptionKey: this.logsKey,
      removalPolicy,
    });
    new CfnLoggingConfiguration(this, 'WebAclLoggingConfig', {
      resourceArn: webAcl.attrArn,
      logDestinationConfigs: [logs.logGroupArn],
      redactedFields: ['authorization', 'cookie'].map((name) => ({
        singleHeader: { Name: name },
      })),
    });
  }
}
