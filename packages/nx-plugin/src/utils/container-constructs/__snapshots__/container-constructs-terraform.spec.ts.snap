        "appconfig:GetLatestConfiguration"
      ]
      Resource = ["\${var.appconfig_application_arn}/*"]
    }
  ], var.task_role_policy_statements)
}

module "ecs_service" {
  source = "../../../core/container/ecs-service"

  service_name                = "Orders"
  vpc_id                      = var.vpc_id
  subnet_ids                  = var.subnet_ids
  cluster_arn                 = var.cluster_arn
  image_uri                   = "\${null_resource.docker_publish.triggers.repository_url}:\${null_resource.docker_publish.triggers.image_tag}"
  image_repository_arn        = var.asset_ecr_repository_arn
  container_port              = 8080
  environment                 = local.environment
  secrets                     = var.secrets
  task_role_policy_statements = local.task_role_policy_statements
  ingress                     = "private"
  tags                        = var.tags
}

module "add_url_to_runtime_config" {
  source = "../../../core/runtime-config/entry"

  namespace = "connection"
  key       = "services"
  value     = { "Orders" = module.ecs_service.url }
}

output "cluster_arn" {
  description = "ARN of the cluster the service runs in."
  value       = module.ecs_service.cluster_arn
}

output "service_name" {
  description = "Name of the ECS service."
  value       = module.ecs_service.service_name
}

output "service_arn" {
  description = "ARN of the ECS service."
  value       = module.ecs_service.service_arn
}

output "task_role_arn" {
  description = "ARN of the role the container's code runs as."
  value       = module.ecs_service.task_role_arn
}

output "task_role_name" {
  description = "Name of the task role, for aws_iam_role_policy attachments from connections."
  value       = module.ecs_service.task_role_name
}

output "security_group_id" {
  description = "Security group of the tasks, for database and other ingress rules."
  value       = module.ecs_service.security_group_id
}

output "load_balancer_arn" {
  description = "ARN of the internal load balancer."
  value       = module.ecs_service.load_balancer_arn
}

output "load_balancer_dns_name" {
  description = "DNS name of the internal load balancer."
  value       = module.ecs_service.load_balancer_dns_name
}

output "api_id" {
  description = "Id of the HTTP API, or null unless ingress is http-api."
  value       = module.ecs_service.api_id
}

output "api_execution_arn" {
  description = "Execution ARN of the HTTP API, for execute-api:Invoke grants, or null unless ingress is http-api."
  value       = module.ecs_service.api_execution_arn
}

output "url" {
  description = "URL callers use: the HTTP API URL, or the internal load balancer URL for private."
  value       = module.ecs_service.url
}
"
`;

exports[`addContainerServiceTerraformModules > snapshots > should render the core module > ecs-service.tf 1`] = `
"# Reusable ECS service module: an AWS Fargate service in an existing VPC behind an internal load balancer.

terraform {
  required_version = ">= 1.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "6.72.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "3.9.1"
    }
  }
}

data "aws_region" "current" {}

data "aws_caller_identity" "current" {}

data "aws_partition" "current" {}

data "aws_vpc" "this" {
  count = local.private_lb ? 1 : 0

  id = var.vpc_id
}

resource "random_id" "suffix" {
  byte_length = 4
}

locals {
  name           = "\${var.service_name}-\${random_id.suffix.hex}"
  partition      = data.aws_partition.current.partition
  region         = data.aws_region.current.region
  account_id     = data.aws_caller_identity.current.account_id
  create_cluster = var.cluster_arn == null
  cluster_arn    = local.create_cluster ? aws_ecs_cluster.this[0].arn : var.cluster_arn
  cluster_name   = element(split("/", local.cluster_arn), 1)
  create_lb      = var.load_balancer
  create_api     = var.load_balancer && var.ingress == "http-api"
  private_lb     = var.load_balancer && var.ingress == "private"
  listener_port  = 80
  container_name = "app"

  log_group_name     = "/aws/ecs/\${local.name}"
  api_log_group_name = "/aws/apigateway/\${local.name}"

  ssm_secret_arns = distinct([
    for arn in values(var.secrets) : arn if can(regex("^arn:[^:]+:ssm:", arn))
  ])
  secretsmanager_secret_arns = distinct([
    for arn in values(var.secrets) : join(":", slice(split(":", arn), 0, min(7, length(split(":", arn)))))
    if !can(regex("^arn:[^:]+:ssm:", arn))
  ])

  route_keys = flatten([
    for method in ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD"] : ["\${method} /{proxy+}", "\${method} /"]
  ])
}

resource "aws_kms_key" "logs" {
  description             = "Encrypts the \${local.name} service log groups"
  deletion_window_in_days = 7
  enable_key_rotation     = true

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid    = "EnableIamUserPermissions"
        Effect = "Allow"
        Principal = {
          AWS = "arn:\${local.partition}:iam::\${local.account_id}:root"
        }
        Action   = "kms:*"
        Resource = "*"
      },
      {
        Sid    = "AllowCloudWatchLogs"
        Effect = "Allow"
        Principal = {
          Service = "logs.\${local.region}.amazonaws.com"
        }
        Action = [
          "kms:Encrypt",
          "kms:Decrypt",
          "kms:ReEncrypt*",
          "kms:GenerateDataKey*",
          "kms:DescribeKey"
        ]
        Resource = "*"
        Condition = {
          ArnLike = {
            "kms:EncryptionContext:aws:logs:arn" = [
              "arn:\${local.partition}:logs:\${local.region}:\${local.account_id}:log-group:\${local.log_group_name}",
              "arn:\${local.partition}:logs:\${local.region}:\${local.account_id}:log-group:\${local.api_log_group_name}"
            ]
          }
        }
      }
    ]
  })

  tags = var.tags
}

resource "aws_cloudwatch_log_group" "service" {
  name              = local.log_group_name
  retention_in_days = var.log_retention_days
  kms_key_id        = aws_kms_key.logs.arn

  tags = var.tags
}

resource "aws_cloudwatch_log_group" "api" {
  count = local.create_api ? 1 : 0

  name              = local.api_log_group_name
  retention_in_days = var.log_retention_days
  kms_key_id        = aws_kms_key.logs.arn

  tags = var.tags
}

resource "aws_ecs_cluster" "this" {
  count = local.create_cluster ? 1 : 0

  name = local.name

  setting {
    name  = "containerInsights"
    value = "enabled"
  }

  tags = var.tags
}

resource "aws_iam_role" "execution" {
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect = "Allow"
        Principal = {
          Service = "ecs-tasks.amazonaws.com"
        }
        Action = "sts:AssumeRole"
        Condition = {
          StringEquals = {
            "aws:SourceAccount" = local.account_id
          }
          ArnLike = {
            "aws:SourceArn" = "arn:\${local.partition}:ecs:\${local.region}:\${local.account_id}:*"
          }
        }
      }
    ]
  })

  tags = var.tags
}

resource "aws_iam_role_policy" "execution" {
  name = "ExecutionPolicy"
  role = aws_iam_role.execution.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = concat(
      [
        {
          Sid      = "ServiceLogs"
          Effect   = "Allow"
          Action   = ["logs:CreateLogStream", "logs:PutLogEvents"]
          Resource = ["\${aws_cloudwatch_log_group.service.arn}:*"]
        },
      ],
      var.image_repository_arn == null ? [] : [
        {
          Sid    = "EcrImagePull"
          Effect = "Allow"
          Action = [
            "ecr:BatchGetImage",
            "ecr:GetDownloadUrlForLayer",
            "ecr:BatchCheckLayerAvailability",
          ]
          Resource = [var.image_repository_arn]
        },
        {
          #checkov:skip=CKV_AWS_355:EcrImageToken requires a wildcard resource; ecr:GetAuthorizationToken has no resource-level permission
          Sid      = "EcrImageToken"
          Effect   = "Allow"
          Action   = ["ecr:GetAuthorizationToken"]
          Resource = ["*"]
        },
      ],
      length(local.ssm_secret_arns) == 0 ? [] : [
        {
          Sid      = "SsmSecrets"
          Effect   = "Allow"
          Action   = ["ssm:GetParameters"]
          Resource = local.ssm_secret_arns
        },
      ],
      length(local.secretsmanager_secret_arns) == 0 ? [] : [
        {
          Sid      = "SecretsManagerSecrets"
          Effect   = "Allow"
          Action   = ["secretsmanager:GetSecretValue"]
          Resource = local.secretsmanager_secret_arns
        },
      ],
    )
  })
}

resource "aws_iam_role" "task" {
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect = "Allow"
        Principal = {
          Service = "ecs-tasks.amazonaws.com"
        }
        Action = "sts:AssumeRole"
        Condition = {
          StringEquals = {
            "aws:SourceAccount" = local.account_id
          }
          ArnLike = {
            "aws:SourceArn" = "arn:\${local.partition}:ecs:\${local.region}:\${local.account_id}:*"
          }
        }
      }
    ]
  })

  tags = var.tags
}

resource "aws_iam_role_policy" "task" {
  count = length(var.task_role_policy_statements) > 0 ? 1 : 0

  name = "TaskPolicy"
  role = aws_iam_role.task.id

  policy = jsonencode({
    Version   = "2012-10-17"
    Statement = var.task_role_policy_statements
  })
}

resource "aws_ecs_task_definition" "this" {
  family                   = local.name
  requires_compatibilities = ["FARGATE"]
  network_mode             = "awsvpc"
  cpu                      = var.cpu
  memory                   = var.memory
  execution_role_arn       = aws_iam_role.execution.arn
  task_role_arn            = aws_iam_role.task.arn

  runtime_platform {
    cpu_architecture        = "ARM64"
    operating_system_family = "LINUX"
  }

  volume {
    name = "tmp"
  }

  container_definitions = jsonencode([
    {
      name                   = local.container_name
      image                  = var.image_uri
      essential              = true
      readonlyRootFilesystem = true
      user                   = var.container_user
      portMappings = [
        {
          containerPort = var.container_port
          protocol      = "tcp"
        }
      ]
      environment = [
        for key, value in merge(var.environment, { PORT = tostring(var.container_port) }) : {
          name  = key
          value = value
        }
      ]
      secrets = [
        for key, value in var.secrets : {
          name      = key
          valueFrom = value
        }
      ]
      mountPoints = [
        {
          sourceVolume  = "tmp"
          containerPath = "/tmp"
          readOnly      = false
        }
      ]
      logConfiguration = {
        logDriver = "awslogs"
        options = {
          "awslogs-group"         = aws_cloudwatch_log_group.service.name
          "awslogs-region"        = local.region
          "awslogs-stream-prefix" = "service"
        }
      }
    }
  ])

  tags = var.tags
}

resource "aws_security_group" "service" {
  name_prefix = "\${substr(local.name, 0, 40)}-service-"
  description = "Tasks of the \${local.name} service"
  vpc_id      = var.vpc_id

  tags = merge(var.tags, {
    Name = "\${local.name}-service"
  })
}

resource "aws_vpc_security_group_egress_rule" "service_https" {
  security_group_id = aws_security_group.service.id
  cidr_ipv4         = "0.0.0.0/0"
  from_port         = 443
  to_port           = 443
  ip_protocol       = "tcp"
  description       = "Allow outbound HTTPS to AWS service endpoints"
}

resource "aws_vpc_security_group_ingress_rule" "service_from_alb" {
  count = local.create_lb ? 1 : 0

  security_group_id            = aws_security_group.service.id
  referenced_security_group_id = aws_security_group.alb[0].id
  from_port                    = var.container_port
  to_port                      = var.container_port
  ip_protocol                  = "tcp"
  description                  = "Allow the load balancer to reach the container port"
}

resource "aws_security_group" "alb" {
  #checkov:skip=CKV2_AWS_5:Attached to aws_lb.this via security_groups; Checkov cannot resolve this reference
  count = local.create_lb ? 1 : 0

  name_prefix = "\${substr(local.name, 0, 40)}-alb-"
  description = "Internal load balancer of the \${local.name} service"
  vpc_id      = var.vpc_id

  tags = merge(var.tags, {
    Name = "\${local.name}-alb"
  })
}

resource "aws_vpc_security_group_ingress_rule" "alb_from_vpc_link" {
  count = local.create_api ? 1 : 0

  security_group_id            = aws_security_group.alb[0].id
  referenced_security_group_id = aws_security_group.vpc_link[0].id
  from_port                    = local.listener_port
  to_port                      = local.listener_port
  ip_protocol                  = "tcp"
  description                  = "Allow the HTTP API VPC link to reach the listener"
}

resource "aws_vpc_security_group_ingress_rule" "alb_from_vpc" {
  count = local.private_lb ? 1 : 0

  security_group_id = aws_security_group.alb[0].id
  cidr_ipv4         = data.aws_vpc.this[0].cidr_block
  from_port         = local.listener_port
  to_port           = local.listener_port
  ip_protocol       = "tcp"
  description       = "Allow callers inside the VPC to reach the listener"
}

resource "aws_vpc_security_group_egress_rule" "alb_to_service" {
  count = local.create_lb ? 1 : 0

  security_group_id            = aws_security_group.alb[0].id
  referenced_security_group_id = aws_security_group.service.id
  from_port                    = var.container_port
  to_port                      = var.container_port
  ip_protocol                  = "tcp"
  description                  = "Allow the load balancer to reach the tasks"
}

resource "aws_security_group" "vpc_link" {
  #checkov:skip=CKV2_AWS_5:Attached to aws_apigatewayv2_vpc_link.this via security_group_ids; Checkov cannot resolve this reference
  count = local.create_api ? 1 : 0

  name_prefix = "\${substr(local.name, 0, 40)}-vpc-link-"
  description = "HTTP API VPC link of the \${local.name} service"
  vpc_id      = var.vpc_id

  tags = merge(var.tags, {
    Name = "\${local.name}-vpc-link"
  })
}

resource "aws_vpc_security_group_egress_rule" "vpc_link_to_alb" {
  count = local.create_api ? 1 : 0

  security_group_id            = aws_security_group.vpc_link[0].id
  referenced_security_group_id = aws_security_group.alb[0].id
  from_port                    = local.listener_port
  to_port                      = local.listener_port
  ip_protocol                  = "tcp"
  description                  = "Allow the VPC link to reach the load balancer listener"
}

resource "aws_lb" "this" {
  #checkov:skip=CKV2_AWS_20:Internal ALB reachable only from the VPC link security group or the VPC CIDR; TLS terminates at API Gateway and no certificate is vended
  #checkov:skip=CKV_AWS_91:Requests are logged in the HTTP API access log; ALB access logs need an S3 bucket with an ELB delivery policy, which is not vended
  #checkov:skip=CKV_AWS_150:Deletion protection off so the service can be destroyed with the stack, as the shared asset ECR repository uses force_delete
  count = local.create_lb ? 1 : 0

  internal                   = true
  load_balancer_type         = "application"
  subnets                    = var.subnet_ids
  security_groups            = [aws_security_group.alb[0].id]
  drop_invalid_header_fields = true
  desync_mitigation_mode     = "defensive"
  enable_deletion_protection = false

  tags = merge(var.tags, {
    Name = local.name
  })
}

resource "aws_lb_target_group" "this" {
  #checkov:skip=CKV_AWS_378:Internal ALB reachable only from the VPC link security group or the VPC CIDR; TLS terminates at API Gateway and no certificate is vended
  count = local.create_lb ? 1 : 0

  port                 = var.container_port
  protocol             = "HTTP"
  target_type          = "ip"
  vpc_id               = var.vpc_id
  deregistration_delay = var.deregistration_delay

  health_check {
    path    = var.health_check_path
    matcher = "200"
  }

  tags = merge(var.tags, {
    Name = local.name
  })
}

resource "aws_lb_listener" "this" {
  #checkov:skip=CKV_AWS_2:Internal ALB reachable only from the VPC link security group or the VPC CIDR; TLS terminates at API Gateway and no certificate is vended
  #checkov:skip=CKV_AWS_103:Internal ALB reachable only from the VPC link security group or the VPC CIDR; TLS terminates at API Gateway and no certificate is vended
  count = local.create_lb ? 1 : 0

  load_balancer_arn = aws_lb.this[0].arn
  port              = local.listener_port
  protocol          = "HTTP"

  default_action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.this[0].arn
  }

  tags = var.tags
}

resource "aws_ecs_service" "this" {
  name                              = local.name
  cluster                           = local.cluster_arn
  task_definition                   = aws_ecs_task_definition.this.arn
  launch_type                       = "FARGATE"
  platform_version                  = "LATEST"
  desired_count                     = var.desired_count
  enable_execute_command            = false
  propagate_tags                    = "SERVICE"
  health_check_grace_period_seconds = local.create_lb ? 60 : null

  deployment_circuit_breaker {
    enable   = true
    rollback = true
  }

  network_configuration {
    subnets          = var.subnet_ids
    security_groups  = [aws_security_group.service.id]
    assign_public_ip = false
  }

  dynamic "load_balancer" {
    for_each = local.create_lb ? [1] : []

    content {
      target_group_arn = aws_lb_target_group.this[0].arn
      container_name   = local.container_name
      container_port   = var.container_port
    }
  }

  lifecycle {
    ignore_changes = [desired_count]
  }

  tags = var.tags

  depends_on = [aws_lb_listener.this, aws_iam_role_policy.execution]
}

resource "aws_appautoscaling_target" "this" {
  service_namespace  = "ecs"
  scalable_dimension = "ecs:service:DesiredCount"
  resource_id        = "service/\${local.cluster_name}/\${aws_ecs_service.this.name}"
  min_capacity       = var.min_capacity
  max_capacity       = var.max_capacity

  tags = var.tags
}

resource "aws_appautoscaling_policy" "cpu" {
  name               = "\${local.name}-cpu"
  policy_type        = "TargetTrackingScaling"
  service_namespace  = aws_appautoscaling_target.this.service_namespace
  scalable_dimension = aws_appautoscaling_target.this.scalable_dimension
  resource_id        = aws_appautoscaling_target.this.resource_id

  target_tracking_scaling_policy_configuration {
    target_value = var.target_cpu_utilization

    predefined_metric_specification {
      predefined_metric_type = "ECSServiceAverageCPUUtilization"
    }
  }
}

resource "aws_apigatewayv2_vpc_link" "this" {
  count = local.create_api ? 1 : 0

  name               = local.name
  security_group_ids = [aws_security_group.vpc_link[0].id]
  subnet_ids         = var.subnet_ids

  tags = var.tags
}

resource "aws_apigatewayv2_api" "this" {
  count = local.create_api ? 1 : 0

  name          = local.name
  protocol_type = "HTTP"

  cors_configuration {
    allow_headers = ["authorization", "content-type", "x-amz-content-sha256", "x-amz-date", "x-amz-security-token"]
    allow_methods = ["*"]
    allow_origins = var.cors_allow_origins
    max_age       = 86400
  }

  tags = var.tags
}

resource "aws_apigatewayv2_integration" "this" {
  count = local.create_api ? 1 : 0

  api_id                 = aws_apigatewayv2_api.this[0].id
  integration_type       = "HTTP_PROXY"
  integration_method     = "ANY"
  integration_uri        = aws_lb_listener.this[0].arn
  connection_type        = "VPC_LINK"
  connection_id          = aws_apigatewayv2_vpc_link.this[0].id
  payload_format_version = "1.0"
  timeout_milliseconds   = 30000
}

resource "aws_apigatewayv2_authorizer" "cognito" {
  count = local.create_api && var.auth == "cognito" ? 1 : 0

  api_id           = aws_apigatewayv2_api.this[0].id
  authorizer_type  = "JWT"
  identity_sources = ["$request.header.Authorization"]
  name             = "\${local.name}-authorizer"

  jwt_configuration {
    audience = var.user_pool_client_ids
    issuer   = "https://cognito-idp.\${local.region}.amazonaws.com/\${var.user_pool_id}"
  }

  lifecycle {
    precondition {
      condition     = var.user_pool_id != null && length(var.user_pool_client_ids) > 0
      error_message = "user_pool_id and at least one user_pool_client_ids entry are required when auth is cognito."
    }
  }
}

resource "aws_apigatewayv2_route" "this" {
  for_each = local.create_api ? toset(local.route_keys) : toset([])

  api_id             = aws_apigatewayv2_api.this[0].id
  route_key          = each.key
  target             = "integrations/\${aws_apigatewayv2_integration.this[0].id}"
  authorization_type = var.auth == "iam" ? "AWS_IAM" : var.auth == "cognito" ? "JWT" : "NONE"
  authorizer_id      = one(aws_apigatewayv2_authorizer.cognito[*].id)
}

resource "aws_apigatewayv2_stage" "this" {
  count = local.create_api ? 1 : 0

  api_id      = aws_apigatewayv2_api.this[0].id
  name        = "$default"
  auto_deploy = true

  access_log_settings {
    destination_arn = aws_cloudwatch_log_group.api[0].arn
    format = jsonencode({
      requestId        = "$context.requestId"
      ip               = "$context.identity.sourceIp"
      requestTime      = "$context.requestTime"
      httpMethod       = "$context.httpMethod"
      routeKey         = "$context.routeKey"
      status           = "$context.status"
      protocol         = "$context.protocol"
      responseLength   = "$context.responseLength"
      error            = "$context.error.message"
      integrationError = "$context.integrationErrorMessage"
    })
  }

  default_route_settings {
    throttling_burst_limit = 5000
    throttling_rate_limit  = 10000
  }

  tags = var.tags
}
"
`;

exports[`addContainerServiceTerraformModules > snapshots > should render the core module > outputs.tf 1`] = `
"# Outputs of the reusable ECS service module. Names and descriptions are the
# contract other modules use.

output "cluster_arn" {
  description = "ARN of the cluster the service runs in."
  value       = local.cluster_arn
}

output "service_name" {
  description = "Name of the ECS service."
  value       = aws_ecs_service.this.name
}

output "service_arn" {
  description = "ARN of the ECS service."
  value       = aws_ecs_service.this.arn
}

output "task_role_arn" {
  description = "ARN of the role the container's code runs as."
  value       = aws_iam_role.task.arn
}

output "task_role_name" {
  description = "Name of the task role, for aws_iam_role_policy attachments from connections."
  value       = aws_iam_role.task.name
}

output "security_group_id" {
  description = "Security group of the tasks, for database and other ingress rules."
  value       = aws_security_group.service.id
}

output "load_balancer_arn" {
  description = "ARN of the internal load balancer, or null when load_balancer is false."
  value       = one(aws_lb.this[*].arn)
}

output "load_balancer_dns_name" {
  description = "DNS name of the internal load balancer, or null when load_balancer is false."
  value       = one(aws_lb.this[*].dns_name)
}

output "api_id" {
  description = "Id of the HTTP API, or null unless ingress is http-api."
  value       = one(aws_apigatewayv2_api.this[*].id)
}

output "api_execution_arn" {
  description = "Execution ARN of the HTTP API, for execute-api:Invoke grants, or null unless ingress is http-api."
  value       = one(aws_apigatewayv2_api.this[*].execution_arn)
}

output "url" {
  description = "URL callers use: the HTTP API URL, the internal load balancer URL for private, or null without a load balancer."
  value       = local.create_api ? aws_apigatewayv2_stage.this[0].invoke_url : local.create_lb ? "http://\${aws_lb.this[0].dns_name}/" : null
}
"
`;

exports[`addContainerServiceTerraformModules > snapshots > should render the core module > variables.tf 1`] = `
"# Inputs of the reusable ECS service module (AWS Fargate, linux/arm64) in an
# existing VPC. The module never creates a VPC.

variable "service_name" {
  description = "Name of the service. Its URL is written to runtime config as connection.services.<service_name> by the app module."
  type        = string
}

variable "vpc_id" {
  description = "VPC the service runs in."
  type        = string
}

variable "subnet_ids" {
  description = "Private subnets with egress for the tasks and the internal load balancer. Tasks never get a public IP."
  type        = list(string)
}

variable "cluster_arn" {
  description = "ARN of an existing ECS cluster, so several services can share one. Null creates a cluster with Container Insights on."
  type        = string
  default     = null
}

variable "image_uri" {
  description = "Image to run, pinned by digest. The app module passes the digest it published to the shared asset ECR repository; a prebuilt registry image can be passed instead, and nothing is built locally."
  type        = string
}

variable "container_port" {
  description = "Port the server listens on inside the container, passed as PORT."
  type        = number
  default     = 8080
}

variable "cpu" {
  description = "Task CPU units."
  type        = number
  default     = 256
}

variable "memory" {
  description = "Task memory in MiB."
  type        = number
  default     = 512
}

variable "desired_count" {
  description = "Number of tasks to start with."
  type        = number
  default     = 1
}

variable "min_capacity" {
  description = "Fewest tasks autoscaling keeps."
  type        = number
  default     = 1
}

variable "max_capacity" {
  description = "Most tasks autoscaling starts."
  type        = number
  default     = 2
}

variable "target_cpu_utilization" {
  description = "Average CPU utilisation, in percent, autoscaling keeps the service at."
  type        = number
  default     = 70
}

variable "environment" {
  description = "Plain environment variables. Never put secret values here; use secrets."
  type        = map(string)
  default     = {}
}

variable "secrets" {
  description = "Environment variables read from Secrets Manager or SSM Parameter Store, as a map of variable name to secret or parameter ARN. The execution role may read only these."
  type        = map(string)
  default     = {}
}

variable "load_balancer" {
  description = "Whether the service gets an internal Application Load Balancer. False gives a service with no load balancer and no URL (a worker)."
  type        = bool
  default     = true
}

variable "health_check_path" {
  description = "Path the target group health check calls."
  type        = string
  default     = "/health"
}

variable "deregistration_delay" {
  description = "Seconds the target group waits before it removes a draining task."
  type        = number
  default     = 30
}

variable "ingress" {
  description = "How callers reach the service: http-api (an API Gateway HTTP API reaches the internal load balancer through a VPC link; requests time out after 30 seconds) or private (the internal load balancer only, for callers inside the VPC). Only used with load_balancer = true."
  type        = string
  default     = "http-api"

  validation {
    condition     = contains(["http-api", "private"], var.ingress)
    error_message = "ingress must be http-api or private."
  }
}

variable "auth" {
  description = "How the HTTP API authenticates: iam, cognito or none. Only used with ingress = http-api."
  type        = string
  default     = "iam"

  validation {
    condition     = contains(["iam", "cognito", "none"], var.auth)
    error_message = "auth must be iam, cognito or none."
  }
}

variable "user_pool_id" {
  description = "Cognito user pool id for auth = cognito."
  type        = string
  default     = null
}

variable "user_pool_client_ids" {
  description = "Cognito user pool client ids accepted as JWT audiences for auth = cognito."
  type        = list(string)
  default     = []
}

variable "log_retention_days" {
  description = "Retention of the container log group, in days."
  type        = number
  default     = 365
}

variable "task_role_policy_statements" {
  description = "IAM policy statements added to the task role. The task role has no permissions otherwise; connections add theirs here."
  type        = list(any)
  default     = []
}

variable "tags" {
  description = "Tags to apply to all resources."
  type        = map(string)
  default     = {}
}

variable "image_repository_arn" {
  description = "ARN of the ECR repository image_uri is in. The execution role may pull only from it. Null for an image that needs no ECR pull permission."
  type        = string
  default     = null
}

variable "container_user" {
  description = "Non-root user, as uid or uid:gid, the container runs as."
  type        = string
  default     = "1000:1000"

  validation {
    condition     = !can(regex("^(0|root)(:.*)?$", var.container_user))
    error_message = "container_user must not be root."
  }
}

variable "cors_allow_origins" {
  description = "Origins the HTTP API allows in CORS requests. Only used with ingress = http-api."
  type        = list(string)
  default     = ["*"]
}
"
`;
