import {
  Annotations,
  Aspects,
  CfnOutput,
  CfnResource,
  Fn,
  IAspect,
  Lazy,
  Names,
  RemovalPolicy,
  Stack,
  Token,
} from 'aws-cdk-lib';
import {
  AuthorizationType,
  AwsIntegration,
  CfnBasePathMapping,
  CfnDomainName,
  CfnBasePathMappingV2,
  CfnDomainNameV2,
  CfnMethod,
  CfnRestApi,
  CfnStage,
  IntegrationResponse,
  Method,
  MethodResponse,
  Model,
  PassthroughBehavior,
  RestApi,
} from 'aws-cdk-lib/aws-apigateway';
import {
  AnyPrincipal,
  Effect,
  PolicyStatement,
  Role,
  ServicePrincipal,
} from 'aws-cdk-lib/aws-iam';
import { IKey, Key } from 'aws-cdk-lib/aws-kms';
import {
  CfnDelivery,
  CfnDeliveryDestination,
  CfnDeliverySource,
  LogGroup,
  RetentionDays,
} from 'aws-cdk-lib/aws-logs';
import {
  BlockPublicAccess,
  Bucket,
  BucketEncryption,
  IBucket,
  ObjectOwnership,
} from 'aws-cdk-lib/aws-s3';
import {
  BucketDeployment,
  CacheControl,
  Source,
} from 'aws-cdk-lib/aws-s3-deployment';
import { existsSync, readFileSync } from 'fs';
import { join } from 'path';
import { Construct, IConstruct } from 'constructs';
import { suppressRules } from './checkov<% if (esm) { %>.js<% } %>';
import { RuntimeConfig } from './runtime-config<% if (esm) { %>.js<% } %>';

const RUNTIME_CONFIG_FILENAME = 'runtime-config.json';
// Copies of index.html, one for each path the API is reached at
const PAGES_DIR = '_base';

// Content-Security-Policy enforced on all responses. Restricts scripts and
// framing to mitigate XSS and clickjacking, while permitting HTTPS/WSS calls
// (connect-src) to AWS service endpoints such as Cognito which are only known
// at deploy time. Edit this to tighten connect-src once they are known.
/** A key only the plugin's constructs set, which UserIdentity reads callback URLs under */
const SIGN_IN_CALLBACK_URLS: unique symbol = Symbol.for(
  '@aws/nx-plugin/sign-in-callback-urls',
);

export const CONTENT_SECURITY_POLICY = [
  "default-src 'self'",
  "script-src 'self'",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data:",
  "font-src 'self' data:",
  "connect-src 'self' https: wss:",
  "object-src 'none'",
  "base-uri 'self'",
  "frame-ancestors 'none'",
].join('; ');

/** Content types API Gateway passes through as binary rather than as text */
const BINARY_MEDIA_TYPES = [
  'image/*',
  'font/*',
  // Firefox asks for fonts by these first, and API Gateway decides on the first
  'application/font-woff2',
  'application/font-woff',
  'application/octet-stream',
  'binary/octet-stream',
  'application/wasm',
  'application/pdf',
];

// The shell and runtime config must always be fetched afresh. Assets are named
// by their content's hash, so they are cached for a year; privately, since they
// may sit behind sign-in.
const NO_STORE = 'no-store, no-cache';
const HASHED_ASSET_CACHE = 'private, max-age=31536000, immutable';

export interface ApiGatewayStaticWebsiteProps {
  readonly websiteName: string;
  readonly websiteFilePath: string;
  /**
   * The REST API whose routes serve the website, such as a construct generated by ts#smithy-api.
   */
  readonly api: { readonly api: RestApi };
  /**
   * The Content-Security-Policy sent with every response
   *
   * @default CONTENT_SECURITY_POLICY
   */
  readonly contentSecurityPolicy?: string;
  /**
   * The directory of the bundle holding the files named by their content's hash.
   *
   * @default 'assets'
   */
  readonly assetsDir?: string;
  /**
   * @default BucketEncryption.KMS
   */
  readonly encryption?: BucketEncryption;
  /**
   * The key used to encrypt the website bucket when using KMS encryption.
   * A new key is created when not provided.
   */
  readonly encryptionKey?: IKey;
  /**
   * @default true
   */
  readonly enableKeyRotation?: boolean;
}

/**
 * A static website served from a private S3 bucket through a REST API's own
 * routes, on the API's origin, so it needs no CloudFront distribution.
 *
 * Serves `index.html` at the API's root and for any path without a file
 * extension, every other file from the bundle, and the runtime configuration at
 * `runtime-config.json`. These routes need no authorization, while the API's
 * own operations keep theirs.
 *
 * The website is built with a relative base. A copy of `index.html` is deployed
 * for each path the API is reached at, its `<base href>` naming that path: the
 * stage on the execute-api URL, or the base path of a custom domain mapped to
 * the API. Each request is served the copy for the domain it came in on, so one
 * build serves from every URL of the API.
 */
export class ApiGatewayStaticWebsite extends Construct {
  public readonly websiteBucket: IBucket;
  public readonly bucketDeployment: BucketDeployment;
  /** The website's URL on the API's execute-api endpoint, under the stage's path */
  public readonly url: string;
  /**
   * Every URL the website is served at: the execute-api URL first, then each
   * custom domain that maps the API, under the mapping's base path, sorted by
   * domain name and base path
   */
  public readonly urls: string[];
  private readonly api: RestApi;

  constructor(
    scope: Construct,
    id: string,
    {
      websiteFilePath,
      websiteName,
      api: { api },
      assetsDir = 'assets',
      contentSecurityPolicy = CONTENT_SECURITY_POLICY,
      encryption = BucketEncryption.KMS,
      encryptionKey,
      enableKeyRotation = true,
    }: ApiGatewayStaticWebsiteProps,
  ) {
    super(scope, id);

    this.api = api;
    // Resolved at synth, so a domain mapped after the website is found too
    this.url = api.url;
    this.urls = Lazy.list({ produce: () => this.signInCallbackUrls });

    const websiteKey: IKey | undefined =
      encryption === BucketEncryption.KMS
        ? (encryptionKey ?? new Key(this, 'WebsiteKey', { enableKeyRotation }))
        : undefined;

    // Allow CloudWatch Logs to use the website key for server access log delivery.
    const stack = Stack.of(this);
    websiteKey?.addToResourcePolicy(
      new PolicyStatement({
        effect: Effect.ALLOW,
        principals: [
          new ServicePrincipal(`logs.${stack.region}.amazonaws.com`),
        ],
        actions: [
          'kms:Encrypt',
          'kms:Decrypt',
          'kms:ReEncrypt*',
          'kms:GenerateDataKey*',
          'kms:DescribeKey',
        ],
        resources: ['*'],
        conditions: {
          ArnLike: {
            'kms:EncryptionContext:aws:logs:arn': `arn:aws:logs:${stack.region}:${stack.account}:log-group:*`,
          },
        },
      }),
    );

    const accessLogs = new LogGroup(this, 'AccessLogs', {
      retention: RetentionDays.ONE_YEAR,
      encryptionKey: websiteKey,
      removalPolicy: RemovalPolicy.DESTROY,
    });

    this.websiteBucket = new Bucket(this, 'WebsiteBucket', {
      versioned: true,
      enforceSSL: true,
      autoDeleteObjects: true,
      removalPolicy: RemovalPolicy.DESTROY,
      encryption,
      encryptionKey: websiteKey,
      objectOwnership: ObjectOwnership.BUCKET_OWNER_ENFORCED,
      publicReadAccess: false,
      blockPublicAccess: BlockPublicAccess.BLOCK_ALL,
    });
    suppressRules(
      this.websiteBucket,
      ['CKV_AWS_18'],
      'Server access logs are delivered to CloudWatch Logs',
    );
    this.deliverAccessLogsToCloudWatch(this.websiteBucket, accessLogs);

    this.bucketDeployment = new BucketDeployment(this, 'WebsiteDeployment', {
      sources: [Source.asset(websiteFilePath)],
      destinationBucket: this.websiteBucket,
      // Exclude the runtime config and the page copies from this deployment's sync
      // so its default pruning never deletes the files deployed separately below.
      exclude: [RUNTIME_CONFIG_FILENAME, `${PAGES_DIR}/*`],
      memoryLimit: 1024,
    });

    new BucketDeployment(this, 'RuntimeConfigDeployment', {
      sources: [
        Source.data(
          RUNTIME_CONFIG_FILENAME,
          Lazy.string({
            produce: () =>
              Stack.of(this).toJsonString(
                RuntimeConfig.ensure(this).get('connection'),
              ),
          }),
        ),
      ],
      destinationBucket: this.websiteBucket,
      cacheControl: [CacheControl.noCache()],
      prune: false,
      memoryLimit: 1024,
    });

    suppressRules(
      stack,
      ['CKV_AWS_111'],
      'CDK Bucket Deployment uses wildcard to deploy arbitrary assets',
      (c) =>
        CfnResource.isCfnResource(c) &&
        c.cfnResourceType === 'AWS::IAM::Policy' &&
        c.node.path.includes(`/Custom::CDKBucketDeployment`),
    );

    const siteMethods = this.addRoutes(api, assetsDir, contentSecurityPolicy);

    // Files that are not text pass through as binary: images, fonts, and any
    // file S3 has no type for, which it serves as binary/octet-stream
    const cfnApi = api.node.defaultChild as CfnRestApi;
    cfnApi.binaryMediaTypes = [
      ...new Set([
        ...(cfnApi.binaryMediaTypes ?? []),
        ...BINARY_MEDIA_TYPES,
      ]),
    ];

    // At synth, once every domain that maps the API is known
    let pagesDeployed = false;
    Aspects.of(api).add({
      visit: (node: IConstruct) => {
        if (node === api && !pagesDeployed) {
          pagesDeployed = true;
          this.deployPages(api, websiteFilePath);
        }
      },
    });
    Aspects.of(api).add(new AllowWebsiteRoutesAspect(api, siteMethods));

    new CfnOutput(this, `${websiteName}WebsiteBucketName`, {
      value: this.websiteBucket.bucketName,
    });
    new CfnOutput(this, 'WebsiteUrl', { value: this.url });
    new CfnOutput(this, 'WebsiteUrls', {
      description: 'Every URL the website is served at, separated by spaces',
      value: Lazy.string({ produce: () => Fn.join(' ', this.signInCallbackUrls) }),
    });
  }

  /**
   * The URLs sign-in and sign-out return to, which the stack's UserIdentity
   * permits: every URL in `urls`, as the redirect names them, with no trailing
   * slash at a domain's root. Read at synth, once every domain that maps the
   * API is known.
   */
  /** The key UserIdentity reads a website's callback URLs under */
  public get [SIGN_IN_CALLBACK_URLS](): string[] {
    return this.signInCallbackUrls;
  }

  public get signInCallbackUrls(): string[] {
    const domainUrls = mappedDomains(this.api)
      .sort(
        (a, b) =>
          a.sortKey.localeCompare(b.sortKey) ||
          a.basePath.localeCompare(b.basePath),
      )
      .map(
        (d) => `https://${d.domainName}${d.basePath === '/' ? '' : d.basePath}`,
      );
    return [...new Set([this.api.url, ...domainUrls])];
  }

  /**
   * Deploys a copy of the bundle's index.html for each path the API is reached
   * at, with a `<base href>` naming it
   */
  private deployPages(api: RestApi, websiteFilePath: string) {
    const index = join(websiteFilePath, 'index.html');
    if (!existsSync(index)) {
      return;
    }
    const html = readFileSync(index, 'utf-8');
    const bases = [
      ...new Set([
        stageBasePath(api),
        ...mappedDomains(api).map((d) => d.basePath),
      ]),
    ];
    new BucketDeployment(this, 'PagesDeployment', {
      sources: bases.map((base) =>
        Source.data(
          `${PAGES_DIR}${base}index.html`,
          html.replace('<base href="./"', `<base href="${base}"`),
        ),
      ),
      destinationBucket: this.websiteBucket,
      cacheControl: [CacheControl.noCache()],
      prune: false,
      memoryLimit: 1024,
    });
  }

  private addRoutes(
    api: RestApi,
    assetsDir: string,
    contentSecurityPolicy: string,
  ): Method[] {
    const credentialsRole = new Role(this, 'S3IntegrationRole', {
      assumedBy: new ServicePrincipal('apigateway.amazonaws.com'),
    });
    // Read objects only: listing would let a missing file's 404 tell which exist
    credentialsRole.addToPolicy(
      new PolicyStatement({
        actions: ['s3:GetObject'],
        resources: [this.websiteBucket.arnForObjects('*')],
      }),
    );
    this.websiteBucket.encryptionKey?.grantDecrypt(credentialsRole);

    // Sets $page to the copy of index.html for the domain the request came in on
    const pageKey = Lazy.string({ produce: () => pageKeyTemplate(api) });
    const integrationResponses = (
      cacheControl: string,
    ): IntegrationResponse[] => [
      {
        statusCode: '200',
        responseParameters: {
          'method.response.header.Content-Type':
            'integration.response.header.Content-Type',
          'method.response.header.Content-Length':
            'integration.response.header.Content-Length',
          'method.response.header.Content-Security-Policy': `'${contentSecurityPolicy}'`,
          'method.response.header.Strict-Transport-Security':
            "'max-age=63072000; includeSubDomains; preload'",
          'method.response.header.X-Content-Type-Options': "'nosniff'",
          'method.response.header.X-Frame-Options': "'DENY'",
          'method.response.header.Referrer-Policy':
            "'strict-origin-when-cross-origin'",
          'method.response.header.Cache-Control': `'${cacheControl}'`,
        },
      },
      // S3 answers a missing object with 403, since the role cannot list the
      // bucket. One response, as API Gateway keeps one per status code.
      {
        statusCode: '404',
        selectionPattern: '40[34]',
        responseTemplates: {
          'application/json': JSON.stringify({ message: 'Not found' }),
        },
      },
    ];
    const methodResponses: MethodResponse[] = [
      {
        statusCode: '200',
        responseModels: { 'application/json': Model.EMPTY_MODEL },
        responseParameters: Object.fromEntries(
          [
            'Content-Type',
            'Content-Length',
            'Content-Security-Policy',
            'Strict-Transport-Security',
            'X-Content-Type-Options',
            'X-Frame-Options',
            'Referrer-Policy',
            'Cache-Control',
          ].map((header) => [`method.response.header.${header}`, true]),
        ),
      },
      { statusCode: '404' },
    ];

    const bucketName = this.websiteBucket.bucketName;
    const route = (
      resource: (typeof api)['root'],
      objectKey: string,
      cacheControl: string,
      { proxy = false, spaFallback = false, page = false } = {},
    ) => {
      const method = resource.addMethod(
        'GET',
        new AwsIntegration({
          service: 's3',
          integrationHttpMethod: 'GET',
          // A page is the copy of index.html for the request's domain
          path: `${bucketName}/${page && !spaFallback ? '{page}' : objectKey}`,
          options: {
            credentialsRole,
            requestParameters: {
              'integration.request.header.Accept': 'method.request.header.Accept',
              ...(proxy
                ? { 'integration.request.path.proxy': 'method.request.path.proxy' }
                : {}),
              ...(page && !spaFallback
                ? { 'integration.request.path.page': `'${objectKey}'` }
                : {}),
            },
            passthroughBehavior: PassthroughBehavior.WHEN_NO_TEMPLATES,
            ...(page
              ? {
                  requestTemplates: {
                    'application/json': spaFallback
                      ? // A path without a file extension is a route of the single page app
                        `${pageKey}
#if(!$input.params('proxy').contains('.') || $input.params('proxy') == 'index.html')
#set($context.requestOverride.path.proxy = $page)
#end`
                      : `${pageKey}
#set($context.requestOverride.path.page = $page)`,
                  },
                }
              : {}),
            integrationResponses: integrationResponses(cacheControl),
          },
        }),
        {
          authorizationType: AuthorizationType.NONE,
          requestParameters: {
            'method.request.header.Accept': false,
            ...(proxy ? { 'method.request.path.proxy': true } : {}),
          },
          methodResponses,
        },
      );
      // The API's default authorization scopes do not apply to these routes
      Annotations.of(method).acknowledgeWarning(
        '@aws-cdk/aws-apigateway:invalidAuthScope',
        'The website routes need no authorization',
      );
      suppressRules(
        method,
        ['CKV_AWS_59'],
        'The website is loaded before sign-in; the API operations keep their authorization',
      );
      return method;
    };

    return [
      route(api.root, 'index.html', NO_STORE, { page: true }),
      route(
        api.root.addResource(RUNTIME_CONFIG_FILENAME),
        RUNTIME_CONFIG_FILENAME,
        NO_STORE,
      ),
      route(api.root.addProxy({ anyMethod: false }), '{proxy}', NO_STORE, {
        proxy: true,
        spaFallback: true,
        page: true,
      }),
      route(
        api.root.addResource(assetsDir).addProxy({ anyMethod: false }),
        `${assetsDir}/{proxy}`,
        HASHED_ASSET_CACHE,
        { proxy: true },
      ),
    ];
  }

  /**
   * Delivers the bucket's S3 server access logs to a CloudWatch log group using
   * CloudWatch Logs vended log delivery.
   */
  private deliverAccessLogsToCloudWatch(bucket: IBucket, logGroup: LogGroup) {
    const source: CfnDeliverySource = new CfnDeliverySource(
      this,
      'WebsiteAccessLogsSource',
      {
        name: Lazy.string({
          produce: () => Names.uniqueResourceName(source, { maxLength: 60 }),
        }),
        logType: 'S3_SERVER_ACCESS_LOGS',
        resourceArn: bucket.bucketArn,
      },
    );
    const bucketPolicy = (bucket as Bucket).policy;
    if (bucketPolicy) {
      source.node.addDependency(bucketPolicy);
    }
    const destination: CfnDeliveryDestination = new CfnDeliveryDestination(
      this,
      'WebsiteAccessLogsDestination',
      {
        name: Lazy.string({
          produce: () => Names.uniqueResourceName(destination, { maxLength: 60 }),
        }),
        destinationResourceArn: logGroup.logGroupArn,
      },
    );
    const delivery = new CfnDelivery(this, 'WebsiteAccessLogsDelivery', {
      deliverySourceName: source.name,
      deliveryDestinationArn: destination.attrArn,
    });
    delivery.addDependency(source);
  }
}

interface MappedDomain {
  readonly domainName: string;
  /** The domain's name where the stack names it, else the mapping's path, to sort by */
  readonly sortKey: string;
  /** The path the API is reached at on the domain, such as `/` or `/app/` */
  readonly basePath: string;
  /** A private custom domain, reached only through a VPC endpoint */
  readonly private: boolean;
}

const asBasePath = (basePath?: string) => {
  const trimmed = (basePath ?? '').replace(/^\/+|\/+$/g, '');
  return !trimmed || trimmed === '(none)' ? '/' : `/${trimmed}/`;
};

/** The custom domains in the API's stack that map the API, public and private */
const mappedDomains = (api: RestApi): MappedDomain[] => {
  const constructs = Stack.of(api).node.findAll();
  const privateDomains = constructs.filter(
    (c): c is CfnDomainNameV2 => c instanceof CfnDomainNameV2,
  );
  const stack = Stack.of(api);
  const publicDomains = constructs.filter(
    (c): c is CfnDomainName => c instanceof CfnDomainName,
  );
  // A mapping names its domain by reference: sort by the name the domain has
  const nameOf = (domainName: string, mapping: IConstruct) => {
    const ref = JSON.stringify(stack.resolve(domainName));
    const domain = publicDomains.find(
      (d) => JSON.stringify(stack.resolve(d.ref)) === ref,
    );
    const name = domain?.domainName ?? domainName;
    return Token.isUnresolved(name) ? mapping.node.path : name;
  };
  return constructs.flatMap((c): MappedDomain[] => {
    if (c instanceof CfnBasePathMapping && c.restApiId === api.restApiId) {
      return [
        {
          domainName: c.domainName,
          sortKey: nameOf(c.domainName, c),
          basePath: asBasePath(c.basePath),
          private: false,
        },
      ];
    }
    if (c instanceof CfnBasePathMappingV2 && c.restApiId === api.restApiId) {
      const domain = privateDomains.find(
        (d) => d.attrDomainNameArn === c.domainNameArn,
      );
      return domain?.domainName
        ? [
            {
              domainName: domain.domainName,
              sortKey: Token.isUnresolved(domain.domainName)
                ? c.node.path
                : domain.domainName,
              basePath: asBasePath(c.basePath),
              private: true,
            },
          ]
        : [];
    }
    return [];
  });
};

/** The path the API's stage is reached at on its execute-api URL */
const stageBasePath = (api: RestApi) =>
  // The stage's own name, as its Ref would depend on the methods
  asBasePath((api.deploymentStage.node.defaultChild as CfnStage).stageName);

/**
 * A request mapping template that sets `$page` to the copy of index.html for
 * the path the request reached the API at: the base path of the custom domain
 * it came in on, otherwise the stage on the execute-api URL
 */
const pageKeyTemplate = (api: RestApi) => {
  const domains = mappedDomains(api).map(
    (d) =>
      `#elseif($context.domainName == '${d.domainName}')#set($base = '${d.basePath}')`,
  );
  return [
    `#set($base = '${stageBasePath(api)}')`,
    ...(domains.length ? [`#if(false)${domains.join('')}#end`] : []),
    `#set($page = "${PAGES_DIR}$` + '{base}index.html")',
  ].join('\n');
};

/**
 * The VPC endpoint IDs a private API admits, or undefined when it is not private
 */
const privateEndpoints = (api: RestApi): string[] | undefined => {
  const config = (api.node.defaultChild as CfnRestApi).endpointConfiguration as
    | CfnRestApi.EndpointConfigurationProperty
    | undefined;
  if (Token.isUnresolved(config)) {
    return [];
  }
  if (!config?.types || !(config.types as string[]).includes('PRIVATE')) {
    return undefined;
  }
  return Token.isUnresolved(config.vpcEndpointIds)
    ? []
    : ((config.vpcEndpointIds ?? []) as string[]);
};

/**
 * An API with IAM authorization denies in its resource policy whatever it does
 * not allow, so the website's GET routes are allowed for anyone, and the API's
 * own IAM operations are left out of that, for each caller's IAM policy to allow.
 * Applied as an aspect so it covers every route, however late it is added.
 */
class AllowWebsiteRoutesAspect implements IAspect {
  private applied = false;

  constructor(
    private readonly api: RestApi,
    private readonly siteMethods: Method[],
  ) {}

  public visit(node: IConstruct): void {
    if (node !== this.api || this.applied) {
      return;
    }
    this.applied = true;
    const iamMethods = this.api.methods.filter(
      (m) =>
        !this.siteMethods.includes(m) &&
        (m.node.defaultChild as CfnMethod).authorizationType ===
          AuthorizationType.IAM,
    );
    if (iamMethods.length === 0) {
      return;
    }
    // A request is matched to the policy by its path, not by the route that
    // serves it, so the website's catch-all route cannot be named on its own.
    // Instead allow the GET requests the website answers, which are every GET
    // but the API's IAM operations: those stay with each caller's own IAM
    // policy, as grantInvokeAccess grants it.
    const reads = iamMethods.filter((m) => ['GET', 'ANY'].includes(m.httpMethod));
    const operations = reads.map((m) => {
      const path = m.resource.path;
      if (path === '/' || /^\/\{[^}]+\}/.test(path)) {
        throw new Error(
          `The API has an operation at ${m.httpMethod} ${path}, which would take paths the website is served from`,
        );
      }
      return `execute-api:/*/GET${path.replace(/\{[^}]+\}/g, '*')}`;
    });
    // A private API admits only its own VPC endpoints, so the website's routes
    // are allowed through those alone, and never more widely than the API
    const endpoints = privateEndpoints(this.api);
    if (endpoints && endpoints.length === 0) {
      Annotations.of(this.api).addError(
        `${this.api.node.path} is private but names no VPC endpoints, so the website's routes cannot be scoped to them. Pass the API's vpcEndpoints in its endpointConfiguration.`,
      );
      return;
    }
    const statements = [
      new PolicyStatement({
        effect: Effect.ALLOW,
        principals: [new AnyPrincipal()],
        actions: ['execute-api:Invoke'],
        ...(endpoints
          ? { conditions: { StringEquals: { 'aws:SourceVpce': endpoints } } }
          : {}),
        notResources: [
          ...new Set(operations),
          // Only GET: the website answers nothing else
          ...['POST', 'PUT', 'PATCH', 'DELETE', 'HEAD'].map(
            (method) => `execute-api:/*/${method}/*`,
          ),
        ],
      }),
    ];
    for (const statement of statements) {
      this.api.addToResourcePolicy(statement);
    }
    // A resource policy takes effect in a new deployment, and the deployment's
    // logical ID does not otherwise cover it
    this.api.latestDeployment?.addToLogicalId({
      websiteRoutesPolicy: statements.map((s) => s.toStatementJson()),
    });
  }
}
