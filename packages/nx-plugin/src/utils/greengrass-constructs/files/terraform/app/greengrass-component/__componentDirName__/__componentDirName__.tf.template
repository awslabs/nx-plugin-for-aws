variable "bucket_name" {
  description = "Name of the shared artifact bucket this component version's artifact is uploaded to - typically the `bucket_name` output of a `core/greengrass/artifact-bucket` module, whose own `depends_on` orders this upload after the bucket is hardened."
  type        = string
}

# Publish "<%- componentDisplayName %>" from its <%- componentDirName %>-artifact build.
# Keep these paths aligned with the host project when editing this module.
module "component_version" {
  source = "../../../core/greengrass/component-version"

  recipes_dir   = "${path.module}/../../../../../../../<%- recipesDirFromRoot %>"
  artifacts_dir = "${path.module}/../../../../../../../<%- artifactsDirFromRoot %>"
  bucket_name   = var.bucket_name
}

output "component_name" {
  value = module.component_version.component_name
}

output "component_version" {
  value = module.component_version.component_version
}

output "arn" {
  value = module.component_version.arn
}
