{
  "name": "@aws/nx-plugin",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/nx-plugin/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "generate-migrations": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/migrations.json",
        "{workspaceRoot}/dist/packages/nx-plugin/migrations.json"
      ],
      "inputs": [
        "{projectRoot}/src/migrations/**/*",
        "{projectRoot}/packageJsonUpdates.json",
        "{workspaceRoot}/scripts/generate-migrations.ts",
        "{workspaceRoot}/scripts/utils/migration-folders.ts",
        "{projectRoot}/src/utils/migration-manifest.ts"
      ],
      "cache": true,
      "dependsOn": ["compile"],
      "options": {
        "commands": [
          "tsx scripts/generate-migrations.ts",
          "tsx scripts/generate-migrations.ts --out dist/packages/nx-plugin/migrations.json"
        ],
        "parallel": false
      }
    },
    "compile": {
      "executor": "@nx/js:swc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/nx-plugin",
        "main": "packages/nx-plugin/src/index.ts",
        "tsConfig": "packages/nx-plugin/tsconfig.lib.json",
        "swcrc": "packages/nx-plugin/.swcrc",
        "stripLeadingPaths": false,
        "assets": [
          "packages/nx-plugin/*.md",
          "packages/nx-plugin/LICENSE*",
          "packages/nx-plugin/NOTICE",
          {
            "input": "./packages/nx-plugin/src",
            "glob": "**/!(*.ts)",
            "output": "./src"
          },
          {
            "input": "./packages/nx-plugin/src",
            "glob": "**/*.d.ts",
            "output": "./src"
          },
          {
            "input": "./packages/nx-plugin",
            "glob": "generators.json",
            "output": "."
          },
          {
            "input": "./packages/nx-plugin",
            "glob": "executors.json",
            "output": "."
          }
        ]
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/biome.json"],
      "options": {
        "command": "biome format {projectRoot}/src"
      },
      "configurations": {
        "fix": {
          "command": "biome format --write {projectRoot}/src"
        },
        "skip-lint": {
          "command": "true"
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/biome.json"],
      "dependsOn": ["format"],
      "options": {
        "command": "biome lint {projectRoot}/src"
      },
      "configurations": {
        "fix": {
          "command": "biome check --write {projectRoot}/src"
        },
        "skip-lint": {
          "command": "true"
        }
      }
    },
    "generate-3p-license": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm-licenses generate-disclaimer --prod -o LICENSE-THIRD-PARTY",
        "cwd": "{projectRoot}"
      }
    },
    "package": {
      "dependsOn": ["compile", "generate-migrations", "generate-3p-license"]
    },
    "build": {
      "dependsOn": [
        "compile",
        "generate-migrations",
        "lint",
        "test",
        "generate-3p-license"
      ]
    },
    "mcp-inspect": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "mcp-inspector -- tsx --watch src/mcp-server/dev-server.ts"
        ],
        "cwd": "{projectRoot}"
      }
    }
  }
}
